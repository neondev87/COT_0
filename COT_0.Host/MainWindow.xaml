<Window x:Class="COT_0.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COT_0" Height="720" Width="560" MinHeight="600" MinWidth="460"
        Style="{StaticResource NeonWindow}" WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" Style="{StaticResource FadeIn}">
            <TextBlock Text="COT_0" Style="{StaticResource GlowTitle}"/>
            <TextBlock Text="// abrí el portal y que entren escaneando" Style="{StaticResource Subtitle}" Margin="0,4,0,24"/>

            <Button x:Name="GenerateButton" Content="GENERAR QR" Style="{StaticResource NeonButton}"
                    FontSize="18" Padding="36,14" HorizontalAlignment="Center" Click="OnGenerateClick"/>

            <TextBlock x:Name="StatusText" Style="{StaticResource Subtitle}" Margin="0,16,0,0"/>

            <Border x:Name="ResultPanel" Style="{StaticResource NeonPanel}" Margin="0,20,0,0"
                    Visibility="Collapsed" HorizontalAlignment="Center">
                <StackPanel>
                    <Border Background="White" Padding="8" HorizontalAlignment="Center">
                        <Image x:Name="QrImage" Width="280" Height="280" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <TextBlock Text="URL PÚBLICA" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlBox" IsReadOnly="True" FontSize="12" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="COPIAR" Style="{StaticResource NeonButton}"
                                FontSize="12" Padding="14,6" Margin="8,0,0,0" Click="OnCopyClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
