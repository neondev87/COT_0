<?xml version="1.0" encoding="utf-8"?>
<!-- Única ventana de la app: la capa del fondo y, encima, un Frame que muestra una página a la vez -->
<Window x:Class="COT_0.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:componentes="using:COT_0.Host.Views.Componentes"
        Title="COT_0">
    <Grid>
        <componentes:CapaFondo/>
        <Frame x:Name="RootFrame"/>
        <!-- Pantalla completa no tiene botones de Windows: esta ✕ ocupa el lugar de la de antes y pasa por CloseGuard -->
        <Button Style="{StaticResource TextButton}" Width="46" Height="32" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                AutomationProperties.Name="{StaticResource Text.Window.Close}" Click="OnCloseClick">
            <FontIcon Glyph="&#xE8BB;" FontFamily="{StaticResource FontIcons}" FontSize="10"/>
        </Button>
    </Grid>
</Window>
