<controls:ChromeWindow x:Class="COT_0.Host.MainWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:COT_0.Host.Controls"
                       Title="{DynamicResource Text.App.Name}" Width="{StaticResource DesignWidth}" Height="{StaticResource DesignHeight}"
                       MinWidth="{StaticResource DesignWidth}" MinHeight="{StaticResource DesignHeight}" WindowStartupLocation="CenterScreen">
    <controls:ChromeWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Picker.CloseCommand}"/>
    </controls:ChromeWindow.InputBindings>

    <Grid>
        <!-- Fondo compartido; se desenfoca al abrir el selector -->
        <controls:BackgroundLayer DataContext="{Binding Picker}">
            <controls:BackgroundLayer.Effect>
                <BlurEffect Radius="0"/>
            </controls:BackgroundLayer.Effect>
            <controls:BackgroundLayer.Style>
                <Style TargetType="controls:BackgroundLayer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                                                         To="{StaticResource BackgroundBlurRadius}" Duration="{StaticResource PickerFadeDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                                                         To="0" Duration="{StaticResource PickerFadeDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:BackgroundLayer.Style>
        </controls:BackgroundLayer>

        <!-- Pantalla actual; se desvanece mientras se elige fondo -->
        <ContentControl Content="{Binding Current}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Picker.IsOpen}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource UiFadeDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource UiFadeDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <controls:BackgroundPicker DataContext="{Binding Picker}" Panel.ZIndex="4"/>
        <controls:CaptionBar Title="{DynamicResource Text.App.Name}"/>
    </Grid>
</controls:ChromeWindow>
