<?xml version="1.0" encoding="utf-8"?>
<!-- TIENDA DE EMOTES (05): encabezado con regreso y UN panel oscuro semitransparente (el video de fondo se intuye detrás)
     con las pestañas TIENDA | TICKETS (modo ADMIN: PUNTO DE VENTA | ADMINISTRADORES). Encima, con velo, EMOTES Y REPORTES
     o el panel COMPRA REALIZADA (antes, el sello de compra).
     Transparente: el fondo lo pinta CapaFondo detrás del Frame. ESC cierra el recuadro o regresa -->
<Page x:Class="COT_0.Host.Views.Pantallas.EmotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="using:COT_0.Host.Views.Componentes"
      xmlns:tienda="using:COT_0.Host.Views.Componentes.Tienda"
      Background="Transparent"
      KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid Margin="{StaticResource ScreenMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <componentes:EncabezadoPantalla Title="{StaticResource Text.Store.ScreenTitle}" HandlesEscape="False"/>

            <Border Grid.Row="1" Style="{StaticResource ShopPanel}" Margin="0,24,0,0" MaxWidth="{StaticResource ShopPanelMaxWidth}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pestañas a la izquierda; a la derecha EMOTES Y REPORTES (en recuadro) -->
                    <Grid BorderBrush="{StaticResource RowBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="28">
                            <RadioButton Style="{StaticResource ShopTab}" GroupName="StoreTabs" Content="{StaticResource Text.Store.Tab.Shop}"
                                         IsChecked="{x:Bind ViewModel.IsShopSection, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsHostMode}"/>
                            <RadioButton Style="{StaticResource ShopTab}" GroupName="StoreTabs" Content="{StaticResource Text.Store.Tab.Tickets}"
                                         IsChecked="{x:Bind ViewModel.IsTicketsSection, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsHostMode}"/>
                            <RadioButton Style="{StaticResource ShopTab}" GroupName="StoreTabs" Content="{StaticResource Text.Store.Tab.Sales}"
                                         IsChecked="{x:Bind ViewModel.IsSalesSection, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsAdminMode}"/>
                            <RadioButton Style="{StaticResource ShopTab}" GroupName="StoreTabs" Content="{StaticResource Text.Store.Tab.Admins}"
                                         IsChecked="{x:Bind ViewModel.IsAdminsSection, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsAdminMode}"/>
                        </StackPanel>
                        <Button Style="{StaticResource TextButton}" HorizontalAlignment="Right" Content="{StaticResource Text.Store.SetPanel}"
                                Command="{x:Bind ViewModel.OpenSetPanelCommand}"/>
                    </Grid>

                    <tienda:SeccionTienda Grid.Row="1" ViewModel="{x:Bind ViewModel.Shop}"
                                          Visibility="{x:Bind ViewModel.IsShopSection, Mode=OneWay}"/>
                    <tienda:SeccionTickets Grid.Row="1" ViewModel="{x:Bind ViewModel.Tickets}"
                                           Visibility="{x:Bind ViewModel.IsTicketsSection, Mode=OneWay}"/>
                    <tienda:SeccionVentas Grid.Row="1" ViewModel="{x:Bind ViewModel.Sales}"
                                          Visibility="{x:Bind ViewModel.IsSalesSection, Mode=OneWay}"/>
                    <tienda:SeccionAdministradores Grid.Row="1" ViewModel="{x:Bind ViewModel.Admins}"
                                                   Visibility="{x:Bind ViewModel.IsAdminsSection, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Velo negro semitransparente (sin desenfoque) y el recuadro encima; clic en el velo o ESC cierran -->
        <Grid Visibility="{x:Bind ViewModel.IsOverlayOpen, Mode=OneWay}">
            <Rectangle Fill="{StaticResource DialogVeilBrush}" Tapped="OnVeilTapped"/>
            <Border Style="{StaticResource ShopDialog}" Margin="48" MaxWidth="{StaticResource ShopDialogMaxWidth}"
                    MaxHeight="{StaticResource ShopDialogMaxHeight}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16"/>
                    </TransitionCollection>
                </Border.Transitions>
                <Grid>
                    <Grid RowSpacing="16" Visibility="{x:Bind ViewModel.IsSetPanelOpen, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <componentes:PanelEmotes/>
                        <Button Grid.Row="1" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                                Content="{StaticResource Text.Store.Close}" Command="{x:Bind ViewModel.CloseOverlayCommand}"/>
                    </Grid>
                    <tienda:PanelCompra ViewModel="{x:Bind ViewModel.Shop.Summary}"
                                        Visibility="{x:Bind ViewModel.Shop.Summary.IsOpen, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Sello COMPRA REALIZADA (antes del panel, sin velo) -->
        <tienda:SelloCompra Visibility="{x:Bind ViewModel.Shop.Summary.IsSealVisible, Mode=OneWay}"/>
    </Grid>
</Page>
