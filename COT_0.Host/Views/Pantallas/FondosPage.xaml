<?xml version="1.0" encoding="utf-8"?>
<!-- Fondos: miniaturas de imágenes y videos de la carpeta de fondos sobre el fondo vivo con velo oscuro.
     Arriba: errores (InfoBar), cuadro fijo para el video elegido, SIN FONDO y RECARGAR -->
<Page x:Class="COT_0.Host.Views.Pantallas.FondosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="using:COT_0.Host.Views.Componentes"
      xmlns:vm="using:COT_0.Host.Views.ModelosDeVista"
      Background="Transparent">

    <Grid Margin="64,52,64,40" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <componentes:EncabezadoPantalla Title="{StaticResource Text.Backgrounds.Title}"/>

        <InfoBar Grid.Row="1" Severity="Warning" Title="{StaticResource Text.Backgrounds.ErrorTitle}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"/>

        <!-- Aviso en su columna (se recorta antes de tapar los controles) y controles a la derecha -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{StaticResource Text.Backgrounds.Hint}" Style="{StaticResource InterText}" VerticalAlignment="Center"
                       TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <CheckBox Content="{StaticResource Text.Backgrounds.UseStill}" Foreground="{StaticResource Text70Brush}"
                          IsChecked="{x:Bind ViewModel.SelectedUsesStill, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanUseStill, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ToggleStillCommand}"/>
                <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Backgrounds.None}" Command="{x:Bind ViewModel.ClearCommand}"/>
                <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Backgrounds.Reload}" Command="{x:Bind ViewModel.ReloadCommand}"/>
            </StackPanel>
        </Grid>

        <GridView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:FondoRowViewModel">
                    <StackPanel Width="256" Margin="4,4,4,12">
                        <Grid Width="256" Height="144" Background="{StaticResource PanelBrush}">
                            <FontIcon Glyph="&#xE91B;" FontFamily="{StaticResource FontIcons}" FontSize="32" Foreground="{StaticResource Light28Brush}"/>
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                            <!-- Elegido: borde de acento -->
                            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                            <Border Margin="8" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource AccentBrush}"
                                    Visibility="{x:Bind IsHeavy}">
                                <TextBlock Text="{StaticResource Text.Backgrounds.Heavy}" FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold"
                                           FontSize="11" CharacterSpacing="200" Foreground="{StaticResource WhiteBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Name}" Margin="0,8,0,0" Style="{StaticResource RowNameText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Detail}" Margin="0,2,0,0" Style="{StaticResource InterText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <ProgressRing Grid.Row="3" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"
                      VerticalAlignment="Top" Margin="0,40,0,0"/>
    </Grid>
</Page>
