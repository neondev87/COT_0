<?xml version="1.0" encoding="utf-8"?>
<!-- Manual de Lain: a la izquierda sus notificaciones y su video en la tele; a la derecha los atajos, el paso actual
     y su vista de ejemplo con resaltados (o la captura opcional del paso). Al final, la despedida con el mismo video al centro.
     ← INICIO regresa al dashboard -->
<Page x:Class="COT_0.Host.Views.Pantallas.ManualPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="using:COT_0.Host.Views.Componentes"
      xmlns:vm="using:COT_0.Host.Views.ModelosDeVista"
      Background="{StaticResource WindowBackgroundBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Manual.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Barrido tenue de arriba abajo: solo traslación, corre en el compositor -->
            <Storyboard x:Name="SweepStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Y" From="-140" To="760" Duration="0:0:14"/>
            </Storyboard>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnStartKey"/>
        <KeyboardAccelerator Key="Right" Invoked="OnNextKey"/>
        <KeyboardAccelerator Key="Left" Invoked="OnPreviousKey"/>
        <KeyboardAccelerator Key="Escape" Invoked="OnExitKey"/>
    </Page.KeyboardAccelerators>

    <Grid Background="{StaticResource ManualBaseBrush}">
        <!-- Despedida: sin DataTrigger, un StateTrigger mueve el video al centro y cambia los paneles -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Steps"/>
                <VisualState x:Name="Farewell">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsFarewell, Mode=OneWay}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VideoHost.HorizontalAlignment" Value="Center"/>
                        <Setter Target="VideoHost.VerticalAlignment" Value="Top"/>
                        <Setter Target="VideoHost.Margin" Value="0,60,0,0"/>
                        <Setter Target="VideoHost.Width" Value="720"/>
                        <Setter Target="VideoHost.Height" Value="440"/>
                        <Setter Target="VideoHost.Opacity" Value="{StaticResource FarewellVideoOpacity}"/>
                        <Setter Target="LainFade.Visibility" Value="Collapsed"/>
                        <Setter Target="NoticesHost.Visibility" Value="Collapsed"/>
                        <Setter Target="StepsRoot.Opacity" Value="0"/>
                        <Setter Target="StepsRoot.IsHitTestVisible" Value="False"/>
                        <Setter Target="FarewellPanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Rectangle Height="120" VerticalAlignment="Top" Fill="{StaticResource ManualSweepBrush}" IsHitTestVisible="False">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Sweep" Y="-140"/>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Fill="{StaticResource VignetteBrush}" IsHitTestVisible="False"/>

        <!-- Video de Lain sin LumaKey: opacidad fija sobre el azul del fondo y el borde de arriba fundido -->
        <Grid x:Name="VideoHost" Width="{StaticResource ManualColumnWidth}" Height="460" Margin="32,0,0,20"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="{StaticResource LainVideoOpacity}" IsHitTestVisible="False">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3"/>
            </Grid.OpacityTransition>
            <MediaPlayerElement x:Name="LainVideo" Stretch="Uniform" AreTransportControlsEnabled="False" VerticalAlignment="Bottom"/>
            <Rectangle x:Name="LainFade" Height="80" VerticalAlignment="Top" Fill="{StaticResource LainFadeBrush}"/>
        </Grid>

        <componentes:EncabezadoPantalla Margin="32,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Title="{StaticResource Text.Manual.ScreenTitle}" HandlesEscape="False"/>

        <!-- Notificaciones de Lain, encimadas: cada una aparece y se va con una transición de opacidad -->
        <ItemsControl x:Name="NoticesHost" Width="{StaticResource ManualColumnWidth}" Margin="32,84,0,0" HorizontalAlignment="Left"
                      VerticalAlignment="Top" IsTabStop="False" IsHitTestVisible="False" ItemsSource="{x:Bind ViewModel.Current.Notices, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ManualNoticeViewModel">
                    <componentes:AvisoLain Notice="{x:Bind}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pasos -->
        <Grid x:Name="StepsRoot" Margin="402,24,32,28">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3"/>
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Atajos de teclado (también se pueden tocar) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <componentes:BotonManual Style="{StaticResource ManualKeycap}" Margin="0" KeyText="{StaticResource Text.Manual.KeyStart}"
                                         Content="{StaticResource Text.Manual.Start}" Command="{x:Bind ViewModel.StartCommand}"/>
                <componentes:BotonManual Style="{StaticResource ManualKeycap}" KeyText="{StaticResource Text.Manual.KeyNext}"
                                         Content="{StaticResource Text.Manual.Next}" Command="{x:Bind ViewModel.NextCommand}"/>
                <componentes:BotonManual Style="{StaticResource ManualKeycap}" KeyText="{StaticResource Text.Manual.KeyPrevious}"
                                         Content="{StaticResource Text.Manual.Previous}" Command="{x:Bind ViewModel.PreviousCommand}"/>
                <componentes:BotonManual Style="{StaticResource ManualKeycap}" KeyText="{StaticResource Text.Manual.KeyExit}"
                                         Content="{StaticResource Text.Manual.Exit}" Command="{x:Bind ViewModel.ExitCommand}"/>
            </StackPanel>

            <!-- Paso actual: se apaga un momento al cambiar (fundido de 0.25 s) y entra con su vista de ejemplo -->
            <Grid Grid.Row="1" Margin="0,12,0,0" Opacity="{x:Bind ViewModel.StepOpacity, Mode=OneWay}">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.25"/>
                </Grid.OpacityTransition>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Current.Label, Mode=OneWay}" Style="{StaticResource ManualStepNumberText}"/>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Current.Title, Mode=OneWay}" Style="{StaticResource ManualStepTitleText}"
                           Visibility="{x:Bind ViewModel.Current.HasTitle, Mode=OneWay}"/>
                <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Current.Text, Mode=OneWay}" Style="{StaticResource ManualStepText}"/>

                <!-- Vista de ejemplo del paso con sus resaltados; si hay captura (manual\pasos\pasoN.png), la captura -->
                <Border Grid.Row="3" Margin="0,14,0,0" MinHeight="180" CornerRadius="10" Padding="1"
                        Background="{StaticResource ManualPanelBrush}" BorderBrush="{StaticResource ManualBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{x:Bind ViewModel.Current.Stage, Mode=OneWay}" Stretch="Uniform"
                               Visibility="{x:Bind ViewModel.Current.HasStage, Mode=OneWay}"/>
                        <componentes:VistaEjemploManual Step="{x:Bind ViewModel.Current.Number, Mode=OneWay}"
                                                        Phase="{x:Bind ViewModel.Phase, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.Current.HasNoStage, Mode=OneWay}"/>
                    </Grid>
                </Border>
            </Grid>

            <componentes:BotonManual Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource ManualButton}"
                                     Content="{StaticResource Text.Manual.Skip}" Command="{x:Bind ViewModel.FarewellCommand}"/>
        </Grid>

        <!-- Despedida -->
        <StackPanel x:Name="FarewellPanel" Margin="0,0,0,64" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed">
            <TextBlock Text="{StaticResource Text.Manual.Farewell}" Style="{StaticResource ManualStepTitleText}"/>
            <componentes:BotonManual Margin="0,22,0,0" Style="{StaticResource ManualSmallButton}" Content="{StaticResource Text.Manual.Close}"
                                     Command="{x:Bind ViewModel.CloseCommand}"/>
        </StackPanel>

        <InfoBar MaxWidth="560" Margin="0,0,88,24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Severity="Warning"
                 Title="{StaticResource Text.Manual.ErrorTitle}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"/>

        <Button Margin="0,0,32,28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource TextButton}"
                Command="{x:Bind ViewModel.ToggleMuteCommand}" ToolTipService.ToolTip="{StaticResource Text.Manual.Mute}"
                AutomationProperties.Name="{StaticResource Text.Manual.Mute}">
            <FontIcon Glyph="{x:Bind componentes:MusicGlyphs.Speaker(ViewModel.IsMuted), Mode=OneWay}" FontFamily="{StaticResource FontIcons}" FontSize="18"/>
        </Button>

        <!-- Destello al cambiar de paso: reemplaza la estática por píxeles y el temblor de la señal -->
        <Rectangle Fill="{StaticResource SignalFlashBrush}" Opacity="{x:Bind ViewModel.FlashOpacity, Mode=OneWay}" IsHitTestVisible="False">
            <Rectangle.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15"/>
            </Rectangle.OpacityTransition>
        </Rectangle>
    </Grid>
</Page>
