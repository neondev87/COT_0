<?xml version="1.0" encoding="utf-8"?>
<!-- Manual de Lain: a la izquierda sus notificaciones y su video en la tele, parado en el borde de abajo; a la derecha los atajos,
     el número y título del paso y su vista de ejemplo con resaltados (o la captura opcional del paso). Al final, la despedida
     con el video y su texto debajo, centrados en toda la pantalla. Capas: fondo elegido (CapaFondo; si es video sigue en bucle y mudo, tapado), el fondo de color opaco (ManualBackdropBrush) y el contenido. ← INICIO regresa al dashboard -->
<Page x:Class="COT_0.Host.Views.Pantallas.ManualPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="using:COT_0.Host.Views.Componentes"
    xmlns:manual="using:COT_0.Host.Views.Componentes.Manual"
    xmlns:convertidores="using:COT_0.Host.Views.Convertidores"
      xmlns:vm="using:COT_0.Host.Views.ModelosDeVista"
      Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="False" KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Manual.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Atajos sin letrero flotante ("Enter", "Esc"…): KeyboardAcceleratorPlacementMode="Hidden" en la página -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnStartKey"/>
        <KeyboardAccelerator Key="Right" Invoked="OnNextKey"/>
        <KeyboardAccelerator Key="Left" Invoked="OnPreviousKey"/>
        <KeyboardAccelerator Key="Escape" Invoked="OnExitKey"/>
    </Page.KeyboardAccelerators>

    <Grid Background="{StaticResource ManualBackdropBrush}">
        <!-- Despedida: sin DataTrigger, un StateTrigger centra el grupo del video y su texto y cambia los paneles -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Steps"/>
                <VisualState x:Name="Farewell">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsFarewell, Mode=OneWay}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LainCutoutHost.Visibility" Value="Collapsed"/>
                        <Setter Target="VideoLayer.HorizontalAlignment" Value="Center"/>
                        <Setter Target="VideoLayer.VerticalAlignment" Value="Center"/>
                        <Setter Target="VideoHost.Visibility" Value="Visible"/>
                        <Setter Target="VideoHost.Opacity" Value="{StaticResource FarewellVideoOpacity}"/>
                        <Setter Target="VideoCell.Width" Value="{StaticResource FarewellVideoWidth}"/>
                        <Setter Target="VideoCell.Height" Value="{StaticResource FarewellVideoHeight}"/>
                        <Setter Target="EdgeTop.Height" Value="{StaticResource FarewellBlendEnds}"/>
                        <Setter Target="EdgeBottom.Height" Value="{StaticResource FarewellBlendEnds}"/>
                        <Setter Target="EdgeLeft.Width" Value="{StaticResource FarewellBlendSide}"/>
                        <Setter Target="EdgeRight.Width" Value="{StaticResource FarewellBlendSide}"/>
                        <Setter Target="FarewellFades.Visibility" Value="Visible"/>
                        <Setter Target="NoticesHost.Visibility" Value="Collapsed"/>
                        <Setter Target="StepsRoot.Opacity" Value="0"/>
                        <Setter Target="StepsRoot.IsHitTestVisible" Value="False"/>
                        <Setter Target="FarewellPanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Opción A: Lain con transparencia real (GIF preparado una vez con ffmpeg, docs/PREPARAR_LAIN.md), pegada al borde de abajo.
             Sus orillas de arriba y de los lados se llevan al negro del fondo, así el cuadro que le quede al GIF no se nota -->
        <Grid x:Name="LainCutoutHost" Margin="{StaticResource LainMargin}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              IsHitTestVisible="False" Visibility="{x:Bind ViewModel.HasLainCutout, Mode=OneWay}">
            <Image Source="{x:Bind ViewModel.LainCutout, Mode=OneWay}" Height="{StaticResource LainVideoHeight}" Stretch="Uniform"/>
            <Rectangle Height="{StaticResource LainCutoutFade}" VerticalAlignment="Top" Fill="{StaticResource EdgeTopBrush}"/>
            <Rectangle Width="{StaticResource LainCutoutFade}" HorizontalAlignment="Left" Fill="{StaticResource EdgeLeftBrush}"/>
            <Rectangle Width="{StaticResource LainCutoutFade}" HorizontalAlignment="Right" Fill="{StaticResource EdgeRightBrush}"/>
        </Grid>

        <!-- Video sin canal alfa: Lain cuando no hay GIF (opción B), abajo a la izquierda, y la despedida con su texto debajo.
             El Viewbox solo reduce (DownOnly): en pantallas chicas el grupo se encoge completo en lugar de cortarse -->
        <Viewbox x:Name="VideoLayer" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel>
                <!-- Alrededor del video, franjas del negro del video que se desvanecen hacia afuera (esquinas radiales);
                     toda la caja comparte una sola opacidad, así que no queda borde -->
                <Grid x:Name="VideoHost" HorizontalAlignment="Center" IsHitTestVisible="False"
                      Visibility="{x:Bind ViewModel.HasNoLainCutout, Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3"/>
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Rectangle Fill="{StaticResource EdgeCornerTopLeftBrush}"/>
                    <Rectangle x:Name="EdgeTop" Grid.Column="1" Height="{StaticResource LainBlendTop}" Fill="{StaticResource EdgeBottomBrush}"/>
                    <Rectangle Grid.Column="2" Fill="{StaticResource EdgeCornerTopRightBrush}"/>
                    <Rectangle x:Name="EdgeLeft" Grid.Row="1" Width="{StaticResource LainBlendLeft}" Fill="{StaticResource EdgeRightBrush}"/>
                    <Rectangle x:Name="EdgeRight" Grid.Row="1" Grid.Column="2" Width="{StaticResource LainBlendRight}" Fill="{StaticResource EdgeLeftBrush}"/>
                    <Rectangle Grid.Row="2" Fill="{StaticResource EdgeCornerBottomLeftBrush}"/>
                    <Rectangle x:Name="EdgeBottom" Grid.Row="2" Grid.Column="1" Height="0" Fill="{StaticResource EdgeTopBrush}"/>
                    <Rectangle Grid.Row="2" Grid.Column="2" Fill="{StaticResource EdgeCornerBottomRightBrush}"/>
                    <Grid x:Name="VideoCell" Grid.Row="1" Grid.Column="1" Width="{StaticResource LainVideoWidth}" Height="{StaticResource LainVideoHeight}">
                        <MediaPlayerElement x:Name="LainVideo" Stretch="Uniform" AreTransportControlsEnabled="False"/>
                        <!-- Solo en la despedida: su fondo es azul (#06122C), así que sus cuatro orillas se llevan al negro de las franjas -->
                        <Grid x:Name="FarewellFades" Visibility="Collapsed">
                            <Rectangle Height="{StaticResource FarewellFadeEnds}" VerticalAlignment="Top" Fill="{StaticResource EdgeTopBrush}"/>
                            <Rectangle Height="{StaticResource FarewellFadeEnds}" VerticalAlignment="Bottom" Fill="{StaticResource EdgeBottomBrush}"/>
                            <Rectangle Width="{StaticResource FarewellFadeSide}" HorizontalAlignment="Left" Fill="{StaticResource EdgeLeftBrush}"/>
                            <Rectangle Width="{StaticResource FarewellFadeSide}" HorizontalAlignment="Right" Fill="{StaticResource EdgeRightBrush}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Despedida: panel de vidrio debajo del video, sin encimarse -->
                <Border x:Name="FarewellPanel" Style="{StaticResource ManualGlassPanel}" Padding="{StaticResource FarewellPanelPadding}"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Text.Manual.Farewell}" Style="{StaticResource ManualFarewellText}"/>
                        <manual:BotonManual Margin="0,20,0,0" Style="{StaticResource ManualSmallButton}" Content="{StaticResource Text.Manual.Close}"
                                                 Command="{x:Bind ViewModel.CloseCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Viewbox>

        <componentes:EncabezadoPantalla Margin="32,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Title="{StaticResource Text.Manual.ScreenTitle}" HandlesEscape="False"/>

        <!-- Notificaciones de Lain, encimadas: cada una aparece y se va con una transición de opacidad -->
        <ItemsControl x:Name="NoticesHost" Width="{StaticResource ManualColumnWidth}" Margin="32,84,0,0" HorizontalAlignment="Left"
                      VerticalAlignment="Top" IsTabStop="False" IsHitTestVisible="False" ItemsSource="{x:Bind ViewModel.Current.Notices, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ManualNoticeViewModel">
                    <manual:AvisoLain Notice="{x:Bind}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pasos: a la derecha de la columna de Lain (32 + ManualColumnWidth 330 + 24 de separación); la vista de ejemplo usa el resto -->
        <Grid x:Name="StepsRoot" Margin="386,24,32,28">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3"/>
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Atajos de teclado (también se pueden tocar), en un panel de vidrio -->
            <Border Style="{StaticResource ManualGlassPanel}" Padding="14,6" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <manual:BotonManual Style="{StaticResource ManualKeycap}" Margin="0" KeyText="{StaticResource Text.Manual.KeyStart}"
                                             Content="{StaticResource Text.Manual.Start}" Command="{x:Bind ViewModel.StartCommand}"/>
                    <manual:BotonManual Style="{StaticResource ManualKeycap}" KeyText="{StaticResource Text.Manual.KeyNext}"
                                             Content="{StaticResource Text.Manual.Next}" Command="{x:Bind ViewModel.NextCommand}"/>
                    <manual:BotonManual Style="{StaticResource ManualKeycap}" KeyText="{StaticResource Text.Manual.KeyPrevious}"
                                             Content="{StaticResource Text.Manual.Previous}" Command="{x:Bind ViewModel.PreviousCommand}"/>
                    <manual:BotonManual Style="{StaticResource ManualKeycap}" KeyText="{StaticResource Text.Manual.KeyExit}"
                                             Content="{StaticResource Text.Manual.Exit}" Command="{x:Bind ViewModel.ExitCommand}"/>
                </StackPanel>
            </Border>

            <!-- Paso actual: se apaga un momento al cambiar (fundido de 0.25 s) y entra con su vista de ejemplo -->
            <Grid Grid.Row="1" Margin="0,12,0,0" Opacity="{x:Bind ViewModel.StepOpacity, Mode=OneWay}">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.25"/>
                </Grid.OpacityTransition>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Indicador del paso entre dos líneas rojas -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Rectangle Width="28" Height="1" VerticalAlignment="Center" Fill="{StaticResource AccentFadeInBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.Current.Label, Mode=OneWay}" Style="{StaticResource ManualStepNumberText}"/>
                    <Rectangle Width="28" Height="1" VerticalAlignment="Center" Fill="{StaticResource AccentFadeOutBrush}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Current.Title, Mode=OneWay}" Style="{StaticResource ManualStepTitleText}"
                           Visibility="{x:Bind ViewModel.Current.HasTitle, Mode=OneWay}"/>

                <!-- Vista de ejemplo del paso con sus resaltados; si hay captura (manual\pasos\pasoN.png), la captura.
                     El marco se ajusta a la réplica 16:9 escalada (Viewbox Uniform) y queda centrado en el espacio libre -->
                <Border Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="{StaticResource ManualGlassRadius}"
                        Padding="1" Background="{StaticResource ManualStageBrush}" BorderBrush="{StaticResource ManualFrameBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{x:Bind ViewModel.Current.Stage, Mode=OneWay}" Stretch="Uniform"
                               Visibility="{x:Bind ViewModel.Current.HasStage, Mode=OneWay}"/>
                        <manual:VistaEjemploManual Step="{x:Bind ViewModel.Current.Number, Mode=OneWay}"
                                                        Phase="{x:Bind ViewModel.Phase, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.Current.HasNoStage, Mode=OneWay}"/>
                    </Grid>
                </Border>
            </Grid>

            <manual:BotonManual Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource ManualButton}"
                                     Content="{StaticResource Text.Manual.Skip}" Command="{x:Bind ViewModel.FarewellCommand}"/>
        </Grid>

        <InfoBar MaxWidth="560" Margin="0,0,88,24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Severity="Warning"
                 Title="{StaticResource Text.Manual.ErrorTitle}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"/>

        <Button Margin="0,0,32,28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource TextButton}"
                Command="{x:Bind ViewModel.ToggleMuteCommand}" ToolTipService.ToolTip="{StaticResource Text.Manual.Mute}"
                AutomationProperties.Name="{StaticResource Text.Manual.Mute}">
            <FontIcon Glyph="{x:Bind convertidores:MusicGlyphs.Speaker(ViewModel.IsMuted), Mode=OneWay}" FontFamily="{StaticResource FontIcons}" FontSize="18"/>
        </Button>

        <!-- Destello al cambiar de paso: reemplaza la estática por píxeles y el temblor de la señal -->
        <Rectangle Fill="{StaticResource SignalFlashBrush}" Opacity="{x:Bind ViewModel.FlashOpacity, Mode=OneWay}" IsHitTestVisible="False">
            <Rectangle.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15"/>
            </Rectangle.OpacityTransition>
        </Rectangle>
    </Grid>
</Page>
