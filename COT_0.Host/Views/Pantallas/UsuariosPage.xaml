<?xml version="1.0" encoding="utf-8"?>
<!-- USUARIOS (04): encabezado con regreso y UN panel oscuro semitransparente (el video de fondo sigue detrás) con las tarjetas:
     foto o inicial con color, nombre y acciones (dueño: FOTO, NOMBRE, CONTRASEÑA; ADMIN: VER FACTURA, VER SUS EMOTES, ELIMINAR USUARIO). Clic en la tarjeta: su stock.
     Encima, con velo, el stock, la factura (tickets y PDF) o el recuadro para cambiar nombre o contraseña. ESC cierra el recuadro o regresa -->
<Page x:Class="COT_0.Host.Views.Pantallas.UsuariosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="using:COT_0.Host.Views.Componentes"
      xmlns:tienda="using:COT_0.Host.Views.Componentes.Tienda"
      xmlns:usuarios="using:COT_0.Host.Views.Componentes.Usuarios"
      xmlns:convertidores="using:COT_0.Host.Views.Convertidores"
      xmlns:vm="using:COT_0.Host.Views.ModelosDeVista"
      Background="Transparent"
      KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid Margin="{StaticResource ScreenMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <componentes:EncabezadoPantalla Title="{StaticResource Text.Users.ScreenTitle}" HandlesEscape="False"/>

            <Border Grid.Row="1" Style="{StaticResource ShopPanel}" Margin="0,24,0,0" MaxWidth="{StaticResource ShopPanelMaxWidth}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{StaticResource Text.Store.Users.Title}" Style="{StaticResource ShopTitleText}"/>
                        <TextBlock Text="{x:Bind ViewModel.Hint}" Style="{StaticResource InterText}" TextWrapping="WrapWholeWords"/>
                    </StackPanel>

                    <InfoBar Grid.Row="1" Title="{StaticResource Text.Users.NoticeTitle}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
                             Severity="{x:Bind ViewModel.Notice.Severity, Mode=OneWay}" IsOpen="{x:Bind ViewModel.Notice.IsOpen, Mode=TwoWay}"/>

                    <GridView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Users}" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnUserClick" ItemContainerStyle="{StaticResource ShopGridItem}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserCardViewModel">
                                <Border Style="{StaticResource ShopCard}" Width="{StaticResource UserCardWidth}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Grid Width="{StaticResource UserPhotoSize}" Height="{StaticResource UserPhotoSize}">
                                                <Border CornerRadius="6" Background="{x:Bind convertidores:AvatarTones.For(Tone)}"
                                                        BorderBrush="{StaticResource ShopPanelBorderBrush}" BorderThickness="1"
                                                        Visibility="{x:Bind HasInitial, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Initial}" Style="{StaticResource InitialsText}" FontSize="22"/>
                                                </Border>
                                                <Border CornerRadius="6" BorderBrush="{StaticResource ShopPanelBorderBrush}" BorderThickness="1"
                                                        Visibility="{x:Bind HasPhoto, Mode=OneWay}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{x:Bind Photo, Mode=OneWay}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowNameText}" FontSize="16" VerticalAlignment="Center"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="8" RowSpacing="8" Visibility="{x:Bind CanManage}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Style="{StaticResource ShopActionButton}" Content="{StaticResource Text.Users.Photo}" Click="OnPhotoClick"/>
                                            <Button Grid.Column="1" Style="{StaticResource ShopActionButton}" Content="{StaticResource Text.Users.Rename}" Click="OnRenameClick"/>
                                            <Button Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ShopActionButton}"
                                                    Content="{StaticResource Text.Users.Password}" Click="OnPasswordClick"/>
                                        </Grid>
                                        <!-- Solo ADMIN: las tres acciones del punto de venta sobre este usuario -->
                                        <StackPanel Spacing="8" Visibility="{x:Bind CanDelete}">
                                            <Button Style="{StaticResource ShopActionButton}" HorizontalAlignment="Stretch"
                                                    Content="{StaticResource Text.Users.Invoices}" Click="OnInvoicesClick"/>
                                            <Button Style="{StaticResource ShopActionButton}" HorizontalAlignment="Stretch"
                                                    Content="{StaticResource Text.Users.Emotes}" Click="OnEmotesClick"/>
                                            <Button Style="{StaticResource ShopActionButton}" HorizontalAlignment="Stretch"
                                                    Content="{StaticResource Text.Users.DeleteUser}" Click="OnDeleteClick"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock Grid.Row="2" Text="{StaticResource Text.Store.Users.Empty}" Style="{StaticResource ShopEmptyText}" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Velo negro semitransparente (sin desenfoque) y el recuadro encima; clic en el velo o ESC cierran -->
        <Grid Visibility="{x:Bind ViewModel.IsOverlayOpen, Mode=OneWay}">
            <Rectangle Fill="{StaticResource DialogVeilBrush}" Tapped="OnVeilTapped"/>
            <Border Style="{StaticResource ShopDialog}" Margin="48" MaxWidth="{StaticResource ShopDialogMaxWidth}"
                    MaxHeight="{StaticResource ShopDialogMaxHeight}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16"/>
                    </TransitionCollection>
                </Border.Transitions>
                <Grid>
                    <tienda:RecuadroStock Stock="{x:Bind ViewModel.Stock, Mode=OneWay}" CloseCommand="{x:Bind ViewModel.CloseOverlayCommand}"
                                          Visibility="{x:Bind ViewModel.IsStockOpen, Mode=OneWay}"/>
                    <tienda:RecuadroFacturas Invoices="{x:Bind ViewModel.Invoices, Mode=OneWay}" CloseCommand="{x:Bind ViewModel.CloseOverlayCommand}"
                                             Visibility="{x:Bind ViewModel.IsInvoicesOpen, Mode=OneWay}"/>
                    <usuarios:RecuadroCuenta Form="{x:Bind ViewModel.Form, Mode=OneWay}" CloseCommand="{x:Bind ViewModel.CloseOverlayCommand}"
                                             Visibility="{x:Bind ViewModel.IsFormOpen, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
