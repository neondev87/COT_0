<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de la pantalla Emotes (USUARIOS | TIENDA | TICKETS). Se mezcla en EmotesPage y en sus secciones.
     Ligero: solo degradados, opacidad, bordes y transiciones cortas; sin desenfoque ni sombras -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Panel único: negro azulado al 90 % arriba y 84 % abajo, así se intuye el video de fondo -->
    <LinearGradientBrush x:Key="ShopPanelBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#E60A0D18" Offset="0"/>
        <GradientStop Color="#DD080A13" Offset="0.55"/>
        <GradientStop Color="#D6070810" Offset="1"/>
    </LinearGradientBrush>
    <!-- Borde fino con el acento que se apaga hacia abajo -->
    <LinearGradientBrush x:Key="ShopPanelBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3B3122E" Offset="0"/>
        <GradientStop Color="#40B3122E" Offset="0.5"/>
        <GradientStop Color="#80B3122E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Recuadro encima del velo (stock de un usuario, set y reportes) -->
    <LinearGradientBrush x:Key="ShopDialogBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FA0C0F1B" Offset="0"/>
        <GradientStop Color="#FA080A12" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShopCardBrush" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="ShopCardBorderBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="ShopOwnedBrush" Color="#26B3122E"/>

    <!-- Márgenes de las pantallas con panel (USUARIOS y TIENDA), iguales a 1280x720 y en pantalla completa -->
    <Thickness x:Key="ScreenMargin">64,48,64,40</Thickness>
    <x:Double x:Key="ShopPanelMaxWidth">1180</x:Double>
    <x:Double x:Key="UserCardWidth">260</x:Double>
    <x:Double x:Key="UserPhotoSize">56</x:Double>
    <x:Double x:Key="ShopDialogMaxWidth">760</x:Double>
    <x:Double x:Key="ShopDialogMaxHeight">600</x:Double>
    <x:Double x:Key="ShopThumbSize">48</x:Double>
    <x:Double x:Key="ShopSmallThumbSize">32</x:Double>
    <x:Double x:Key="ShopEmoteCardWidth">136</x:Double>
    <x:Double x:Key="ShopUserCardWidth">200</x:Double>
    <x:Double x:Key="ShopSearchWidth">320</x:Double>

    <Style x:Key="ShopPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShopPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShopPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="28,18,28,22"/>
    </Style>
    <Style x:Key="ShopDialog" TargetType="Border" BasedOn="{StaticResource ShopPanel}">
        <Setter Property="Background" Value="{StaticResource ShopDialogBrush}"/>
        <Setter Property="Padding" Value="28,24"/>
    </Style>
    <Style x:Key="ShopCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShopCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShopCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="ShopEmptyText" TargetType="TextBlock" BasedOn="{StaticResource InterText}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Light62Brush}"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ShopTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedBold}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="CharacterSpacing" Value="160"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Aviso fijo "Puedes comprar 10 emotes cada 24 horas": franja con el acento suave -->
    <SolidColorBrush x:Key="ShopSuccessBrush" Color="#3DDC84"/>
    <SolidColorBrush x:Key="ShopFlashBrush" Color="#553DDC84"/>
    <x:Double x:Key="ShopCartWidth">240</x:Double>
    <Style x:Key="ShopRulesBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="ShopRulesText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedBold}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CharacterSpacing" Value="160"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>
    <!-- Destello verde detrás del contador y "¡Comprado!" (solo opacidad) -->
    <Style x:Key="ShopFlash" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShopFlashBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShopSuccessBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="ShopDoneText" TargetType="TextBlock" BasedOn="{StaticResource ShopTitleText}">
        <Setter Property="Foreground" Value="{StaticResource ShopSuccessBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Carrito a la derecha de la cuadrícula -->
    <Style x:Key="ShopCartPanel" TargetType="Border" BasedOn="{StaticResource ShopCard}">
        <Setter Property="Width" Value="{StaticResource ShopCartWidth}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- Cuadrículas sin selección ni fondo del sistema al pasar el mouse -->
    <Style x:Key="ShopGridItem" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <!-- Precio de muestra (USD) en tarjetas, carrito y resumen -->
    <Style x:Key="ShopPriceText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <!-- Sello COMPRA REALIZADA: disco con degradado de acento y anillo; solo opacidad y escala, sin desenfoque -->
    <LinearGradientBrush x:Key="PurchaseSealBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6B3122E" Offset="0"/>
        <GradientStop Color="#E61A0A10" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PurchaseSealRingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        <GradientStop Color="#FFC82A44" Offset="1"/>
    </LinearGradientBrush>
    <x:Double x:Key="PurchaseSealSize">220</x:Double>
    <x:Double x:Key="PurchaseSummaryListMaxHeight">260</x:Double>
    <Style x:Key="PurchaseSealText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedBold}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="CharacterSpacing" Value="240"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>
</ResourceDictionary>
