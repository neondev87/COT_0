<?xml version="1.0" encoding="utf-8"?>
<!-- Pestañas USUARIOS | TIENDA | TICKETS y botón COMPRAR de la pantalla Emotes. Transiciones de 0.15 s, solo opacidad y color -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pestaña: texto condensado y una línea de acento abajo cuando está elegida -->
    <Style x:Key="ShopTab" TargetType="RadioButton">
        <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden"/>
        <Setter Property="MinHeight" Value="{StaticResource MinHitSize}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource Text55Brush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontCondensedBold}"
                                   FontWeight="Bold" FontSize="15" CharacterSpacing="260"/>
                        <Rectangle x:Name="Line" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource AccentBrush}" Opacity="0"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{StaticResource AccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Line.Opacity" Value="1"/>
                                        <Setter Target="Label.Foreground" Value="{StaticResource TextBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- COMPRAR / DESCARGAR PDF: contorno con el acento; con el mouse se llena; apagado queda tenue -->
    <Style x:Key="ShopActionButton" TargetType="Button">
        <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}" Padding="{TemplateBinding Padding}">
                        <Border x:Name="Fill" Background="{StaticResource AccentBrush}" Opacity="0" Margin="-14,0"/>
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontCondensedBold}"
                                   FontWeight="Bold" FontSize="12" CharacterSpacing="220"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Opacity" Value="1"/>
                                        <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Opacity" Value="0.7"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.35"/>
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource Light28Brush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
