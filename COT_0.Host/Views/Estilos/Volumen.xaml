<?xml version="1.0" encoding="utf-8"?>
<!-- Volumen minimalista de la firma: bocina gris que pasa a blanco y una línea de 2 px (gris tenue + tramo rojo hasta el valor)
     con un punto de 10 px que solo aparece con el mouse o el foco. Plantilla propia del Slider: sin los visuales ni el azul de WinUI.
     Solo opacidad y escala animadas (cortas). Se mezcla en Firma -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:componentes="using:COT_0.Host.Views.Componentes">

    <SolidColorBrush x:Key="VolumeTrackBrush" Color="#26E6E6E6"/>
    <SolidColorBrush x:Key="VolumeIconBrush" Color="#8CE6E6E6"/>
    <x:Double x:Key="VolumeLineHeight">2</x:Double>
    <x:Double x:Key="VolumeThumbSize">10</x:Double>
    <x:Double x:Key="VolumeHitHeight">24</x:Double>
    <x:Double x:Key="VolumeIconSize">14</x:Double>
    <!-- La fila empieza bajo "Neondev": avatar de 80 + separación de 16 del LogoNeondev -->
    <Thickness x:Key="VolumeRowMargin">96,4,0,0</Thickness>

    <!-- Punto del volumen: círculo claro, sin borde ni sombra -->
    <Style x:Key="VolumeThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{StaticResource LightBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MiniVolumeSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="StepFrequency" Value="1"/>
        <Setter Property="SmallChange" Value="5"/>
        <Setter Property="LargeChange" Value="10"/>
        <Setter Property="IsThumbToolTipEnabled" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- SliderContainer: toda la altura recibe el clic, aunque la línea mida 2 px -->
                    <Grid x:Name="SliderContainer" Height="{StaticResource VolumeHitHeight}" Background="Transparent">
                        <Grid x:Name="HorizontalTemplate">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="{StaticResource VolumeLineHeight}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center" Fill="{StaticResource VolumeTrackBrush}"/>
                            <Rectangle x:Name="HorizontalDecreaseRect" Height="{StaticResource VolumeLineHeight}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center" Fill="{StaticResource AccentBrush}"/>
                            <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="{StaticResource VolumeThumbSize}" Height="{StaticResource VolumeThumbSize}"
                                   Style="{StaticResource VolumeThumbStyle}" DataContext="{TemplateBinding Value}" IsTabStop="False"
                                   Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Thumb.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" ScaleX="0.6" ScaleY="0.6"/>
                                </Thumb.RenderTransform>
                            </Thumb>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Opacity" Value="1"/>
                                        <Setter Target="ThumbScale.ScaleX" Value="1"/>
                                        <Setter Target="ThumbScale.ScaleY" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Opacity" Value="1"/>
                                        <Setter Target="ThumbScale.ScaleX" Value="1.2"/>
                                        <Setter Target="ThumbScale.ScaleY" Value="1.2"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalTemplate.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- Con el teclado (Tab) el punto también se ve, en vez del rectángulo de foco del sistema -->
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Opacity" Value="1"/>
                                        <Setter Target="ThumbScale.ScaleX" Value="1"/>
                                        <Setter Target="ThumbScale.ScaleY" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bocina: solo el glifo, gris claro → blanco con el mouse; al presionar, rojo -->
    <Style x:Key="VolumeIconButton" TargetType="componentes:BotonBocina">
        <Setter Property="Width" Value="{StaticResource VolumeHitHeight}"/>
        <Setter Property="Height" Value="{StaticResource VolumeHitHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource VolumeIconBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="componentes:BotonBocina">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource AccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
