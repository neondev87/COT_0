<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos del manual de Lain. Se mezcla en ManualPage.
     Paleta del proyecto: negro, línea roja y Barlow Condensed. Capas: fondo elegido como cuadro fijo (CapaFondo), un solo velo negro al 60 % y el contenido;
     los paneles son "vidrio" barato: degradado translúcido + borde claro de 1 px, sin desenfoque. Solo opacidad y traslación animadas -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:componentes="using:COT_0.Host.Views.Componentes"
    xmlns:manual="using:COT_0.Host.Views.Componentes.Manual">

    <SolidColorBrush x:Key="ManualText2Brush" Color="#A6E6E6E6"/>
    <SolidColorBrush x:Key="ManualGlassEdgeBrush" Color="#1FFFFFFF"/>
    <!-- Marco de la vista de ejemplo: rojo del proyecto muy tenue -->
    <SolidColorBrush x:Key="ManualFrameBrush" Color="#59B3122E"/>
    <SolidColorBrush x:Key="KeycapBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="KeycapEdgeBrush" Color="#8CB3122E"/>
    <!-- Destello de la señal al cambiar de paso (reemplaza SignalLossLayer) -->
    <SolidColorBrush x:Key="SignalFlashBrush" Color="#24FFFFFF"/>
    <!-- Único velo del manual sobre el fondo elegido: negro uniforme al 60 % (se lee el texto y se ve el fondo) -->
    <SolidColorBrush x:Key="ManualVeilBrush" Color="#99000000"/>
    <!-- Vidrio: de arriba (más claro) a abajo, casi transparente -->
    <LinearGradientBrush x:Key="ManualGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0"/>
        <GradientStop Color="#06FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Fondo de la vista de ejemplo: vidrio más oscuro para que la réplica se lea -->
    <LinearGradientBrush x:Key="ManualStageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B30A0A0C" Offset="0"/>
        <GradientStop Color="#CC070708" Offset="1"/>
    </LinearGradientBrush>
    <!-- Orillas del video sin canal alfa: el negro exacto del video de Lain (#000000, muestreado con ffmpeg), que también es
         el color del velo. Cada brocha se llama por el lado que queda opaco; las esquinas son radiales y empatan con las franjas -->
    <Color x:Key="ManualBlackColor">#FF000000</Color>
    <Color x:Key="ManualClearColor">#00000000</Color>
    <LinearGradientBrush x:Key="EdgeTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeBottomBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeLeftBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeRightBrush" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="EdgeCornerTopLeftBrush" Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="EdgeCornerTopRightBrush" Center="0,1" GradientOrigin="0,1" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </RadialGradientBrush>

    <x:Double x:Key="ManualColumnWidth">330</x:Double>
    <!-- Lain (480 × 854 o el GIF de 314 × 560): 560 de alto, pegada abajo; sus avisos terminan antes de donde empieza la figura -->
    <x:Double x:Key="LainVideoHeight">560</x:Double>
    <x:Double x:Key="LainVideoWidth">315</x:Double>
    <Thickness x:Key="LainMargin">40,0,0,0</Thickness>
    <!-- Opción B (sin GIF): franjas negras alrededor del video que se desvanecen hacia afuera -->
    <x:Double x:Key="LainBlendLeft">40</x:Double>
    <x:Double x:Key="LainBlendRight">100</x:Double>
    <x:Double x:Key="LainBlendTop">140</x:Double>
    <x:Double x:Key="FarewellVideoOpacity">0.45</x:Double>
    <!-- Despedida (1022 × 720): 900 × 634 al centro y abajo, como fondo detrás del texto. Cuatro orillas hacia adentro al 20 %
         del lado (180 y 127) que llevan su azul al negro, y franjas negras hacia afuera (120 a los lados, 80 arriba) -->
    <x:Double x:Key="FarewellVideoWidth">900</x:Double>
    <x:Double x:Key="FarewellVideoHeight">634</x:Double>
    <x:Double x:Key="FarewellFadeSide">180</x:Double>
    <x:Double x:Key="FarewellFadeEnds">127</x:Double>
    <x:Double x:Key="FarewellBlendSide">120</x:Double>
    <x:Double x:Key="FarewellBlendTop">80</x:Double>
    <CornerRadius x:Key="ManualGlassRadius">12</CornerRadius>

    <!-- Panel de vidrio (atajos, vista de ejemplo, despedida) -->
    <Style x:Key="ManualGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ManualGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ManualGlassEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ManualGlassRadius}"/>
    </Style>

    <Style x:Key="ManualHeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ManualStepTitleText" TargetType="TextBlock" BasedOn="{StaticResource ManualHeadingText}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style x:Key="ManualStepNumberText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedBold}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CharacterSpacing" Value="200"/>
        <Setter Property="Foreground" Value="{StaticResource ManualText2Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <!-- BotonManual: atajo (keycap + acción) o botón redondeado. Sin tabulación: ENTER siempre es "empezar" -->
    <Style x:Key="BotonManualStyle" TargetType="manual:BotonManual">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ManualText2Brush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="manual:BotonManual">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="Key" MinWidth="28" Padding="8,5" CornerRadius="4" Background="{StaticResource KeycapBrush}"
                                    BorderBrush="{StaticResource KeycapEdgeBrush}" BorderThickness="0,0,0,2">
                                <TextBlock Text="{TemplateBinding KeyText}" TextAlignment="Center" FontFamily="{StaticResource FontInterMedium}"
                                           FontSize="12" Foreground="{StaticResource LightBrush}"/>
                            </Border>
                            <ContentPresenter x:Name="Content" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource AccentLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.35"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ManualKeycap" TargetType="manual:BotonManual" BasedOn="{StaticResource BotonManualStyle}">
        <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>
    <Style x:Key="ManualButton" TargetType="manual:BotonManual" BasedOn="{StaticResource BotonManualStyle}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CharacterSpacing" Value="60"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="Background" Value="{StaticResource ManualGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ManualGlassEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ManualSmallButton" TargetType="manual:BotonManual" BasedOn="{StaticResource ManualButton}">
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
</ResourceDictionary>
