<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del manual de Lain: azul noche opaco (tapa el fondo de la app, que sigue corriendo debajo), barrido tenue, estática
     de una textura fija que solo se traslada, sombra donde está Lain y orillas para fundir sus videos sin recuadro.
     Lo mezclan ManualPage, FondoManual y EstaticaManual -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Azul noche de siempre del manual, ahora opaco -->
    <RadialGradientBrush x:Key="ManualBaseBrush" Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#FF0E2733" Offset="0"/>
        <GradientStop Color="#FF08172F" Offset="0.52"/>
        <GradientStop Color="#FF040C1A" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ManualSweepBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#009CD6D5" Offset="0"/>
        <GradientStop Color="#0C9CD6D5" Offset="0.5"/>
        <GradientStop Color="#009CD6D5" Offset="1"/>
    </LinearGradientBrush>
    <x:Double x:Key="ManualSweepHeight">120</x:Double>
    <!-- Estática: Assets\Imagenes\Manual\estatica.png (960 × 540, puntos blancos con alfa), más grande que la pantalla
         (StaticBleed por lado) para poder saltar de lugar sin dejar orillas -->
    <x:Double x:Key="ManualStaticOpacity">0.08</x:Double>
    <Thickness x:Key="ManualStaticBleed">-48</Thickness>

    <!-- Video de Lain (opción B) y GIF (opción A): su cuadro es negro exacto (#000000, muestreado con ffmpeg).
         Una sombra negra radial abajo a la izquierda lo recibe y se pierde en el azul -->
    <Color x:Key="ManualBlackColor">#FF000000</Color>
    <Color x:Key="ManualClearColor">#00000000</Color>
    <RadialGradientBrush x:Key="LainShadeBrush" Center="0.28,1" GradientOrigin="0.28,1" RadiusX="0.72" RadiusY="1">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0.65"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </RadialGradientBrush>
    <x:Double x:Key="LainShadeWidth">820</x:Double>
    <x:Double x:Key="LainShadeHeight">1000</x:Double>
    <!-- Opción A (GIF): orillas hacia adentro con el negro, para que el cuadro que le quede al GIF no se note (abajo no: es el borde de la pantalla) -->
    <x:Double x:Key="LainCutoutFade">36</x:Double>

    <!-- Orillas negras de Lain. Cada brocha se llama por el lado que queda opaco; las esquinas son radiales y empatan con las franjas -->
    <LinearGradientBrush x:Key="EdgeTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeBottomBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeLeftBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeRightBrush" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="EdgeCornerTopLeftBrush" Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="EdgeCornerTopRightBrush" Center="0,1" GradientOrigin="0,1" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource ManualBlackColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ManualClearColor}" Offset="1"/>
    </RadialGradientBrush>

    <!-- Despedida: su video es azul (#06122C), casi el del fondo; sus orillas y franjas van a ese azul en lugar del negro -->
    <Color x:Key="FarewellBlueColor">#FF06122C</Color>
    <Color x:Key="FarewellClearColor">#0006122C</Color>
    <LinearGradientBrush x:Key="FarewellEdgeTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FarewellEdgeBottomBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FarewellEdgeLeftBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FarewellEdgeRightBrush" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="FarewellCornerTopLeftBrush" Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="FarewellCornerTopRightBrush" Center="0,1" GradientOrigin="0,1" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="FarewellCornerBottomLeftBrush" Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="FarewellCornerBottomRightBrush" Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="1">
        <GradientStop Color="{StaticResource FarewellBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource FarewellClearColor}" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
