<?xml version="1.0" encoding="utf-8"?>
<!-- Textos del dashboard: reloj grande, fecha, estado de la sala y pie. Lo mezcla DashboardPage en sus recursos -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ClockText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedExtraLight}"/>
        <Setter Property="FontSize" Value="164"/>
        <Setter Property="LineHeight" Value="151"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="CharacterSpacing" Value="-10"/>
        <Setter Property="Foreground" Value="{StaticResource Text62Brush}"/>
    </Style>
    <Style x:Key="ClockSecondsText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedLight}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Margin" Value="10,18,0,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Foreground" Value="{StaticResource Text40Brush}"/>
    </Style>
    <Style x:Key="DateText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CharacterSpacing" Value="320"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Text58Brush}"/>
    </Style>

    <Style x:Key="StatusLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="400"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="{StaticResource Text55Brush}"/>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedBold}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="CharacterSpacing" Value="140"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="ConnectedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedLight}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Text70Brush}"/>
    </Style>

    <!-- Botón sin aspecto propio (SALA ACTIVA lleva a la sala): solo cambia el cursor del sistema -->
    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
