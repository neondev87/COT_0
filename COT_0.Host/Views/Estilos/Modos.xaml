<?xml version="1.0" encoding="utf-8"?>
<!-- Switch HOST | ADMIN del login, CARRITO | UNO POR UNO de la tienda y la marca "MODO ADMIN" de los encabezados.
     Dos RadioButton pegados dentro de un borde fino; el elegido se llena con el acento. Transición de 0.15 s, solo color y opacidad -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ModeSwitchBorderBrush" Color="#33FFFFFF"/>

    <Style x:Key="ModeSwitchFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource ModeSwitchBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ModeSwitchOption" TargetType="RadioButton">
        <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Foreground" Value="{StaticResource Text55Brush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <Border x:Name="Fill" Background="{StaticResource AccentBrush}" CornerRadius="3" Margin="-14,0" Opacity="0"/>
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontCondensedBold}"
                                   FontWeight="Bold" FontSize="12" CharacterSpacing="260"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Opacity" Value="1"/>
                                        <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "MODO ADMIN": etiqueta con borde de acento -->
    <Style x:Key="AdminBadge" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AdminBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedBold}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="260"/>
        <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
    </Style>
</ResourceDictionary>
