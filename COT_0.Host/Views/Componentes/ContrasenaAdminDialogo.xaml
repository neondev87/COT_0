<?xml version="1.0" encoding="utf-8"?>
<!-- Contraseña generada de un admin, una sola vez: aviso claro, la contraseña oculta con VER y COPIAR, y ENTENDIDO.
     Esc y clic fuera no lo cierran; ENTENDIDO sin copiar pide confirmar con un segundo clic -->
<ContentDialog x:Class="COT_0.Host.Views.Componentes.ContrasenaAdminDialogo"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               DefaultButton="None"
               CornerRadius="0"
               Background="{StaticResource WindowBackgroundBrush}"
               BorderBrush="{StaticResource PanelBorderBrush}"
               BorderThickness="1"
               PrimaryButtonText="{x:Bind ViewModel.CloseText, Mode=OneWay}"
               PrimaryButtonStyle="{StaticResource ConfirmButton}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">600</x:Double>
        <Thickness x:Key="ContentDialogPadding">48,44,48,40</Thickness>
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="WindowBackgroundBrush"/>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="DialogVeilBrush"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Margin="0,0,0,24">
        <Rectangle Width="28" Height="1" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>
        <TextBlock Text="{x:Bind ViewModel.Title}" TextWrapping="Wrap" FontFamily="{StaticResource FontCondensedLight}"
                   FontSize="24" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{StaticResource Text.Admin.Password.Warning}" TextWrapping="WrapWholeWords" FontFamily="{StaticResource FontCondensedBold}"
                   FontWeight="Bold" FontSize="14" CharacterSpacing="120" Foreground="{StaticResource AccentLightBrush}"/>

        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <TextBlock Text="{x:Bind ViewModel.DisplayText, Mode=OneWay}" FontFamily="Consolas" FontSize="22" CharacterSpacing="120"
                       IsTextSelectionEnabled="False" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Style="{StaticResource SolidButton}" Content="{x:Bind ViewModel.RevealText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleRevealCommand}"/>
            <Button Style="{StaticResource SolidButton}" Content="{x:Bind ViewModel.CopyText, Mode=OneWay}" Command="{x:Bind ViewModel.CopyCommand}"/>
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.ClipboardHint}" TextWrapping="WrapWholeWords" Style="{StaticResource InterText}"
                   Visibility="{x:Bind ViewModel.IsCopied, Mode=OneWay}"/>
        <TextBlock Text="{StaticResource Text.Admin.Password.CopyFailed}" TextWrapping="WrapWholeWords" Style="{StaticResource InterText}"
                   Foreground="{StaticResource AccentLightBrush}" Visibility="{x:Bind ViewModel.IsCopyFailed, Mode=OneWay}"/>
        <TextBlock Text="{StaticResource Text.Admin.Password.NotCopied}" TextWrapping="WrapWholeWords" Style="{StaticResource InterText}"
                   Foreground="{StaticResource AccentLightBrush}" Visibility="{x:Bind ViewModel.IsConfirmPending, Mode=OneWay}"/>
    </StackPanel>
</ContentDialog>
