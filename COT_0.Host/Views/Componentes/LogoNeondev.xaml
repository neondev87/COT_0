<?xml version="1.0" encoding="utf-8"?>
<!-- Logo Neondev: avatar de 80 px (64 + 25%) con esquinas de 17.5, "Neondev" en Redaction 50.4 (36 + 40%)
     y el brillo "aero" de vidrio que cruza el avatar (ida y vuelta, 3 s por lado). Clic: abre el repositorio (Branding:RepoUrl).
     Avatar y nombre en una fila de columnas automáticas, los dos centrados en vertical.
     Todo vive en la plantilla: el barrido corre en los estados Normal y PointerOver, así arranca solo sin código -->
<UserControl x:Class="COT_0.Host.Views.Componentes.LogoNeondev"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Medidas de la firma en un solo lugar: avatar 64 × 1.25 = 80, esquinas 14 × 1.25 = 17.5, nombre 36 × 1.4 = 50.4.
             El brillo recorre de -80 a 80 (un avatar completo a cada lado) -->
        <x:Double x:Key="LogoAvatarSize">80</x:Double>
        <CornerRadius x:Key="LogoAvatarRadius">17.5</CornerRadius>
        <x:Double x:Key="LogoNameFontSize">50.4</x:Double>
        <x:Double x:Key="LogoShineStart">-80</x:Double>
        <x:Double x:Key="LogoShineEnd">80</x:Double>

        <!-- Colores del avatar, del borde y del borde con el mouse -->
        <SolidColorBrush x:Key="LogoAvatarBrush" Color="#1C1C24"/>
        <SolidColorBrush x:Key="LogoBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="LogoBorderHoverBrush" Color="#59FFFFFF"/>

        <!-- Degradado de vidrio; se mueve el rectángulo (RenderTransform, en el compositor)
             en lugar de animar el RelativeTransform del pincel -->
        <LinearGradientBrush x:Key="LogoShineBrush" StartPoint="0,0" EndPoint="1,0.6">
            <GradientStop Color="#00FFFFFF" Offset="0.3"/>
            <GradientStop Color="#4DFFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        </LinearGradientBrush>

        <Style x:Key="LogoLink" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="{StaticResource LogoAvatarSize}" Height="{StaticResource LogoAvatarSize}" VerticalAlignment="Center">
                                <Border CornerRadius="{StaticResource LogoAvatarRadius}" Background="{StaticResource LogoAvatarBrush}"/>
                                <!-- Border con CornerRadius recorta a sus hijos: el brillo no se sale de las esquinas -->
                                <Border CornerRadius="{StaticResource LogoAvatarRadius}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="ms-appx:///Assets/Imagenes/neondev-avatar.png" Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Rectangle x:Name="Shine" Width="{StaticResource LogoAvatarSize}" Height="{StaticResource LogoAvatarSize}" Fill="{StaticResource LogoShineBrush}" IsHitTestVisible="False">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="ShineShift" X="{StaticResource LogoShineStart}"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                                <Border x:Name="Frame" CornerRadius="{StaticResource LogoAvatarRadius}" BorderThickness="1" BorderBrush="{StaticResource LogoBorderBrush}"/>
                            </Grid>
                            <!-- TextLineBounds Tight: la caja del texto es la de sus letras, así el centro coincide con el del avatar -->
                            <TextBlock x:Name="Name" Grid.Column="1" Text="{StaticResource Text.Signature.Name}" VerticalAlignment="Center"
                                       TextLineBounds="Tight" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       FontFamily="{StaticResource FontRedaction}" FontSize="{StaticResource LogoNameFontSize}" CharacterSpacing="20"
                                       Foreground="{StaticResource LightBrush}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.2"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" From="{StaticResource LogoShineStart}" To="{StaticResource LogoShineEnd}"
                                                             Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <!-- Con el mouse: el borde del vidrio se aclara y el nombre pasa al acento.
                                         Sin DropShadow en el nombre (sombras caras) -->
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" From="{StaticResource LogoShineStart}" To="{StaticResource LogoShineEnd}"
                                                             Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Frame.BorderBrush" Value="{StaticResource LogoBorderHoverBrush}"/>
                                            <Setter Target="Name.Foreground" Value="{StaticResource AccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Frame.BorderBrush" Value="{StaticResource LogoBorderHoverBrush}"/>
                                            <Setter Target="Name.Foreground" Value="{StaticResource AccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Button Style="{StaticResource LogoLink}" Command="{x:Bind ViewModel.OpenRepoCommand}"
            ToolTipService.ToolTip="{StaticResource Text.Signature.Link}" AutomationProperties.Name="{StaticResource Text.Signature.Link}"/>
</UserControl>
