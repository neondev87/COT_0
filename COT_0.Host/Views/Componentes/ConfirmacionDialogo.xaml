<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmación sí/no con el estilo de la sala: línea de acento, mensaje grande, CANCELAR y botón de acento -->
<ContentDialog x:Class="COT_0.Host.Views.Componentes.ConfirmacionDialogo"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               DefaultButton="Primary"
               CornerRadius="0"
               Background="{StaticResource WindowBackgroundBrush}"
               BorderBrush="{StaticResource PanelBorderBrush}"
               BorderThickness="1"
               PrimaryButtonStyle="{StaticResource ConfirmButton}"
               CloseButtonStyle="{StaticResource CancelButton}">

    <ContentDialog.Resources>
        <!-- Ancho fijo del diálogo -->
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">600</x:Double>
        <Thickness x:Key="ContentDialogPadding">48,48,48,40</Thickness>
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="WindowBackgroundBrush"/>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="DialogVeilBrush"/>
    </ContentDialog.Resources>

    <StackPanel Margin="0,0,0,28">
        <Rectangle Width="28" Height="1" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>
        <TextBlock x:Name="MessageText" Margin="0,18,0,0" TextWrapping="Wrap"
                   FontFamily="{StaticResource FontCondensedLight}" FontSize="26" Foreground="{StaticResource TextBrush}"/>
    </StackPanel>
</ContentDialog>
