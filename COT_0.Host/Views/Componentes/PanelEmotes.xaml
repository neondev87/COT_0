<?xml version="1.0" encoding="utf-8"?>
<!-- Bloque EMOTES: set de 7TV (campo + APLICAR + estado), reportes de los invitados y emotes quitados -->
<UserControl x:Class="COT_0.Host.Views.Componentes.PanelEmotes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="using:COT_0.Host.Views.Componentes"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <x:Double x:Key="EmoteApplyWidth">132</x:Double>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
        </Style>
        <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource InterText}">
            <Setter Property="Margin" Value="16,12"/>
            <Setter Property="Foreground" Value="{StaticResource Light40Brush}"/>
        </Style>
        <Style x:Key="EmoteRow" TargetType="Grid">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="16,0,6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource RowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Set de 7TV: fila 1 título | contador; fila 2 campo | APLICAR (misma altura); fila 3 estado con wrap -->
            <Grid Margin="16,12,16,14" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{StaticResource Text.Emotes.Title}" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource InterText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBox Grid.Row="1" Style="{StaticResource LoginTextBox}" FontSize="13" PlaceholderText="{StaticResource Text.Emotes.Placeholder}"
                         VerticalAlignment="Stretch" Text="{x:Bind ViewModel.SetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SolidButton}" Content="{StaticResource Text.Emotes.Apply}"
                        MinWidth="{StaticResource EmoteApplyWidth}" Height="{StaticResource InputHeight}"
                        Command="{x:Bind ViewModel.ApplyCommand}" KeyboardAcceleratorPlacementMode="Hidden">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="WrapWholeWords"
                           FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold" FontSize="13" CharacterSpacing="200"
                           Foreground="{x:Bind componentes:EmoteStatusBrushes.For(ViewModel.Status), Mode=OneWay}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SectionHeader}">
                        <TextBlock Text="{StaticResource Text.Emotes.Reports}" Style="{StaticResource ColumnHeaderText}"/>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Reports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EmoteRowViewModel">
                                <Grid Style="{StaticResource EmoteRow}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Thumbnail}" Width="32" Height="32" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowNameText}" FontSize="13"/>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource InterText}" FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Emotes.Remove}" Click="OnRemoveClick"/>
                                        <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Emotes.Ignore}" Click="OnIgnoreClick"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{StaticResource Text.Emotes.NoReports}" Style="{StaticResource EmptyText}"
                               Visibility="{x:Bind ViewModel.NoReports, Mode=OneWay}"/>

                    <Border Style="{StaticResource SectionHeader}">
                        <TextBlock Text="{StaticResource Text.Emotes.Removed}" Style="{StaticResource ColumnHeaderText}"/>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Removed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EmoteRowViewModel">
                                <Grid Style="{StaticResource EmoteRow}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Thumbnail}" Width="32" Height="32" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowNameText}" FontSize="13"/>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource InterText}" FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="{StaticResource Text.Emotes.Restore}"
                                            Click="OnRestoreClick"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{StaticResource Text.Emotes.NoRemoved}" Style="{StaticResource EmptyText}"
                               Visibility="{x:Bind ViewModel.NoRemoved, Mode=OneWay}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
