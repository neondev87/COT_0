<?xml version="1.0" encoding="utf-8"?>
<!-- Sello COMPRA REALIZADA al confirmar una compra: disco con degradado de acento y anillo que aparece (opacidad),
     crece con un pequeño rebote (escala) y el anillo gira una vez. Ligero: sin desenfoque ni sombras. No recibe clics -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.SelloCompra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="SealEffect">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Seal" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SealScale" Storyboard.TargetProperty="ScaleX">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.08">
                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SealScale" Storyboard.TargetProperty="ScaleY">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.08">
                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="RingTurn" Storyboard.TargetProperty="Angle" From="0" To="180" Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Seal" Width="{StaticResource PurchaseSealSize}" Height="{StaticResource PurchaseSealSize}" Opacity="0"
          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="SealScale"/>
        </Grid.RenderTransform>
        <Ellipse Fill="{StaticResource PurchaseSealBrush}"/>
        <Ellipse Stroke="{StaticResource PurchaseSealRingBrush}" StrokeThickness="3" Margin="6" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingTurn"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <StackPanel VerticalAlignment="Center" Spacing="6" Margin="28,0">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{StaticResource WhiteBrush}"/>
            <TextBlock Text="{StaticResource Text.Store.Summary.Seal}" Style="{StaticResource PurchaseSealText}"/>
        </StackPanel>
    </Grid>
</UserControl>
