<?xml version="1.0" encoding="utf-8"?>
<!-- TICKETS: los tickets de quien hizo ENTRAR, el más nuevo primero (número, fecha, hora, miniaturas y DESCARGAR PDF).
     Sin compras: "Aún no has comprado nada." con IR A LA TIENDA -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.SeccionTickets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{StaticResource Text.Store.Tickets.Title}" Style="{StaticResource ShopTitleText}"/>

        <InfoBar Grid.Row="1" Title="{StaticResource Text.Store.NoticeTitle}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.Notice.Severity, Mode=OneWay}" IsOpen="{x:Bind ViewModel.Notice.IsOpen, Mode=TwoWay}"/>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Tickets}" SelectionMode="None" IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource FlatListItem}" Visibility="{x:Bind ViewModel.HasTickets, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TicketViewModel">
                    <Border Style="{StaticResource ShopCard}" Margin="0,0,0,10">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Number}" Style="{StaticResource ShopTitleText}" FontSize="15"/>
                                <TextBlock Text="{x:Bind Date}" Style="{StaticResource InterText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource InterText}"/>
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource InterText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Emotes}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="14"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EmoteThumbViewModel">
                                        <StackPanel Spacing="4">
                                            <Image Source="{x:Bind Thumbnail}" Width="{StaticResource ShopSmallThumbSize}"
                                                   Height="{StaticResource ShopSmallThumbSize}" Stretch="Uniform"/>
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource InterText}" MaxWidth="96" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="2" Style="{StaticResource ShopActionButton}" VerticalAlignment="Center"
                                    Content="{StaticResource Text.Store.Tickets.Download}" Click="OnDownloadClick"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Spacing="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock Text="{StaticResource Text.Store.Tickets.Empty}" Style="{StaticResource ShopEmptyText}"/>
            <Button Style="{StaticResource SolidButton}" HorizontalAlignment="Center" Content="{StaticResource Text.Store.Tickets.GoShop}"
                    Command="{x:Bind ViewModel.GoShopCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
