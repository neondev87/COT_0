<?xml version="1.0" encoding="utf-8"?>
<!-- Recuadro sobre el velo: emotes comprados de un usuario (miniatura y nombre), cuántos lleva hoy y cuántos le quedan -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.RecuadroStock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <Rectangle Width="28" Height="1" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>
            <TextBlock Text="{x:Bind Stock.Title, Mode=OneWay}" Style="{StaticResource ShopTitleText}"/>
            <TextBlock Text="{x:Bind Stock.Summary, Mode=OneWay}" Style="{StaticResource InterText}" TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <GridView Grid.Row="1" ItemsSource="{x:Bind Stock.Emotes, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource ShopGridItem}" Visibility="{x:Bind Stock.HasEmotes, Mode=OneWay}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:EmoteThumbViewModel">
                    <Border Style="{StaticResource ShopCard}" Width="{StaticResource ShopEmoteCardWidth}">
                        <StackPanel Spacing="8">
                            <Image Source="{x:Bind Thumbnail}" Width="{StaticResource ShopThumbSize}" Height="{StaticResource ShopThumbSize}" Stretch="Uniform"/>
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowNameText}" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <TextBlock Grid.Row="1" Text="{StaticResource Text.Store.Stock.Empty}" Style="{StaticResource ShopEmptyText}" Margin="0,24"
                   Visibility="{x:Bind Stock.IsEmpty, Mode=OneWay}"/>

        <Button Grid.Row="2" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Content="{StaticResource Text.Store.Close}"
                Command="{x:Bind CloseCommand, Mode=OneWay}"/>
    </Grid>
</UserControl>
