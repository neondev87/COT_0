<?xml version="1.0" encoding="utf-8"?>
<!-- Panel COMPRA REALIZADA (va dentro del recuadro con velo de EmotesPage): ticket, emotes comprados con su precio
     de muestra, total y DESCARGAR PDF | SOLO VER PDF | SALIR. ESC o clic en el velo también salen -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.PanelCompra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="14">
        <Rectangle Width="28" Height="1" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>
        <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}" Style="{StaticResource ShopTitleText}" FontSize="20"/>
        <TextBlock Text="{StaticResource Text.Store.Summary.Subtitle}" Style="{StaticResource InterText}" TextWrapping="WrapWholeWords"/>

        <ScrollViewer MaxHeight="{StaticResource PurchaseSummaryListMaxHeight}" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PurchaseSummaryLineViewModel">
                        <Grid ColumnSpacing="12" Padding="0,6" BorderBrush="{StaticResource RowBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{x:Bind Thumbnail}" Width="{StaticResource ShopSmallThumbSize}" Height="{StaticResource ShopSmallThumbSize}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource RowNameText}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind PriceText}" Style="{StaticResource ShopPriceText}" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource ShopTitleText}" FontSize="15"
                   HorizontalAlignment="Right" Foreground="{StaticResource AccentLightBrush}"/>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Store.Summary.Exit}"
                    Command="{x:Bind ViewModel.ExitCommand, Mode=OneWay}"/>
            <Button Style="{StaticResource ShopActionButton}" Content="{StaticResource Text.Store.Summary.View}"
                    Command="{x:Bind ViewModel.ViewCommand, Mode=OneWay}"/>
            <Button Style="{StaticResource SolidButton}" Content="{StaticResource Text.Store.Summary.Download}"
                    Command="{x:Bind ViewModel.DownloadCommand, Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
