<?xml version="1.0" encoding="utf-8"?>
<!-- TIENDA: aviso fijo del cupo, switch CARRITO | UNO POR UNO y "Te quedan X de 10"; buscador, avisos (bloqueo con HH:MM:SS),
     la cuadrícula de 7TV que pide más páginas al final del scroll y el carrito a la derecha. Encima, el efecto de compra -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.SeccionTienda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validaciones="using:COT_0.Host.Services.Validaciones"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Efecto de compra: el emote se encoge y vuela al contador; el contador late, destello verde y "¡Comprado!" -->
            <Storyboard x:Key="BuyEffect">
                <DoubleAnimation Storyboard.TargetName="GhostMove" Storyboard.TargetProperty="TranslateX" From="0" Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="GhostMove" Storyboard.TargetProperty="TranslateY" From="0" Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="GhostMove" Storyboard.TargetProperty="ScaleX" From="1" To="0.3" Duration="0:0:0.45"/>
                <DoubleAnimation Storyboard.TargetName="GhostMove" Storyboard.TargetProperty="ScaleY" From="1" To="0.3" Duration="0:0:0.45"/>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ghost" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0.6"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.46" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="QuotaPulse" Storyboard.TargetProperty="ScaleX">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="1.25"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="QuotaPulse" Storyboard.TargetProperty="ScaleY">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="1.25"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.52" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DoneText" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Aviso fijo | switch CARRITO | UNO POR UNO | contador (late al comprar) -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ShopRulesBanner}">
                    <TextBlock Text="{x:Bind ViewModel.RulesText}" Style="{StaticResource ShopRulesText}"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ShopTab}" GroupName="PurchaseMode" Content="{StaticResource Text.Store.Mode.Cart}"
                                 IsChecked="{x:Bind ViewModel.IsCartMode, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource ShopTab}" GroupName="PurchaseMode" Content="{StaticResource Text.Store.Mode.OneByOne}"
                                 IsChecked="{x:Bind ViewModel.IsOneByOneMode, Mode=TwoWay}"/>
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Border x:Name="Flash" Style="{StaticResource ShopFlash}" Opacity="0"/>
                    <TextBlock x:Name="QuotaCounter" Text="{x:Bind ViewModel.QuotaText, Mode=OneWay}" Style="{StaticResource ShopTitleText}"
                               Margin="12,4" Foreground="{StaticResource AccentLightBrush}" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="QuotaPulse"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Buscador (letras y números, hasta Inputs:MaxCaracteres) -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource ShopSearchWidth}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource LoginTextBox}" FontSize="13" PlaceholderText="{StaticResource Text.Store.Shop.SearchPlaceholder}"
                         MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource SolidButton}" Content="{StaticResource Text.Store.Shop.Search}"
                        Command="{x:Bind ViewModel.SearchCommand}"/>
                <TextBlock Grid.Column="2" x:Name="DoneText" Text="{StaticResource Text.Store.Shop.Done}" Style="{StaticResource ShopDoneText}" Opacity="0"/>
            </Grid>

            <!-- Cupo agotado: el temporizador corre cada segundo leyendo la hora de reinicio de compras.json -->
            <InfoBar Grid.Row="2" Title="{StaticResource Text.Store.NoticeTitle}" Message="{x:Bind ViewModel.Timer.BlockedText, Mode=OneWay}"
                     Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.IsBlocked, Mode=OneWay}"/>
            <InfoBar Grid.Row="3" Title="{StaticResource Text.Store.NoticeTitle}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.Notice.Severity, Mode=OneWay}" IsOpen="{x:Bind ViewModel.Notice.IsOpen, Mode=TwoWay}"/>

            <!-- 7TV falló: el motivo y REINTENTAR (la tienda no tumba la app) -->
            <Grid Grid.Row="4" ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="WrapWholeWords" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold" FontSize="13" CharacterSpacing="200"
                           Foreground="{StaticResource AccentLightBrush}"/>
                <Button Grid.Column="1" Style="{StaticResource SolidButton}" Content="{StaticResource Text.Store.Shop.Retry}"
                        Command="{x:Bind ViewModel.RetryCommand}"/>
            </Grid>

            <Grid Grid.Row="5" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <GridView x:Name="Grid7tv" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource ShopGridItem}" IncrementalLoadingTrigger="Edge" DataFetchSize="1">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShopEmoteViewModel">
                            <Border Style="{StaticResource ShopCard}" Width="{StaticResource ShopEmoteCardWidth}">
                                <StackPanel Spacing="10">
                                    <Image Source="{x:Bind Thumbnail}" Width="{StaticResource ShopThumbSize}" Height="{StaticResource ShopThumbSize}" Stretch="Uniform"/>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowNameText}" FontSize="13" HorizontalAlignment="Center"/>
                                    <Button Style="{StaticResource ShopActionButton}" Content="{x:Bind ButtonText, Mode=OneWay}"
                                            IsEnabled="{x:Bind IsBuyEnabled, Mode=OneWay}" Click="OnPickClick"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Text="{StaticResource Text.Store.Shop.Empty}" Style="{StaticResource ShopEmptyText}" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"/>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,8"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="22" Height="22" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{StaticResource Text.Store.Shop.Loading}" Style="{StaticResource ShopEmptyText}" FontSize="12"/>
                </StackPanel>

                <!-- Carrito (solo en modo CARRITO): miniaturas con QUITAR y un solo COMPRAR -->
                <Border x:Name="CartPanel" Grid.Column="1" Style="{StaticResource ShopCartPanel}" Visibility="{x:Bind ViewModel.IsCartMode, Mode=OneWay}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{StaticResource Text.Store.Cart.Title}" Style="{StaticResource ShopTitleText}" FontSize="15"/>
                            <TextBlock Text="{x:Bind ViewModel.Cart.CountText, Mode=OneWay}" Style="{StaticResource ShopTitleText}" FontSize="15"
                                       Foreground="{StaticResource AccentLightBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{StaticResource Text.Store.Cart.Empty}" Style="{StaticResource ShopEmptyText}" FontSize="12"
                                   VerticalAlignment="Center" Visibility="{x:Bind ViewModel.Cart.IsEmpty, Mode=OneWay}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Cart.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShopEmoteViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{x:Bind Thumbnail}" Width="{StaticResource ShopSmallThumbSize}" Height="{StaticResource ShopSmallThumbSize}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource RowNameText}" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="{StaticResource Text.Store.Cart.Remove}" Click="OnRemoveClick"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Row="2" Style="{StaticResource ShopActionButton}" Content="{StaticResource Text.Store.Cart.Buy}"
                                IsEnabled="{x:Bind ViewModel.CanBuyCart, Mode=OneWay}" Command="{x:Bind ViewModel.BuyCartCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Copia del emote que vuela al contador (no recibe clics) -->
        <Canvas IsHitTestVisible="False">
            <Image x:Name="Ghost" Width="{StaticResource ShopThumbSize}" Height="{StaticResource ShopThumbSize}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="GhostMove"/>
                </Image.RenderTransform>
            </Image>
        </Canvas>
    </Grid>
</UserControl>
