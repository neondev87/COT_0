<?xml version="1.0" encoding="utf-8"?>
<!-- Un ticket en el PUNTO DE VENTA o en VER FACTURA: número, dueño, fecha y hora, miniaturas, DESCARGAR PDF y ABRIR PDF.
     El ticket llega en el DataContext (renglón de la lista); los botones solo avisan con DownloadClick y ViewClick -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.TarjetaTicket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource ShopCard}" Margin="0,0,0,10">
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource TicketInfoWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Ticket.Number}" Style="{StaticResource ShopTitleText}" FontSize="15"/>
                <TextBlock Text="{x:Bind Ticket.Owner}" Style="{StaticResource InterText}" Foreground="{StaticResource AccentLightBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Ticket.Date}" Style="{StaticResource InterText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Ticket.Time}" Style="{StaticResource InterText}"/>
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Ticket.Emotes}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="14"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EmoteThumbViewModel">
                        <Image Source="{x:Bind Thumbnail}" Width="{StaticResource ShopSmallThumbSize}"
                               Height="{StaticResource ShopSmallThumbSize}" Stretch="Uniform" ToolTipService.ToolTip="{x:Bind Name}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource ShopActionButton}" HorizontalAlignment="Stretch"
                        Content="{StaticResource Text.Store.Tickets.Download}" Click="OnDownloadClick"/>
                <Button Style="{StaticResource ShopActionButton}" HorizontalAlignment="Stretch"
                        Content="{StaticResource Text.Store.Tickets.View}" Click="OnViewClick"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
