<?xml version="1.0" encoding="utf-8"?>
<!-- ADMINISTRADORES (modo ADMIN): nombre del nuevo admin y CREAR ADMIN (se apaga al llegar a Admin:Maximo),
     y la lista de admins (solo nombre) con REGENERAR CONTRASEÑA y ELIMINAR (pide respuesta secreta y tu contraseña). ENTER también crea -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.SeccionAdministradores"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validaciones="using:COT_0.Host.Services.Validaciones"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="{StaticResource Text.Admins.Title}" Style="{StaticResource ShopTitleText}"/>
            <TextBlock Text="{StaticResource Text.Admins.Hint}" Style="{StaticResource InterText}" TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ShopSearchWidth}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource UserNameTextBox}" FontSize="13" PlaceholderText="{StaticResource Text.Admins.NewPlaceholder}"
                     MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                     Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnNameKeyDown"/>
            <Button Grid.Column="1" Style="{StaticResource SolidButton}" Content="{StaticResource Text.Admins.Create}"
                    IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" Command="{x:Bind ViewModel.CreateCommand, Mode=OneWay}"/>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.FullText}" Style="{StaticResource ShopTitleText}" FontSize="13"
                       VerticalAlignment="Center" Foreground="{StaticResource AccentLightBrush}" Visibility="{x:Bind ViewModel.IsFull, Mode=OneWay}"/>
        </Grid>

        <InfoBar Grid.Row="2" Title="{StaticResource Text.Admins.NoticeTitle}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.Notice.Severity, Mode=OneWay}" IsOpen="{x:Bind ViewModel.Notice.IsOpen, Mode=TwoWay}"/>

        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Admins}" SelectionMode="None" IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource FlatListItem}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AdminRowViewModel">
                    <Border Style="{StaticResource ShopCard}" Margin="0,0,0,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowNameText}"/>
                                <TextBlock Text="{StaticResource Text.Admins.You}" Style="{StaticResource InterText}" Visibility="{x:Bind IsYou}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ShopActionButton}" Content="{StaticResource Text.Admins.Regenerate}"
                                    Click="OnRegenerateClick"/>
                            <Button Grid.Column="2" Style="{StaticResource ShopActionButton}" Content="{StaticResource Text.Admins.Delete}"
                                    Click="OnDeleteClick"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
