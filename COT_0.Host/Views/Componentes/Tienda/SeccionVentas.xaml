<?xml version="1.0" encoding="utf-8"?>
<!-- PUNTO DE VENTA (modo ADMIN, solo lectura): totales y buscador arriba; a la izquierda los usuarios (TODOS primero)
     y a la derecha los tickets con su dueño, miniaturas y DESCARGAR PDF. El scroll va dentro de cada lista -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Tienda.SeccionVentas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validaciones="using:COT_0.Host.Services.Validaciones"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TiendaControles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource ShopSearchWidth}"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{StaticResource Text.Sales.Title}" Style="{StaticResource ShopTitleText}"/>
                <TextBlock Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}" Style="{StaticResource InterText}" Foreground="{StaticResource AccentLightBrush}"/>
            </StackPanel>
            <TextBox Grid.Column="1" Style="{StaticResource LoginTextBox}" FontSize="13" VerticalAlignment="Center"
                     PlaceholderText="{StaticResource Text.Sales.SearchPlaceholder}" MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <InfoBar Grid.Row="1" Title="{StaticResource Text.Store.NoticeTitle}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.Notice.Severity, Mode=OneWay}" IsOpen="{x:Bind ViewModel.Notice.IsOpen, Mode=TwoWay}"/>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ShopUserCardWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView ItemsSource="{x:Bind ViewModel.Users}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SalesUserViewModel">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowNameText}"/>
                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource InterText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.Tickets}" SelectionMode="None" IsItemClickEnabled="False"
                      ItemContainerStyle="{StaticResource FlatListItem}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TicketViewModel">
                        <Border Style="{StaticResource ShopCard}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Number}" Style="{StaticResource ShopTitleText}" FontSize="15"/>
                                    <TextBlock Text="{x:Bind Owner}" Style="{StaticResource InterText}" Foreground="{StaticResource AccentLightBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Date}" Style="{StaticResource InterText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource InterText}"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Emotes}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EmoteThumbViewModel">
                                            <Image Source="{x:Bind Thumbnail}" Width="{StaticResource ShopSmallThumbSize}"
                                                   Height="{StaticResource ShopSmallThumbSize}" Stretch="Uniform" ToolTipService.ToolTip="{x:Bind Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="2" Style="{StaticResource ShopActionButton}" VerticalAlignment="Center"
                                        Content="{StaticResource Text.Store.Tickets.Download}" Click="OnDownloadClick"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Column="1" Text="{StaticResource Text.Sales.Empty}" Style="{StaticResource ShopEmptyText}" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>
