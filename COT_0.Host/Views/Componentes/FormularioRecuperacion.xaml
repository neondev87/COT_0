<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperar contraseña dentro del login: usuario, su pregunta guardada, respuesta y, ya verificada, la contraseña nueva dos veces -->
<UserControl x:Class="COT_0.Host.Views.Componentes.FormularioRecuperacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validaciones="using:COT_0.Host.Services.Validaciones">
    <StackPanel>
        <!-- Paso 1: de qué usuario -->
        <StackPanel>
            <TextBlock Text="{StaticResource Text.Login.User}" Style="{StaticResource FieldLabelText}"/>
            <TextBox Style="{StaticResource UserNameTextBox}" PlaceholderText="{StaticResource Text.Login.UserPlaceholder}" MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                     IsEnabled="{x:Bind ViewModel.IsUserEditable, Mode=OneWay}"
                     Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Paso 2: su pregunta y la respuesta -->
        <StackPanel Visibility="{x:Bind ViewModel.HasQuestion, Mode=OneWay}" Margin="0,22,0,0">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{StaticResource Text.Question.Label}" Style="{StaticResource FieldLabelText}"/>
                <TextBlock Text="{x:Bind ViewModel.QuestionText, Mode=OneWay}" TextWrapping="Wrap"
                           FontFamily="{StaticResource FontBarlow}" FontSize="15" Foreground="{StaticResource LightBrush}"/>
            </StackPanel>
            <TextBlock Text="{StaticResource Text.Question.Answer}" Style="{StaticResource FieldLabelText}"/>
            <TextBox Style="{StaticResource LoginTextBox}" PlaceholderText="{StaticResource Text.Question.AnswerPlaceholder}" MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                     IsEnabled="{x:Bind ViewModel.IsAnswerEditable, Mode=OneWay}"
                     Text="{x:Bind ViewModel.Answer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Paso 3: solo después de contestar bien -->
        <StackPanel Visibility="{x:Bind ViewModel.IsAnswerVerified, Mode=OneWay}">
            <StackPanel Margin="0,22,0,22">
                <TextBlock Text="{StaticResource Text.Recovery.NewPassword}" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Login.PasswordPlaceholder}" MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                             Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{StaticResource Text.Recovery.ConfirmPassword}" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Login.PasswordPlaceholder}" MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                             Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <InfoBar Severity="Error" Margin="0,16,0,0" Title="{StaticResource Text.Login.ErrorTitle}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"/>

        <Button Style="{StaticResource LoginButton}" Margin="0,24,0,0" Content="{x:Bind ViewModel.ButtonText, Mode=OneWay}"
                Command="{x:Bind ViewModel.SubmitCommand}"/>

        <Button Style="{StaticResource LoginLinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0"
                Content="{StaticResource Text.Recovery.Back}" Command="{x:Bind ViewModel.BackCommand}"/>
    </StackPanel>
</UserControl>
