<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del manual, debajo de todo: azul noche opaco y un barrido tenue de arriba abajo (solo traslación, corre en el compositor) -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Manual.FondoManual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Views/Estilos/ManualFondo.xaml"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource ManualBaseBrush}">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Y" From="-140" To="1200" Duration="0:0:14"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Rectangle Height="{StaticResource ManualSweepHeight}" VerticalAlignment="Top" Fill="{StaticResource ManualSweepBrush}">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Sweep" Y="-140"/>
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
