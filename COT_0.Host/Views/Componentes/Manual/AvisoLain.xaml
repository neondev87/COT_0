<?xml version="1.0" encoding="utf-8"?>
<!-- Notificación de Lain estilo celular (MENSAJES · ahora · Lain · texto). Aparece y se va con una transición de opacidad;
     sin la sombra (DropShadowEffect) ni escalado -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Manual.AvisoLain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" IsTabStop="False">
    <Border VerticalAlignment="Top" Padding="16,12,16,16" CornerRadius="24" Background="#242426" BorderBrush="#0DFFFFFF" BorderThickness="1"
            Opacity="{x:Bind Notice.Opacity, Mode=OneWay}">
        <Border.OpacityTransition>
            <ScalarTransition Duration="0:0:0.35"/>
        </Border.OpacityTransition>
        <StackPanel>
            <Grid Margin="0,0,0,9" ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#6EE066" Offset="0"/>
                            <GradientStop Color="#2CC24C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE8BD;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource WhiteBrush}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{StaticResource Text.Manual.NoticeApp}" VerticalAlignment="Center"
                           FontSize="12" CharacterSpacing="70" Foreground="#9B9BA1"/>
                <TextBlock Grid.Column="2" Text="{StaticResource Text.Manual.NoticeTime}" VerticalAlignment="Center"
                           FontSize="13" Foreground="#9B9BA1"/>
            </Grid>
            <TextBlock Text="{StaticResource Text.Manual.NoticeSender}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource WhiteBrush}"/>
            <TextBlock Text="{x:Bind Notice.Text, Mode=OneWay}" Margin="0,3,0,0" FontSize="15" TextWrapping="Wrap" Foreground="#F1F1F3"/>
        </StackPanel>
    </Border>
</UserControl>
