<?xml version="1.0" encoding="utf-8"?>
<!-- Resaltado del manual: borde rojo del proyecto y un halo que late suave (opacidad y escala, corren en el compositor).
     Se pone en la misma celda que el elemento, con margen negativo para que lo rodee -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Manual.ResaltadoManual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" IsTabStop="False">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HighlightFillBrush" Color="#14B3122E"/>
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:1.4"/>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.04" Duration="0:0:1.4"/>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.08" Duration="0:0:1.4"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root" Opacity="0">
        <Grid.OpacityTransition>
            <ScalarTransition Duration="0:0:0.3"/>
        </Grid.OpacityTransition>
        <Border x:Name="Halo" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HaloScale"/>
            </Border.RenderTransform>
        </Border>
        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" CornerRadius="8" Background="{StaticResource HighlightFillBrush}"/>
    </Grid>
</UserControl>
