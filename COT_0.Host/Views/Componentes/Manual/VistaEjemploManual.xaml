<?xml version="1.0" encoding="utf-8"?>
<!-- Escenario del manual: la vista de ejemplo del paso, dibujada al tamaño de la ventana real y escalada sin deformarse -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Manual.VistaEjemploManual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" IsTabStop="False">
    <Viewbox Stretch="Uniform">
        <Border x:Name="Stage" CornerRadius="8"/>
    </Viewbox>
</UserControl>
