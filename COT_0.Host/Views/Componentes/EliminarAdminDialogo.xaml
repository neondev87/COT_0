<?xml version="1.0" encoding="utf-8"?>
<!-- ELIMINAR ADMIN: pregunta secreta del admin que se va con su respuesta y la contraseña de quien elimina.
     Ambos campos ocultos; ELIMINAR solo se enciende con los dos llenos. Esc o CANCELAR cierran sin hacer nada -->
<ContentDialog x:Class="COT_0.Host.Views.Componentes.EliminarAdminDialogo"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:validaciones="using:COT_0.Host.Services.Validaciones"
               DefaultButton="None"
               CornerRadius="0"
               Background="{StaticResource WindowBackgroundBrush}"
               BorderBrush="{StaticResource PanelBorderBrush}"
               BorderThickness="1"
               PrimaryButtonText="{StaticResource Text.Admins.Delete}"
               CloseButtonText="{StaticResource Text.Admins.Cancel}"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
               PrimaryButtonStyle="{StaticResource ConfirmButton}"
               CloseButtonStyle="{StaticResource CancelButton}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">600</x:Double>
        <Thickness x:Key="ContentDialogPadding">48,44,48,40</Thickness>
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="WindowBackgroundBrush"/>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="DialogVeilBrush"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="10" Margin="0,0,0,24">
        <Rectangle Width="28" Height="1" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>
        <TextBlock Text="{x:Bind ViewModel.Title}" TextWrapping="Wrap" FontFamily="{StaticResource FontCondensedLight}"
                   FontSize="24" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{x:Bind ViewModel.Warning}" TextWrapping="WrapWholeWords" Style="{StaticResource InterText}"
                   Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8"/>

        <TextBlock Text="{x:Bind ViewModel.AnswerLabel}" Style="{StaticResource FieldLabelText}"/>
        <TextBlock Text="{x:Bind ViewModel.QuestionText}" TextWrapping="WrapWholeWords" Style="{StaticResource InterText}"/>
        <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Admins.DeleteDialog.AnswerPlaceholder}"
                     MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                     Password="{x:Bind ViewModel.TargetAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{StaticResource Text.Admins.DeleteDialog.PasswordLabel}" Style="{StaticResource FieldLabelText}" Margin="0,14,0,0"/>
        <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Admins.DeleteDialog.PasswordPlaceholder}"
                     MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                     Password="{x:Bind ViewModel.ActorPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
</ContentDialog>
