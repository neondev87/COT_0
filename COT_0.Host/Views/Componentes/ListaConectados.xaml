<?xml version="1.0" encoding="utf-8"?>
<!-- Lista de conectados: encabezado, el host fijo arriba y los invitados en un ListView (los de la sala, o los de muestra del manual) -->
<UserControl x:Class="COT_0.Host.Views.Componentes.ListaConectados"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="using:COT_0.Host.Views.Componentes"
    xmlns:convertidores="using:COT_0.Host.Views.Convertidores"
             xmlns:vm="using:COT_0.Host.Views.ModelosDeVista"
>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Padding="24,0,64,0" ColumnSpacing="16" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{StaticResource Text.Room.ColumnUser}" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{StaticResource Text.Room.ColumnConnected}" Style="{StaticResource ColumnHeaderText}"/>
            </Grid>

            <ListView x:Name="Guests" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.Resources>
                    <!-- Sin selección ni bordes de WinUI: solo el fondo tenue al pasar el mouse -->
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="RowHoverBrush"/>
                    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="RowHoverBrush"/>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- Host: siempre primero -->
                <ListView.Header>
                    <Grid Style="{StaticResource UserRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="44"/> <!-- mismo ancho que el botón ✕ de los invitados -->
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Avatar}" Background="{StaticResource AvatarTone0Brush}" BorderBrush="{StaticResource AccentBrush}">
                            <TextBlock Text="{StaticResource Text.Room.HostInitials}" Style="{StaticResource InitialsText}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource Text.Room.HostName}" Style="{StaticResource RowNameText}"/>
                            <TextBlock Text="{StaticResource Text.Room.HostRole}" Style="{StaticResource InterText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{StaticResource Text.Room.HostSince}" Style="{StaticResource RowSinceText}"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserRowViewModel">
                        <Grid Style="{StaticResource UserRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Avatar}" Background="{x:Bind convertidores:AvatarTones.For(Tone)}">
                                <TextBlock Text="{x:Bind Initials}" Style="{StaticResource InitialsText}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowNameText}"/>
                                <TextBlock Text="{StaticResource Text.Room.GuestRole}" Style="{StaticResource InterText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Since, Mode=OneWay}" Style="{StaticResource RowSinceText}"/>
                            <Button Grid.Column="3" Style="{StaticResource KickButton}" ToolTipService.ToolTip="{StaticResource Text.Room.Kick}"
                                    AutomationProperties.Name="{StaticResource Text.Room.Kick}"
                                    Click="OnKickClick"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
