<?xml version="1.0" encoding="utf-8"?>
<!-- Paso 5 del manual: versión simplificada de EMOTES (mismo panel que PanelEmotes, sin 7TV): set de muestra,
     reportes y quitados ficticios, con la inicial en lugar de la miniatura. Resaltados: set + APLICAR, REPORTES, QUITADOS -->
<componentes:VistaEjemplo x:Class="COT_0.Host.Views.Componentes.VistaEjemploEmotes"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:componentes="using:COT_0.Host.Views.Componentes"
                          xmlns:modelos="using:COT_0.Host.Models">

    <componentes:VistaEjemplo.Resources>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
        </Style>
        <Style x:Key="EmoteRow" TargetType="Grid">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="16,0,6,0"/>
            <Setter Property="ColumnSpacing" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource RowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- Recuadro con la inicial: la muestra no descarga miniaturas de 7TV -->
        <DataTemplate x:Key="EmoteBadge" x:DataType="modelos:ManualDemoRow">
            <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource AvatarTone2Brush}">
                <TextBlock Text="{x:Bind Initial}" Style="{StaticResource InitialsText}"/>
            </Border>
        </DataTemplate>
    </componentes:VistaEjemplo.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="64,52,64,48" HorizontalAlignment="Left" Width="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <componentes:EncabezadoEjemplo Title="{StaticResource Text.Emotes.ScreenTitle}"/>

            <Border Grid.Row="1" Margin="0,32,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <Grid>
                        <Grid Margin="16,12,16,14" ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{StaticResource Text.Emotes.Title}" Style="{StaticResource ColumnHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Demo.EmoteCountText}" Style="{StaticResource InterText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Style="{StaticResource LoginTextBox}" FontSize="13" Text="{x:Bind Demo.EmoteSet}"
                                     IsReadOnly="True" IsTabStop="False" VerticalAlignment="Stretch"/>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SolidButton}" Content="{StaticResource Text.Emotes.Apply}"
                                    MinWidth="132" Height="{StaticResource InputHeight}" IsTabStop="False"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Demo.EmoteStatusText}"
                                       FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold" FontSize="13" CharacterSpacing="200"
                                       Foreground="{x:Bind componentes:EmoteStatusBrushes.For(Demo.EmoteStatus)}"/>
                        </Grid>
                        <componentes:ResaltadoManual Margin="6" Phase="{x:Bind Phase, Mode=OneWay}" From="1" To="2"/>
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <Border Style="{StaticResource SectionHeader}">
                                <TextBlock Text="{StaticResource Text.Emotes.Reports}" Style="{StaticResource ColumnHeaderText}"/>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind Demo.Reports}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="modelos:ManualDemoRow">
                                        <Grid Style="{StaticResource EmoteRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource EmoteBadge}" IsTabStop="False"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowNameText}" FontSize="13"/>
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource InterText}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Emotes.Remove}" IsTabStop="False"/>
                                                <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Emotes.Ignore}" IsTabStop="False"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <componentes:ResaltadoManual Margin="4" Phase="{x:Bind Phase, Mode=OneWay}" From="3" To="4"/>
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <Border Style="{StaticResource SectionHeader}">
                                <TextBlock Text="{StaticResource Text.Emotes.Removed}" Style="{StaticResource ColumnHeaderText}"/>
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind Demo.Removed}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="modelos:ManualDemoRow">
                                        <Grid Style="{StaticResource EmoteRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource EmoteBadge}" IsTabStop="False"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowNameText}" FontSize="13"/>
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource InterText}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="{StaticResource Text.Emotes.Restore}" IsTabStop="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <componentes:ResaltadoManual Margin="4" Phase="{x:Bind Phase, Mode=OneWay}" From="5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</componentes:VistaEjemplo>
