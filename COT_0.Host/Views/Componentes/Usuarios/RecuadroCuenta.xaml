<?xml version="1.0" encoding="utf-8"?>
<!-- Recuadro sobre el velo para CAMBIAR NOMBRE (nombre nuevo) o CAMBIAR CONTRASEÑA (actual, nueva y repetirla) de tu cuenta -->
<UserControl x:Class="COT_0.Host.Views.Componentes.Usuarios.RecuadroCuenta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validaciones="using:COT_0.Host.Services.Validaciones">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Tienda.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Width="{StaticResource LoginFormWidth}" Spacing="20">
        <StackPanel Spacing="6">
            <Rectangle Width="28" Height="1" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>
            <TextBlock Text="{x:Bind Form.Title, Mode=OneWay}" Style="{StaticResource ShopTitleText}"/>
        </StackPanel>

        <StackPanel Visibility="{x:Bind Form.IsRename, Mode=OneWay}">
            <TextBlock Text="{StaticResource Text.Users.NewName}" Style="{StaticResource FieldLabelText}"/>
            <TextBox Style="{StaticResource UserNameTextBox}" MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                     Text="{x:Bind Form.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Spacing="20" Visibility="{x:Bind Form.IsPassword, Mode=OneWay}">
            <StackPanel>
                <TextBlock Text="{StaticResource Text.Users.CurrentPassword}" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Login.PasswordPlaceholder}"
                             MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                             Password="{x:Bind Form.CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{StaticResource Text.Users.NewPassword}" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Login.PasswordPlaceholder}"
                             MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                             Password="{x:Bind Form.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{StaticResource Text.Recovery.ConfirmPassword}" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Login.PasswordPlaceholder}"
                             MaxLength="{x:Bind validaciones:InputLimits.MaxCharacters}"
                             Password="{x:Bind Form.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <InfoBar Severity="Error" Title="{StaticResource Text.Login.ErrorTitle}" Message="{x:Bind Form.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind Form.IsErrorOpen, Mode=TwoWay}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
            <Button Style="{StaticResource TextButton}" Content="{StaticResource Text.Admins.Cancel}" Command="{x:Bind CloseCommand, Mode=OneWay}"/>
            <Button Style="{StaticResource SolidButton}" Content="{StaticResource Text.Users.Save}" Command="{x:Bind Form.SubmitCommand, Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
