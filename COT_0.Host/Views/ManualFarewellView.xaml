<UserControl x:Class="COT_0.Host.Views.ManualFarewellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls"
             FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <!-- Despedida: Lain en un tubo de TV a casi toda la pantalla (DataContext: ManualViewModel) -->
    <Grid x:Name="Root" Margin="40,56,40,32" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tubo: video, scanlines, viñeta, barrido y bordes que se funden con el fondo -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" OpacityMask="{StaticResource TubeEdgeMask}" ClipToBounds="True">
            <controls:LoopingVideo Source="{Binding FarewellVideo}" Stretch="Uniform"/>
            <Rectangle Fill="{StaticResource TubeScanlineBrush}"/>
            <Rectangle Fill="{StaticResource TubeVignetteBrush}"/>
            <Rectangle Height="120" VerticalAlignment="Top" Fill="{StaticResource SweepBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="Sweep"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,22,0,0" Text="{DynamicResource Text.Manual.Farewell}" Style="{StaticResource ManualStepTitleText}"/>
        <Button x:Name="CloseButton" Grid.Row="2" Margin="0,22,0,0" Style="{StaticResource ManualSmallButton}"
                Content="{DynamicResource Text.Manual.Close}" Command="{Binding CloseCommand}"/>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2"
                                     Duration="{StaticResource NoticeInDuration}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" BeginTime="0:0:0.2" Duration="{StaticResource NoticeInDuration}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" BeginTime="0:0:0.2" Duration="{StaticResource NoticeInDuration}"/>
                    <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Y" From="-140" To="900"
                                     Duration="{StaticResource SweepDuration}" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
