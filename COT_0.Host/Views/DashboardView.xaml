<UserControl x:Class="COT_0.Host.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls">
    <!-- Dashboard (DataContext: DashboardViewModel) -->
    <Grid>
        <!-- Reloj -->
        <StackPanel Margin="44,34,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    controls:EntryAnimation.Duration="{StaticResource ClockFadeDuration}" controls:EntryAnimation.Ease="{StaticResource EaseInOut}">
            <StackPanel Orientation="Horizontal">
                <controls:SpacedText Text="{Binding Time}" FontFamily="{StaticResource FontCondensedExtraLight}" FontSize="164"
                                     LineHeight="150.88" Spacing="-0.01" Foreground="{StaticResource Text62Brush}"/>
                <TextBlock Text="{Binding Seconds}" Margin="10,18,0,0" VerticalAlignment="Top"
                           FontFamily="{StaticResource FontCondensedLight}" FontSize="30" Foreground="{StaticResource Text40Brush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="6,6,0,0">
                <Rectangle Width="28" Height="1" Fill="{StaticResource AccentBrush}" Opacity="0.8" VerticalAlignment="Center"/>
                <controls:SpacedText Text="{Binding Date}" Margin="12,0,0,0" FontFamily="{StaticResource FontCondensedMedium}"
                                     FontSize="16" Spacing="0.32" Foreground="{StaticResource Text58Brush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Estado de la sala -->
        <StackPanel Margin="0,56,48,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    controls:EntryAnimation.Duration="{StaticResource StatusFadeDuration}" controls:EntryAnimation.Ease="{StaticResource EaseInOut}">
            <controls:SpacedText Text="{DynamicResource Text.Dashboard.Status}" HorizontalAlignment="Right" FontFamily="{StaticResource FontCondensedMedium}"
                                 FontSize="12" Spacing="0.4" Foreground="{StaticResource Text55Brush}"/>
            <Button Style="{StaticResource PlainButton}" Command="{Binding ShowRoomCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Visibility="{Binding IsRoomActive, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource PulseDot}" VerticalAlignment="Center"/>
                    <controls:SpacedText Text="{DynamicResource Text.Dashboard.Active}" Margin="12,0" Style="{StaticResource BoldCondensedText}"
                                         FontSize="22" Spacing="0.14" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding ConnectedText}" VerticalAlignment="Center" FontFamily="{StaticResource FontCondensedLight}"
                               FontSize="22" Foreground="{StaticResource Text70Brush}"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Style="{StaticResource InactiveStatus}">
                <Ellipse Width="{StaticResource PulseDotSize}" Height="{StaticResource PulseDotSize}" Stroke="{StaticResource Text55Brush}"
                         StrokeThickness="1" VerticalAlignment="Center"/>
                <controls:SpacedText Text="{DynamicResource Text.Dashboard.Inactive}" Margin="12,0,0,0" Style="{StaticResource BoldCondensedText}"
                                     FontSize="22" Spacing="0.14" Foreground="{StaticResource Text70Brush}"/>
            </StackPanel>
            <Rectangle Width="180" Height="1" Margin="0,10,0,0" HorizontalAlignment="Right" Fill="{StaticResource AccentFadeInBrush}"/>
        </StackPanel>

        <!-- Menú en diagonal -->
        <StackPanel Margin="44,0,0,38" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Border Style="{StaticResource MenuCardSlot}" controls:EntryAnimation.Delay="{StaticResource Delay015}">
                <controls:MenuCard Number="01" Title="{Binding QrTitle}" Subtitle="{Binding QrSubtitle}"
                                   Icon="{StaticResource IconQr}" Command="{Binding GenerateQrCommand}"/>
            </Border>
            <Border Style="{StaticResource MenuCardSlot}" Margin="26,8,0,0" controls:EntryAnimation.Delay="{StaticResource Delay027}">
                <controls:MenuCard Number="02" Title="{DynamicResource Text.Dashboard.BackgroundTitle}" Subtitle="{DynamicResource Text.Dashboard.BackgroundSubtitle}"
                                   Icon="{StaticResource IconWallpaper}" Command="{Binding Picker.OpenCommand}"/>
            </Border>
            <Border Style="{StaticResource MenuCardSlot}" Margin="52,8,0,0" controls:EntryAnimation.Delay="{StaticResource Delay039}">
                <controls:MenuCard Number="03" Title="{DynamicResource Text.Dashboard.ManualTitle}" Subtitle="{DynamicResource Text.Dashboard.ManualSubtitle}"
                                   Icon="{StaticResource IconManual}" Command="{Binding ShowManualCommand}"/>
            </Border>
            <Border Style="{StaticResource MenuCardSlot}" Margin="78,8,0,0" controls:EntryAnimation.Delay="{StaticResource Delay051}">
                <controls:MenuCard Number="04" Title="{DynamicResource Text.Dashboard.ExitTitle}" Subtitle="{DynamicResource Text.Dashboard.ExitSubtitle}"
                                   Icon="{StaticResource IconExit}" Command="{Binding LogoutCommand}"/>
            </Border>
        </StackPanel>

        <!-- Pie -->
        <StackPanel Orientation="Horizontal" Margin="0,0,48,34" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <controls:SpacedText Text="{DynamicResource Text.Dashboard.Footer}" Style="{StaticResource FooterText}" Foreground="{StaticResource Text55Brush}"/>
            <Rectangle Style="{StaticResource Diamond}"/>
            <controls:SpacedText Text="{DynamicResource Text.App.Version}" Style="{StaticResource FooterText}" Foreground="{StaticResource Text55Brush}"/>
        </StackPanel>

        <!-- Firma con música, sobre el pie -->
        <controls:SignatureBadge DataContext="{Binding Signature}" Margin="0,0,48,76"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
