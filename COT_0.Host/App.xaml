<?xml version="1.0" encoding="utf-8"?>
<!-- Recursos de toda la app: paleta de COT_0, fuentes, textos y estilos -->
<Application x:Class="COT_0.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="using:COT_0.Host.Views.Componentes"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Textos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Botones sin estilo propio: sin el letrero automático de sus atajos (ver Services/Ventana/ShortcutHints) -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden"/>
            </Style>

            <!-- Paleta base -->
            <Color x:Key="AccentColor">#B3122E</Color>
            <Color x:Key="TransparentAccentColor">#00B3122E</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#A5290B11"/>
            <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="LightBrush" Color="#E6E6E6"/>
            <SolidColorBrush x:Key="Light65Brush" Color="#A6E6E6E6"/>
            <SolidColorBrush x:Key="Light62Brush" Color="#9EE6E6E6"/>
            <SolidColorBrush x:Key="Light55Brush" Color="#8CE6E6E6"/>
            <SolidColorBrush x:Key="Light50Brush" Color="#80E6E6E6"/>
            <SolidColorBrush x:Key="Light40Brush" Color="#66E6E6E6"/>
            <SolidColorBrush x:Key="Light28Brush" Color="#47E6E6E6"/>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D0D0E"/>
            <SolidColorBrush x:Key="LoginBaseBrush" Color="#080808"/>
            <SolidColorBrush x:Key="InputBrush" Color="#09FFFFFF"/>
            <SolidColorBrush x:Key="InputFocusBrush" Color="#0EFFFFFF"/>
            <SolidColorBrush x:Key="ButtonBrush" Color="#8C0A0A0A"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EB3122E"/>
            <SolidColorBrush x:Key="TextBrush" Color="#ECEAF0"/>
            <SolidColorBrush x:Key="Text62Brush" Color="#9EECEAF0"/>
            <SolidColorBrush x:Key="Light60Brush" Color="#99E6E6E6"/>
            <SolidColorBrush x:Key="Text70Brush" Color="#B3ECEAF0"/>
            <SolidColorBrush x:Key="Text58Brush" Color="#94ECEAF0"/>
            <SolidColorBrush x:Key="Text55Brush" Color="#8CECEAF0"/>
            <SolidColorBrush x:Key="Text40Brush" Color="#66ECEAF0"/>

            <!-- Tarjetas del menú del dashboard -->
            <SolidColorBrush x:Key="CardFaceBrush" Color="#ECEAF0"/>
            <SolidColorBrush x:Key="DarkInkBrush" Color="#15121B"/>
            <SolidColorBrush x:Key="CardSubBrush" Color="#55505E"/>
            <SolidColorBrush x:Key="WhiteSubBrush" Color="#E0FFFFFF"/>

            <!-- Paneles, filas y avatares de la sala -->
            <SolidColorBrush x:Key="PanelBrush" Color="#05FFFFFF"/>
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="RowBorderBrush" Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="#06FFFFFF"/>
            <SolidColorBrush x:Key="AvatarBorderBrush" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="AvatarTone0Brush" Color="#2A2A2E"/>
            <SolidColorBrush x:Key="AvatarTone1Brush" Color="#26262A"/>
            <SolidColorBrush x:Key="AvatarTone2Brush" Color="#2E2E32"/>
            <SolidColorBrush x:Key="AvatarTone3Brush" Color="#232327"/>
            <SolidColorBrush x:Key="AvatarTone4Brush" Color="#2B2B2F"/>
            <SolidColorBrush x:Key="DialogVeilBrush" Color="#B3080809"/>

            <!-- Acento de Windows → rojo del proyecto: sin esto CheckBox, Slider y demás salen con el azul del sistema.
                 En tema oscuro el control rellena con Light2, por eso Light2 es el mismo rojo de la línea de acento -->
            <Color x:Key="SystemAccentColor">#B3122E</Color>
            <Color x:Key="SystemAccentColorLight1">#A51029</Color>
            <Color x:Key="SystemAccentColorLight2">#B3122E</Color>
            <Color x:Key="SystemAccentColorLight3">#C82A44</Color>
            <Color x:Key="SystemAccentColorDark1">#9A0F27</Color>
            <Color x:Key="SystemAccentColorDark2">#800C20</Color>
            <Color x:Key="SystemAccentColorDark3">#660A19</Color>
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#8E0E24"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="#C82A44"/>
            <!-- Mismos colores por llave de control (lightweight styling), por si el tema no toma el acento de arriba -->
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush"/>
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentLightBrush"/>
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentPressedBrush"/>
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="AccentBrush"/>
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="AccentLightBrush"/>
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="AccentPressedBrush"/>
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="WhiteBrush"/>
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="WhiteBrush"/>
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="WhiteBrush"/>
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush"/>
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentLightBrush"/>
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentPressedBrush"/>
            <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush"/>
            <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentLightBrush"/>
            <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentPressedBrush"/>

            <LinearGradientBrush x:Key="AccentFadeInBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource TransparentAccentColor}" Offset="0"/>
                <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentFadeOutBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                <GradientStop Color="{StaticResource TransparentAccentColor}" Offset="1"/>
            </LinearGradientBrush>

            <!-- Fondo del login: degradado, placa detrás del formulario, viñeta, niebla y barrido -->
            <RadialGradientBrush x:Key="LoginBackgroundBrush" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.8" RadiusY="0.75">
                <GradientStop Color="#1B1B1C" Offset="0"/>
                <GradientStop Color="#0F0F10" Offset="0.52"/>
                <GradientStop Color="#070707" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="LoginShadeBrush" Color="#59060606"/>
            <RadialGradientBrush x:Key="LoginPlateBrush" RadiusX="0.34" RadiusY="0.52">
                <GradientStop Color="#D1060606" Offset="0"/>
                <GradientStop Color="#8C060606" Offset="0.55"/>
                <GradientStop Color="#00060606" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="VignetteBrush" RadiusX="0.75" RadiusY="0.75">
                <GradientStop Color="#00000000" Offset="0.4"/>
                <GradientStop Color="#CC000000" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FogABrush">
                <GradientStop Color="#17787879" Offset="0"/>
                <GradientStop Color="#00787879" Offset="0.7"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FogBBrush">
                <GradientStop Color="#14646466" Offset="0"/>
                <GradientStop Color="#00646466" Offset="0.7"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00FFFFFF" Offset="0"/>
                <GradientStop Color="#04FFFFFF" Offset="0.5"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <!-- Fuentes (TTF en Assets/Fuentes) -->
            <FontFamily x:Key="FontBarlow">ms-appx:///Assets/Fuentes/Barlow-400.ttf#Barlow</FontFamily>
            <FontFamily x:Key="FontBarlowMedium">ms-appx:///Assets/Fuentes/Barlow-500.ttf#Barlow Medium</FontFamily>
            <FontFamily x:Key="FontCondensedMedium">ms-appx:///Assets/Fuentes/BarlowCondensed-500.ttf#Barlow Condensed Medium</FontFamily>
            <FontFamily x:Key="FontCinzel">ms-appx:///Assets/Fuentes/Cinzel-700.ttf#Cinzel</FontFamily>
            <FontFamily x:Key="FontCondensedLight">ms-appx:///Assets/Fuentes/BarlowCondensed-300.ttf#Barlow Condensed Light</FontFamily>
            <FontFamily x:Key="FontCondensedBold">ms-appx:///Assets/Fuentes/BarlowCondensed-700.ttf#Barlow Condensed</FontFamily>
            <FontFamily x:Key="FontCondensedExtraLight">ms-appx:///Assets/Fuentes/BarlowCondensed-200.ttf#Barlow Condensed ExtraLight</FontFamily>
            <FontFamily x:Key="FontRedaction">ms-appx:///Assets/Fuentes/Redaction50-400.ttf#Redaction 50</FontFamily>
            <FontFamily x:Key="FontCondensedExtraBold">ms-appx:///Assets/Fuentes/BarlowCondensed-800Italic.ttf#Barlow Condensed ExtraBold</FontFamily>
            <FontFamily x:Key="FontInter">ms-appx:///Assets/Fuentes/Inter-400.ttf#Inter</FontFamily>
            <FontFamily x:Key="FontInterMedium">ms-appx:///Assets/Fuentes/Inter-500.ttf#Inter</FontFamily>

            <!-- Medidas de la sala -->
            <x:Double x:Key="UserRowHeight">62</x:Double>
            <x:Double x:Key="AvatarSize">36</x:Double>
            <x:Double x:Key="MinHitSize">44</x:Double>
            <x:Double x:Key="RoomFieldHeight">48</x:Double>

            <!-- Medidas del login -->
            <x:Double x:Key="LoginFormWidth">360</x:Double>
            <x:Double x:Key="LoginSubtitleMaxWidth">272</x:Double>
            <x:Double x:Key="InputHeight">46</x:Double>
            <x:Double x:Key="ButtonHeight">48</x:Double>
            <x:Double x:Key="LoginImageOpacity">0.375</x:Double>

            <!-- Campos de texto: fondo tenue y línea inferior que pasa al acento con el foco -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="InputBrush"/>
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InputBrush"/>
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InputFocusBrush"/>
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Light28Brush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush"/>
            <StaticResource x:Key="TextControlForeground" ResourceKey="LightBrush"/>
            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="LightBrush"/>
            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="LightBrush"/>
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="AccentBrush"/>
            <Thickness x:Key="TextControlBorderThemeThickness">0,0,0,1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,1</Thickness>

            <Style x:Key="LoginFieldStyle" TargetType="Control">
                <Setter Property="Height" Value="{StaticResource InputHeight}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontBarlow}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="14,12,14,0"/>
                <!-- Filtro al escribir o pegar (Views/Componentes/FiltroCampo): letras y números; contraseña con símbolos -->
                <Setter Property="componentes:FiltroCampo.IsEnabled" Value="True"/>
            </Style>
            <Style x:Key="LoginTextBox" TargetType="TextBox" BasedOn="{StaticResource LoginFieldStyle}"/>
            <!-- Usuario: solo letras, primera mayúscula y resto minúscula al escribir -->
            <Style x:Key="UserNameTextBox" TargetType="TextBox" BasedOn="{StaticResource LoginTextBox}">
                <Setter Property="componentes:FiltroCampo.IsUserName" Value="True"/>
            </Style>
            <Style x:Key="LoginPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource LoginFieldStyle}">
                <Setter Property="PasswordRevealMode" Value="Hidden"/>
            </Style>

            <Style x:Key="LoginComboBox" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Height" Value="{StaticResource InputHeight}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="FontFamily" Value="{StaticResource FontBarlow}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Background" Value="{StaticResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light28Brush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
            </Style>

            <!-- Enlace del login ("¿Olvidaste tu contraseña?", "Volver"): solo texto que se aclara con el mouse -->
            <!-- Barra vertical sutil entre los enlaces del login -->
            <Style x:Key="LoginLinkSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{StaticResource Light55Brush}"/>
                <Setter Property="Opacity" Value="0.5"/>
            </Style>

            <Style x:Key="LoginLinkButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Padding" Value="0,8"/>
                <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{StaticResource FontBarlow}" FontSize="13"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground" Value="{StaticResource AccentBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Textos con espaciado (CharacterSpacing va en milésimas de em) -->
            <Style x:Key="LoginTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontCinzel}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="76"/>
                <Setter Property="LineHeight" Value="76"/>
                <Setter Property="CharacterSpacing" Value="80"/>
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
            </Style>
            <Style x:Key="FieldLabelText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CharacterSpacing" Value="320"/>
                <Setter Property="Foreground" Value="{StaticResource Light65Brush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="FooterText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CharacterSpacing" Value="300"/>
                <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ENTRAR: borde claro; con el mouse encima aparece la capa de acento y la flecha avanza 4 px -->
            <Style x:Key="LoginButton" TargetType="Button">
                <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <Border Background="{StaticResource ButtonBrush}" BorderBrush="{StaticResource Light50Brush}" BorderThickness="1" CornerRadius="2"/>
                                <Border x:Name="Hover" Background="{StaticResource AccentHoverBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="2" Opacity="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{StaticResource FontBarlowMedium}" FontSize="14" CharacterSpacing="280"
                                               VerticalAlignment="Center"/>
                                    <Path x:Name="Arrow" Data="M4,12 H19 M14,7 L19,12 L14,17" Width="20" Height="20" Margin="14,0,0,0"
                                          Stretch="None" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                        <Path.RenderTransform>
                                            <TranslateTransform x:Name="ArrowShift"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.3"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="ArrowShift.X" Value="4"/>
                                                <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                                <Setter Target="Arrow.Stroke" Value="{StaticResource WhiteBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="ArrowShift.X" Value="4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.6"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Confirmar (CERRAR SALA, etc.): relleno tenue de acento; con el mouse, acento sólido y se corre 6 px -->
            <Style x:Key="ConfirmButton" TargetType="Button">
                <Setter Property="Height" Value="{StaticResource RoomFieldHeight}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="14,0,0,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="Shift"/>
                                </Grid.RenderTransform>
                                <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>
                                <Border x:Name="Hover" Background="{StaticResource AccentBrush}" Opacity="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="Icon" Data="M12,3 V12 M6.3,6.3 A8,8 0 1 0 17.7,6.3" Width="24" Height="24" Stretch="None"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontCondensedBold}"
                                               FontWeight="Bold" FontSize="17" CharacterSpacing="200"/>
                                </StackPanel>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.3"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="Shift.X" Value="-6"/>
                                                <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                                <Setter Target="Icon.Stroke" Value="{StaticResource WhiteBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.6"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- CANCELAR: solo texto; con el mouse se pone blanco y se corre 4 px a la izquierda -->
            <Style x:Key="CancelButton" TargetType="Button">
                <Setter Property="Height" Value="{StaticResource RoomFieldHeight}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Foreground" Value="{StaticResource Text62Brush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource FontCondensedBold}"
                                           FontWeight="Bold" FontSize="17" CharacterSpacing="200">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="Shift"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.3"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                                <Setter Target="Shift.X" Value="-4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed"/>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Expulsar: icono ✕ que se pone del color de acento con el mouse -->
            <Style x:Key="KickButton" TargetType="Button">
                <Setter Property="Width" Value="{StaticResource MinHitSize}"/>
                <Setter Property="Height" Value="{StaticResource MinHitSize}"/>
                <Setter Property="Foreground" Value="{StaticResource Light50Brush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path x:Name="Icon" Data="M7,7 L17,17 M17,7 L7,17" Width="24" Height="24" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="0.67" ScaleY="0.67"/>
                                    </Path.RenderTransform>
                                </Path>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Icon.Stroke" Value="{StaticResource AccentBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Icon.Stroke" Value="{StaticResource AccentBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón de solo texto (INICIO, QUITAR, IGNORAR, RESTAURAR, controles de música):
                 se aclara con el mouse y se corre 4 px a la izquierda -->
            <Style x:Key="TextButton" TargetType="Button">
                <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden"/>
                <Setter Property="MinHeight" Value="{StaticResource MinHitSize}"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Foreground" Value="{StaticResource Text62Brush}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontCondensedBold}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CharacterSpacing" Value="200"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Content" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="Shift"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.2"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{StaticResource WhiteBrush}"/>
                                                <Setter Target="Shift.X" Value="-4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{StaticResource AccentBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- APLICAR: bloque claro como las tarjetas del menú; con el mouse pasa al acento -->
            <Style x:Key="SolidButton" TargetType="Button">
                <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden"/>
                <Setter Property="Height" Value="{StaticResource InputHeight}"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Foreground" Value="{StaticResource DarkInkBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{StaticResource CardFaceBrush}" Padding="{TemplateBinding Padding}">
                                <Border x:Name="Hover" Background="{StaticResource AccentBrush}" Opacity="0" Margin="-16,0"/>
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold" FontSize="15" CharacterSpacing="300"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.2"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.5"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filas de ListView sin selección ni bordes del sistema -->
            <Style x:Key="FlatListItem" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>

            <!-- Volumen: riel fino con el acento -->
            <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="Width" Value="130"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="StepFrequency" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="IsThumbToolTipEnabled" Value="False"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Style>

            <!-- Iconos de los botones: glifos de Segoe Fluent Icons (heredan el color del botón, sin Path ni sombras) -->
            <FontFamily x:Key="FontIcons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

            <!-- Textos de la lista de conectados -->
            <Style x:Key="ColumnHeaderText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontInterMedium}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="CharacterSpacing" Value="140"/>
                <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="InterText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
            </Style>
            <Style x:Key="RowNameText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontInterMedium}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="RowSinceText" TargetType="TextBlock" BasedOn="{StaticResource InterText}">
                <Setter Property="Margin" Value="16,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource Light60Brush}"/>
            </Style>
            <Style x:Key="InitialsText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontInterMedium}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Avatar" TargetType="Border">
                <Setter Property="Width" Value="{StaticResource AvatarSize}"/>
                <Setter Property="Height" Value="{StaticResource AvatarSize}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource AvatarBorderBrush}"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
            </Style>
            <Style x:Key="UserRow" TargetType="Grid">
                <Setter Property="Height" Value="{StaticResource UserRowHeight}"/>
                <Setter Property="Padding" Value="24,0,10,0"/>
                <Setter Property="BorderBrush" Value="{StaticResource RowBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- Rombo separador del pie -->
            <Style x:Key="Diamond" TargetType="Rectangle">
                <Setter Property="Width" Value="4"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Margin" Value="10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="45"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
