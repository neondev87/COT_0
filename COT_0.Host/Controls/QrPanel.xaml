<UserControl x:Class="COT_0.Host.Controls.QrPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls">
    <!-- QR real con el rombo "C0" encima + URL y botón copiar (DataContext: RoomViewModel) -->
    <StackPanel>
        <Grid x:Name="QrHost" Width="{StaticResource QrPanelSize}" Height="{StaticResource QrPanelSize}">
            <Grid.Effect>
                <DropShadowEffect Color="{StaticResource AccentGlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>
            </Grid.Effect>
            <Grid Background="{StaticResource CardFaceBrush}" Clip="{StaticResource QrPanelShape}">
                <Image Source="{Binding QrImage}" Width="{StaticResource QrSize}" Height="{StaticResource QrSize}"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <Border Width="66" Height="66" Background="{StaticResource DarkInkBrush}" BorderBrush="{StaticResource CardFaceBrush}"
                        BorderThickness="6" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.Room.QrMarkStart}" Style="{StaticResource QrMarkText}" Foreground="{StaticResource CardFaceBrush}"/>
                    <TextBlock Text="{DynamicResource Text.Room.QrMarkEnd}" Style="{StaticResource QrMarkText}" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>

                <controls:SpacedText Text="{DynamicResource Text.Room.Scan}" Margin="0,14,18,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     FontFamily="{StaticResource FontCondensedExtraBold}" FontWeight="ExtraBold" FontStyle="Italic"
                                     FontSize="13" Spacing="0.2" Foreground="{StaticResource AccentBrush}"/>
            </Grid>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Height="{StaticResource RoomFieldHeight}" Padding="16,0" Background="{StaticResource UrlFieldBrush}"
                    BorderBrush="{StaticResource Text25Brush}" BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Center">
                    <controls:SpacedText Text="{DynamicResource Text.Room.UrlLabel}" FontFamily="{StaticResource FontCondensedMedium}"
                                         FontSize="10" Spacing="0.32" Foreground="{StaticResource Text55Brush}"/>
                    <TextBlock Text="{Binding JoinUrl}" Margin="0,2,0,0" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource CopyButton}" Command="{Binding CopyCommand}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16">
                        <Path Style="{StaticResource CopyIconPath}"/>
                    </Viewbox>
                    <controls:SpacedText Margin="10,0,0,0" Style="{StaticResource CopyLabelText}" FontSize="16" Spacing="0.28"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <!-- Brillo del QR que respira cada 6s -->
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="QrHost" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                     To="34" Duration="{StaticResource QrGlowHalfDuration}" EasingFunction="{StaticResource SineInOut}"/>
                    <DoubleAnimation Storyboard.TargetName="QrHost" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                     To="0.45" Duration="{StaticResource QrGlowHalfDuration}" EasingFunction="{StaticResource SineInOut}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
