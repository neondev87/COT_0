<UserControl x:Class="COT_0.Host.Controls.LoginBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls"
             IsHitTestVisible="False" ClipToBounds="True">
    <!-- Fondo del login: imagen ASCII, niebla, ceniza, viñeta, scanlines y barrido -->
    <Grid Background="{StaticResource LoginBackgroundBrush}">
        <Image Source="/Assets/ascii-bg.png" Stretch="UniformToFill" Opacity="{StaticResource LoginImageOpacity}">
            <Image.RenderTransform>
                <TranslateTransform x:Name="Float"/>
            </Image.RenderTransform>
        </Image>

        <Rectangle Fill="{StaticResource LoginShadeBrush}"/>
        <Rectangle Fill="{StaticResource LoginPlateBrush}"/>

        <Canvas>
            <Ellipse Canvas.Left="-200" Canvas.Top="460" Width="1100" Height="380" Fill="{StaticResource FogABrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="30"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="FogA"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="420" Canvas.Top="460" Width="1100" Height="420" Fill="{StaticResource FogBBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="36"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="FogB"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <controls:AshLayer Count="30" Seed="11" MinOpacity="0.12" OpacityRange="0.25" ParticleBrush="{StaticResource AshBrush}"/>

        <Rectangle Fill="{StaticResource VignetteBrush}"/>
        <Rectangle Fill="{StaticResource ScanlineBrush}"/>
        <Rectangle Height="120" VerticalAlignment="Top" Fill="{StaticResource SweepBrush}">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Sweep"/>
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Float" Storyboard.TargetProperty="Y" From="0" To="-6"
                                     Duration="{StaticResource FloatHalfDuration}" AutoReverse="True" RepeatBehavior="Forever"
                                     EasingFunction="{StaticResource SineInOut}"/>
                    <DoubleAnimation Storyboard.TargetName="FogA" Storyboard.TargetProperty="X" From="-80" To="90"
                                     Duration="{StaticResource FogADuration}" AutoReverse="True" RepeatBehavior="Forever"
                                     EasingFunction="{StaticResource SineInOut}"/>
                    <DoubleAnimation Storyboard.TargetName="FogB" Storyboard.TargetProperty="X" From="70" To="-100"
                                     Duration="{StaticResource FogBDuration}" AutoReverse="True" RepeatBehavior="Forever"
                                     EasingFunction="{StaticResource SineInOut}"/>
                    <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Y" From="-140" To="860"
                                     Duration="{StaticResource SweepDuration}" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
