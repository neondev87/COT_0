<UserControl x:Class="COT_0.Host.Controls.EmotePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls">
    <!-- Bloque EMOTES: set de 7TV, reportes y quitados (DataContext: EmotesViewModel) -->
    <UserControl.Resources>
        <DataTemplate x:Key="EmoteRowContent">
            <DockPanel>
                <Image Source="{Binding Thumbnail}" Style="{StaticResource EmoteThumb}"/>
                <ContentPresenter DockPanel.Dock="Right" Content="{Binding}"
                                  ContentTemplate="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource InterText}" FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource LightBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource InterText}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ReportActions">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource RowDangerButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <controls:SpacedText Text="{DynamicResource Text.Emotes.Remove}" Style="{StaticResource RowButtonText}"/>
                </Button>
                <Button Style="{StaticResource RowTextButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <controls:SpacedText Text="{DynamicResource Text.Emotes.Ignore}" Style="{StaticResource RowButtonText}"/>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RemovedActions">
            <Button Style="{StaticResource RowTextButton}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <controls:SpacedText Text="{DynamicResource Text.Emotes.Restore}" Style="{StaticResource RowButtonText}"/>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="EmoteRowTemplate">
            <Border Style="{StaticResource EmoteRow}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource EmoteRowContent}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
            <!-- Set de 7TV -->
            <StackPanel DockPanel.Dock="Top" Margin="16,12,16,14">
                <Grid>
                    <controls:SpacedText Text="{DynamicResource Text.Emotes.Title}" Style="{StaticResource ColumnHeaderText}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource InterText}" HorizontalAlignment="Right"/>
                </Grid>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ApplyButton}" Command="{Binding ApplyCommand}">
                        <controls:SpacedText Text="{DynamicResource Text.Emotes.Apply}" Style="{StaticResource BoldCondensedText}" FontSize="15" Spacing="0.3"/>
                    </Button>
                    <TextBox Text="{Binding SetInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LoginTextBox}"
                             Tag="{DynamicResource Text.Emotes.Placeholder}" FontSize="13" Margin="0,0,8,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <controls:SpacedText Text="{Binding StatusText}" Style="{StaticResource EmoteStatusText}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <Border Style="{StaticResource EmoteSectionHeader}">
                        <controls:SpacedText Text="{DynamicResource Text.Emotes.Reports}" Style="{StaticResource ColumnHeaderText}"/>
                    </Border>
                    <ItemsControl x:Name="EmoteReports" ItemsSource="{Binding Reports}" Tag="{StaticResource ReportActions}"
                                  ItemTemplate="{StaticResource EmoteRowTemplate}" Focusable="False"/>
                    <TextBlock Text="{DynamicResource Text.Emotes.NoReports}" Tag="{Binding HasReports}" Style="{StaticResource EmptyListText}"/>

                    <Border Style="{StaticResource EmoteSectionHeader}">
                        <controls:SpacedText Text="{DynamicResource Text.Emotes.Removed}" Style="{StaticResource ColumnHeaderText}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Removed}" Tag="{StaticResource RemovedActions}"
                                  ItemTemplate="{StaticResource EmoteRowTemplate}" Focusable="False"/>
                    <TextBlock Text="{DynamicResource Text.Emotes.NoRemoved}" Tag="{Binding HasRemoved}" Style="{StaticResource EmptyListText}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
