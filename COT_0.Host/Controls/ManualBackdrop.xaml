<UserControl x:Class="COT_0.Host.Controls.ManualBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls"
             IsHitTestVisible="False" ClipToBounds="True">
    <!-- Fondo del manual, de abajo hacia arriba: azul noche, niebla, estática de TV, franjas de interferencia, línea y viñeta -->
    <UserControl.Resources>
        <Storyboard x:Key="Drift">
            <DoubleAnimation Storyboard.TargetName="Fog" Storyboard.TargetProperty="X" From="-77" To="77" Duration="{StaticResource ManualFogDuration}"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource SineInOut}"/>
            <DoubleAnimation Storyboard.TargetName="Fog" Storyboard.TargetProperty="Y" From="22" To="-29" Duration="{StaticResource ManualFogDuration}"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource SineInOut}"/>
            <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Y" From="-4" To="1200"
                             Duration="{StaticResource SignalLineDuration}" RepeatBehavior="Forever"/>
            <!-- Franjas: bajan a distinto ritmo, desfasadas -->
            <DoubleAnimation Storyboard.TargetName="Band1" Storyboard.TargetProperty="Y" From="-100" To="1200" Duration="0:0:8" BeginTime="0:0:0" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Band2" Storyboard.TargetProperty="Y" From="-100" To="1200" Duration="0:0:3.4" BeginTime="-0:0:1.5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Band3" Storyboard.TargetProperty="Y" From="-100" To="1200" Duration="0:0:5.4" BeginTime="-0:0:3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Band4" Storyboard.TargetProperty="Y" From="-100" To="1200" Duration="0:0:2.5" BeginTime="-0:0:0.7" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Band5" Storyboard.TargetProperty="Y" From="-100" To="1200" Duration="0:0:10.2" BeginTime="-0:0:6" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource ManualBaseBrush}" controls:Motion.Storyboard="{StaticResource Drift}">
        <Ellipse Margin="100,86" Fill="{StaticResource ManualFogBrush}">
            <Ellipse.Effect>
                <BlurEffect Radius="30"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Fog"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Estática: sube de intensidad al llegar a la despedida (DataContext: ManualViewModel) -->
        <controls:NoiseLayer Tint="{StaticResource ManualStaticColor}">
            <controls:NoiseLayer.Style>
                <Style TargetType="controls:NoiseLayer">
                    <Setter Property="Opacity" Value="{StaticResource ManualNoiseOpacity}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFarewell}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource FarewellNoiseOpacity}"
                                                         Duration="{StaticResource ManualFadeDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:NoiseLayer.Style>
        </controls:NoiseLayer>

        <!-- Franjas de interferencia (altura y opacidad del diseño); sin animaciones quedan fuera de la vista -->
        <Grid VerticalAlignment="Top">
            <Rectangle Height="70" Opacity="0.05" Fill="{StaticResource ManualBandBrush}" VerticalAlignment="Top">
                <Rectangle.RenderTransform><TranslateTransform x:Name="Band1" Y="-100"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Height="3" Opacity="0.18" Fill="{StaticResource ManualBandBrush}" VerticalAlignment="Top">
                <Rectangle.RenderTransform><TranslateTransform x:Name="Band2" Y="-100"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Height="12" Opacity="0.1" Fill="{StaticResource ManualBandBrush}" VerticalAlignment="Top">
                <Rectangle.RenderTransform><TranslateTransform x:Name="Band3" Y="-100"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Height="2" Opacity="0.22" Fill="{StaticResource ManualBandBrush}" VerticalAlignment="Top">
                <Rectangle.RenderTransform><TranslateTransform x:Name="Band4" Y="-100"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Height="36" Opacity="0.06" Fill="{StaticResource ManualBandBrush}" VerticalAlignment="Top">
                <Rectangle.RenderTransform><TranslateTransform x:Name="Band5" Y="-100"/></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource SignalLineBrush}">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Line" Y="-4"/>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Fill="{StaticResource VignetteBrush}"/>
    </Grid>
</UserControl>
