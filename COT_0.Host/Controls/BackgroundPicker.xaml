<UserControl x:Class="COT_0.Host.Controls.BackgroundPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls"
             xmlns:vm="clr-namespace:COT_0.Host.ViewModels">
    <!-- Selector "Elige un fondo" (DataContext: BackgroundPickerViewModel). Clic fuera o Esc cierra -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:GradientBackground}">
            <Rectangle Fill="{Binding Brush}"/>
        </DataTemplate>

        <!-- Miniatura de video: primer cuadro en pausa -->
        <DataTemplate DataType="{x:Type vm:VideoBackground}">
            <MediaElement Source="{Binding Source}" LoadedBehavior="Pause" ScrubbingEnabled="True" IsMuted="True" Stretch="UniformToFill"/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource PickerFadeDuration}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource PickerFadeDuration}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid Background="{StaticResource PickerVeilBrush}">
        <Grid.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding CloseCommand}"/>
        </Grid.InputBindings>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:SpacedText Text="{DynamicResource Text.Picker.Title}" HorizontalAlignment="Center" Style="{StaticResource BoldCondensedText}"
                                 FontSize="26" Spacing="0.3" Foreground="{StaticResource TextBrush}"/>
            <controls:SpacedText Text="{DynamicResource Text.Picker.Hint}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                 FontFamily="{StaticResource FontBarlow}" FontSize="12" Spacing="0.08" Foreground="{StaticResource Text60Brush}"/>

            <ScrollViewer Margin="0,44,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          MaxWidth="{StaticResource DesignWidth}" Focusable="False">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform Y="28"/>
                </ScrollViewer.RenderTransform>
                <!-- Las miniaturas suben 28px al abrir -->
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="{StaticResource ThumbDelay}">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" KeySpline="{StaticResource EaseOut}"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="28" Duration="{StaticResource PickerFadeDuration}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Options}" Margin="60,24,24,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Se solapan 60px como en el diseño -->
                            <Button Style="{StaticResource ThumbButton}" Margin="-60,0,0,0" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Grid>
                                    <ContentControl Content="{Binding}" Focusable="False"/>
                                    <controls:SpacedText Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         FontFamily="{StaticResource FontCondensedMedium}" FontSize="13" Spacing="0.3"
                                                         Foreground="{StaticResource Text65Brush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
