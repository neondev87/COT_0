<UserControl x:Class="COT_0.Host.Controls.SongPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource SongPickerRoot}">
    <!-- Selector de canciones (DataContext: SongPickerViewModel). Flechas + Enter o clic reproduce; Esc o clic fuera cierra -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <!-- Velo: clic fuera del panel cierra -->
        <Border Background="{StaticResource PickerVeilBrush}">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding CloseCommand}"/>
            </Border.InputBindings>
        </Border>

        <Border x:Name="SongPanel" Style="{StaticResource SongPanel}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                    <TranslateTransform Y="12"/>
                </TransformGroup>
            </Border.RenderTransform>
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="16,16,16,8" Style="{StaticResource LoginTextBox}"
                         Tag="{DynamicResource Text.Songs.Search}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Up" Command="{Binding PreviousCommand}"/>
                        <KeyBinding Key="Down" Command="{Binding NextCommand}"/>
                        <KeyBinding Key="Enter" Command="{Binding PlayCommand}"/>
                        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Text.Songs.Empty}" Margin="16,12,16,20"
                           FontFamily="{StaticResource FontBarlow}" FontSize="13" Foreground="{StaticResource Text55Brush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="List" Style="{StaticResource SongList}" Margin="0,0,0,8"
                         ItemsSource="{Binding Songs}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                  Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Portada cuadrada recortada sin deformar; sin portada queda el marcador -->
                                <Grid Width="{StaticResource SongCoverSize}" Height="{StaticResource SongCoverSize}">
                                    <Border CornerRadius="{StaticResource SongCoverRadius}" Background="{StaticResource SongCoverBrush}">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="{StaticResource IconNote}" Width="24" Height="24" StrokeThickness="1.2"
                                                  Stroke="{StaticResource Text40Brush}"/>
                                        </Viewbox>
                                    </Border>
                                    <Border CornerRadius="{StaticResource SongCoverRadius}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="14,0" Style="{StaticResource SongText}"
                                           TextTrimming="CharacterEllipsis" FontFamily="{StaticResource FontBarlowMedium}" FontSize="14"/>
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource SongText}"
                                           FontFamily="{StaticResource FontMono}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
