<UserControl x:Class="COT_0.Host.Controls.SignatureBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:COT_0.Host.Controls">
    <!-- Firma Neondev (DataContext: SignatureViewModel): link al repo + volumen que aparece con hover -->
    <StackPanel>
        <Button x:Name="Link" Style="{StaticResource PlainButton}" Command="{Binding OpenGitHubCommand}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="{StaticResource SignatureAvatarSize}" Height="{StaticResource SignatureAvatarSize}">
                    <Border CornerRadius="14" Background="{StaticResource SignatureAvatarBrush}"/>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/neondev-avatar.png" Stretch="UniformToFill" AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                    <!-- Brillo "aero" que cruza el avatar -->
                    <Border CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="Aero" X="-1"/>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                                <GradientStop Color="#4DFFFFFF" Offset="0.45"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="14" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource SignatureBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Link}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource SignatureBorderHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <controls:SpacedText Text="{DynamicResource Text.Signature.Name}" Margin="16,2,0,0" VerticalAlignment="Top"
                                     FontFamily="{StaticResource FontRedaction}" FontSize="36" LineHeight="36" Spacing="0.02">
                    <controls:SpacedText.Effect>
                        <DropShadowEffect Color="{StaticResource AccentGlowColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                    </controls:SpacedText.Effect>
                    <controls:SpacedText.Style>
                        <Style TargetType="controls:SpacedText">
                            <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Link}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.55" Duration="{StaticResource InputDuration}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="{StaticResource InputDuration}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:SpacedText.Style>
                </controls:SpacedText>
            </StackPanel>
        </Button>

        <!-- Nota siempre visible. Con música: barra de volumen con hover. Sin música: clic → "SUBIR MÚSICA" -->
        <Grid x:Name="VolumeHost" Margin="69,-35,0,-7" Height="{StaticResource MinHitSize}" HorizontalAlignment="Left" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PlainButton}" Command="{Binding ToggleUploadCommand}" Padding="12">
                <Viewbox Width="20" Height="20">
                    <Path Data="{StaticResource IconNote}" StrokeThickness="1.2" Width="24" Height="24"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource Light70Brush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=VolumeHost}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource WhiteBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Viewbox>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" RenderTransformOrigin="0,0.5">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource VolumeBarStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMusicAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.85"/>
                        <TranslateTransform X="-10"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <Slider Style="{StaticResource VolumeSlider}" Value="{Binding Volume}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}}" Margin="10,0,0,0" MinWidth="24" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontRedaction}" FontSize="13" Foreground="{StaticResource Light70Brush}"/>
            </StackPanel>
            <Button Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" Style="{StaticResource MusicUploadButton}"
                    Content="{DynamicResource Text.Music.Upload}" Command="{Binding UploadCommand}"/>
        </Grid>
    </StackPanel>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Aero" Storyboard.TargetProperty="X" From="-1" To="1"
                                     Duration="{StaticResource AeroHalfDuration}" AutoReverse="True" RepeatBehavior="Forever"
                                     EasingFunction="{StaticResource SineInOut}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
