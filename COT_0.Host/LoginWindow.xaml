<Window x:Class="COT_0.Host.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COT_0 · Login" Height="480" Width="420" ResizeMode="NoResize"
        Style="{StaticResource NeonWindow}" WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=UserBox}">
    <Grid Margin="30">
        <Border Style="{StaticResource NeonPanel}" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="COT_0" Style="{StaticResource GlowTitle}"/>
                <TextBlock Text="// acceso del host" Style="{StaticResource Subtitle}" Margin="0,4,0,10"/>

                <TextBlock Text="USUARIO" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UserBox"/>

                <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource PinkBrush}" FontFamily="Consolas"
                           Margin="0,12,0,0" MinHeight="16" TextWrapping="Wrap"/>

                <Button x:Name="LoginButton" Content="ENTRAR" Style="{StaticResource NeonButton}"
                        IsDefault="True" Margin="0,14,0,0" Click="OnLoginClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
