<controls:ChromeWindow x:Class="COT_0.Host.LoginWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:COT_0.Host.Controls"
                       Title="{DynamicResource Text.App.Name}" Width="{StaticResource DesignWidth}" Height="{StaticResource DesignHeight}"
                       ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="{StaticResource LoginBaseBrush}"
                       FocusManager.FocusedElement="{Binding ElementName=UserBox}">
    <Grid>
        <controls:LoginBackdrop/>
        <controls:CaptionBar ShowMaximize="False"/>

        <controls:SignatureBadge DataContext="{Binding Signature}" Margin="0,44,32,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"/>

        <!-- Formulario centrado -->
        <StackPanel Width="{StaticResource LoginFormWidth}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="0,0,0,44" controls:EntryAnimation.OffsetY="18"
                        controls:EntryAnimation.Ease="{StaticResource EaseOut}" controls:EntryAnimation.Duration="{StaticResource RiseDuration}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:SpacedText Text="{DynamicResource Text.Login.TitleStart}" Style="{StaticResource LoginTitleText}"/>
                    <controls:SpacedText x:Name="TitleCursor" Text="{DynamicResource Text.Login.TitleCursor}" Style="{StaticResource LoginTitleText}"
                                         Foreground="{StaticResource AccentBrush}"/>
                    <controls:SpacedText Text="{DynamicResource Text.Login.TitleEnd}" Style="{StaticResource LoginTitleText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Rectangle Width="34" Height="1" Fill="{StaticResource AccentFadeInBrush}" VerticalAlignment="Center"/>
                    <controls:SpacedText Text="{DynamicResource Text.Login.Subtitle}" Margin="14,0" VerticalAlignment="Center"
                                         FontFamily="{StaticResource FontCondensedMedium}" FontSize="13" Spacing="0.5"
                                         Foreground="{StaticResource Light62Brush}"/>
                    <Rectangle Width="34" Height="1" Fill="{StaticResource AccentFadeOutBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,0,22" controls:EntryAnimation.OffsetY="18" controls:EntryAnimation.Delay="{StaticResource Delay015}"
                        controls:EntryAnimation.Ease="{StaticResource EaseOut}" controls:EntryAnimation.Duration="{StaticResource RiseDuration}">
                <controls:SpacedText Text="{DynamicResource Text.Login.User}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,8"/>
                <TextBox x:Name="UserBox" Style="{StaticResource LoginTextBox}" Tag="{DynamicResource Text.Login.UserPlaceholder}"
                         Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel controls:EntryAnimation.OffsetY="18" controls:EntryAnimation.Delay="{StaticResource Delay025}"
                        controls:EntryAnimation.Ease="{StaticResource EaseOut}" controls:EntryAnimation.Duration="{StaticResource RiseDuration}">
                <controls:SpacedText Text="{DynamicResource Text.Login.Password}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,8"/>
                <PasswordBox Style="{StaticResource LoginPasswordBox}" Tag="{DynamicResource Text.Login.PasswordPlaceholder}"
                             controls:PasswordAssist.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Error de login (ocupa el espacio de 36px entre campos y botón) -->
            <TextBlock Text="{Binding Error}" Height="36" Padding="0,10,0,0" FontSize="13"
                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>

            <Button Content="{DynamicResource Text.Login.Enter}" Style="{StaticResource LoginButton}" IsDefault="True"
                    Command="{Binding LoginCommand}" controls:EntryAnimation.OffsetY="18" controls:EntryAnimation.Delay="{StaticResource Delay035}"
                    controls:EntryAnimation.Ease="{StaticResource EaseOut}" controls:EntryAnimation.Duration="{StaticResource RiseDuration}"/>
        </StackPanel>

        <!-- Pie -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30">
            <controls:SpacedText Text="{DynamicResource Text.Login.Footer}" Style="{StaticResource FooterText}" Foreground="{StaticResource Light55Brush}"/>
            <Rectangle Style="{StaticResource Diamond}"/>
            <controls:SpacedText Text="{DynamicResource Text.App.Version}" Style="{StaticResource FooterText}" Foreground="{StaticResource Light55Brush}"/>
        </StackPanel>
    </Grid>

    <controls:ChromeWindow.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <!-- Cursor "_" parpadeando (steps) -->
                <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleCursor" Storyboard.TargetProperty="Opacity"
                                                   Duration="{StaticResource BlinkDuration}" RepeatBehavior="Forever">
                        <DiscreteDoubleKeyFrame KeyTime="0%" Value="1"/>
                        <DiscreteDoubleKeyFrame KeyTime="50%" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </controls:ChromeWindow.Triggers>
</controls:ChromeWindow>
