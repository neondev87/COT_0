<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:COT_0.Host.Controls">

    <!-- Estilos de texto repetidos (Barlow Condensed 400 del diseño cae en el peso 500 cargado) -->
    <Style x:Key="FieldLabelText" TargetType="controls:SpacedText">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Spacing" Value="0.32"/>
        <Setter Property="Foreground" Value="{StaticResource Light65Brush}"/>
    </Style>

    <Style x:Key="LoginTitleText" TargetType="controls:SpacedText">
        <Setter Property="FontFamily" Value="{StaticResource FontCinzel}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="76"/>
        <Setter Property="LineHeight" Value="76"/>
        <Setter Property="Spacing" Value="0.08"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
    </Style>

    <Style x:Key="FooterText" TargetType="controls:SpacedText">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Spacing" Value="0.3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ColumnHeaderText" TargetType="controls:SpacedText">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Spacing" Value="0.14"/>
        <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BoldCondensedText" TargetType="controls:SpacedText">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensed}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InterText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
