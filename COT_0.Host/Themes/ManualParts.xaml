<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:COT_0.Host.Controls">

    <!-- Tubo de la despedida: scanlines marcadas, viñeta y bordes que se funden -->
    <DrawingBrush x:Key="TubeScanlineBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H3 V3 H0 Z"/>
                <GeometryDrawing Brush="#59000000" Geometry="M0,0 H3 V1 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <RadialGradientBrush x:Key="TubeVignetteBrush" RadiusX="0.62" RadiusY="0.62">
        <GradientStop Color="#00000000" Offset="0.5"/>
        <GradientStop Color="#E6000000" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="TubeEdgeMask" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#FF000000" Offset="0.64"/>
        <GradientStop Color="#00000000" Offset="0.86"/>
    </RadialGradientBrush>

    <!-- Video de Lain: el fondo negro se funde con la pantalla, sin marco -->
    <RadialGradientBrush x:Key="LainEdgeMask">
        <GradientStop Color="#FF000000" Offset="0.3"/>
        <GradientStop Color="#B3000000" Offset="0.6"/>
        <GradientStop Color="#40000000" Offset="0.82"/>
        <GradientStop Color="#00000000" Offset="0.97"/>
    </RadialGradientBrush>

    <!-- Recuadro del manual: borde claro con brillo, pulso y flecha que se mueve hacia el elemento -->
    <Style TargetType="controls:ManualHighlight">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ManualHighlight">
                    <Grid>
                        <Border x:Name="Pulse" BorderBrush="{TemplateBinding Foreground}" BorderThickness="3" CornerRadius="6"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                        </Border>
                        <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="3" CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="36" ShadowDepth="0" Opacity="0.16"/>
                            </Border.Effect>
                        </Border>
                        <Grid x:Name="Arrow" Width="44" Height="44" Margin="-56,0,0,0" HorizontalAlignment="Left"
                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Viewbox>
                                <Viewbox.RenderTransform>
                                    <TranslateTransform x:Name="Nudge"/>
                                </Viewbox.RenderTransform>
                                <Path Width="30" Height="30" Data="M3,15 H26 M19,8 L26,15 L19,22" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Arrow" Value="Right">
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Arrow" Property="Margin" Value="0,0,-56,0"/>
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Arrow" Value="Top">
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="Arrow" Property="Margin" Value="0,-56,0,0"/>
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Arrow" Value="Bottom">
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="Arrow" Property="Margin" Value="0,0,0,-56"/>
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Nudge" Storyboard.TargetProperty="X" To="10" Duration="0:0:0.9"
                                                     AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource SineInOut}"/>
                                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.5" To="0"
                                                     Duration="0:0:1.9" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="1" To="1.08" Duration="0:0:1.9" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="1" To="1.08" Duration="0:0:1.9" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Notificación de MENSAJES de iPhone (DataContext: ManualNoticeViewModel); entra desde arriba y sale hacia abajo -->
    <DataTemplate x:Key="ManualNoticeTemplate">
        <Border x:Name="Card" VerticalAlignment="Bottom" Padding="16,12,16,20" CornerRadius="24" Opacity="0"
                Background="{StaticResource IosBackgroundBrush}" BorderBrush="{StaticResource IosEdgeBrush}" BorderThickness="1"
                TextElement.FontFamily="{StaticResource FontSystem}" RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.65"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform Y="-24"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <StackPanel>
                    <DockPanel Margin="0,0,0,9">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource IosMessagesBrush}">
                            <Canvas>
                                <Ellipse Canvas.Left="4.5" Canvas.Top="6" Width="17" Height="12.5" Fill="White"/>
                                <Polygon Points="5,14 11,14 5,20" Fill="White"/>
                            </Canvas>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Text.Manual.NoticeTime}" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{StaticResource IosGrayBrush}"/>
                        <controls:SpacedText Text="{DynamicResource Text.Manual.NoticeApp}" Margin="9,0,0,0" VerticalAlignment="Center"
                                             FontFamily="{StaticResource FontSystem}" FontWeight="Medium" FontSize="12" Spacing="0.07"
                                             Foreground="{StaticResource IosGrayBrush}"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Text.Manual.NoticeSender}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding Text}" Margin="0,3,0,0" FontSize="15" LineHeight="19.5" TextWrapping="Wrap"
                               Foreground="{StaticResource IosTextBrush}"/>
                </StackPanel>
                <Border Width="38" Height="4" Margin="0,0,0,-13" CornerRadius="2" VerticalAlignment="Bottom"
                        Background="{StaticResource IosGrabberBrush}"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource NoticeInDuration}"/>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).Children[0].ScaleX">
                                <DiscreteDoubleKeyFrame KeyTime="0" Value="0.96"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="1" KeySpline="{StaticResource EaseOut}"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).Children[0].ScaleY">
                                <DiscreteDoubleKeyFrame KeyTime="0" Value="0.96"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="1" KeySpline="{StaticResource EaseOut}"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).Children[1].Y">
                                <DiscreteDoubleKeyFrame KeyTime="0" Value="-24"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="0" KeySpline="{StaticResource EaseOut}"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource ManualFadeDuration}"/>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).Children[1].Y" To="10" Duration="{StaticResource ManualFadeDuration}"/>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).Children[0].ScaleX" To="0.98" Duration="{StaticResource ManualFadeDuration}"/>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).Children[0].ScaleY" To="0.98" Duration="{StaticResource ManualFadeDuration}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
