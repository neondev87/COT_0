<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:COT_0.Host.Controls">

    <!-- Formas inclinadas de la sala y del selector -->
    <PathGeometry x:Key="CloseButtonShape" Figures="M16,0 L260,0 L244,52 L0,52 Z"/>
    <PathGeometry x:Key="QrPanelShape" Figures="M28,0 L420,0 L420,392 L392,420 L0,420 L0,28 Z"/>
    <PathGeometry x:Key="ThumbShape" Figures="M94,0 L300,0 L206,340 L0,340 Z"/>
    <PathGeometry x:Key="ThumbInnerShape" Figures="M94,0 L296,0 L202,336 L0,336 Z"/>

    <!-- CERRAR SALA: acento al 18% con borde interior; con hover se llena, brilla y se corre 6px -->
    <Style x:Key="CloseRoomButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Width="{StaticResource CloseButtonWidth}" Height="{StaticResource RoomFieldHeight}" Background="Transparent">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.Effect>
                            <DropShadowEffect Color="{StaticResource AccentGlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0"/>
                        </Grid.Effect>
                        <Grid Clip="{StaticResource CloseButtonShape}">
                            <Border Background="{StaticResource AccentSoftBrush}"/>
                            <Border x:Name="Hover" Background="{StaticResource AccentBrush}" Opacity="0"/>
                            <!-- Trazo de 2px recortado por la forma = 1px interior -->
                            <Path Data="{StaticResource CloseButtonShape}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource ColorDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-6" Duration="{StaticResource ColorDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.6" Duration="{StaticResource ColorDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource ColorDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource ColorDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="{StaticResource ColorDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Miniatura del selector: con hover crece 6%, aparece el borde de acento y un brillo difuso -->
    <Style x:Key="ThumbButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Width="{StaticResource ThumbWidth}" Height="{StaticResource ThumbHeight}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform/>
                        </Grid.RenderTransform>
                        <Path x:Name="Glow" Data="{StaticResource ThumbShape}" Fill="{StaticResource AccentBrush}" Opacity="0">
                            <Path.Effect>
                                <BlurEffect Radius="20"/>
                            </Path.Effect>
                        </Path>
                        <Path x:Name="Edge" Data="{StaticResource ThumbShape}" Fill="{StaticResource AccentBrush}" Opacity="0"/>
                        <ContentPresenter Margin="2" Clip="{StaticResource ThumbInnerShape}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="2"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.06" KeySpline="{StaticResource EaseOutExpo}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.06" KeySpline="{StaticResource EaseOutExpo}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="{StaticResource ThumbHoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource ThumbHoverDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource ThumbHoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource ThumbHoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource ThumbHoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource ThumbHoverDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
