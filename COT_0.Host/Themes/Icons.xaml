<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Iconos de trazo del diseño (viewBox 24×24 salvo los de la barra, 10×10) -->
    <Geometry x:Key="IconMinimize">M1,5 H9</Geometry>
    <Geometry x:Key="IconMaximize">M1.5,1.5 H8.5 V8.5 H1.5 Z</Geometry>
    <Geometry x:Key="IconClose">M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5</Geometry>

    <Geometry x:Key="IconQr">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H17 V17 H14 Z M20,14 V14.01 M14,20 H14.01 M17,20 H21 V17</Geometry>
    <Geometry x:Key="IconWallpaper">M4,4 H20 A1,1 0 0 1 21,5 V19 A1,1 0 0 1 20,20 H4 A1,1 0 0 1 3,19 V5 A1,1 0 0 1 4,4 Z M7.4,9.5 A1.6,1.6 0 1 0 10.6,9.5 A1.6,1.6 0 1 0 7.4,9.5 Z M21,16 L15.5,10.5 L5,20</Geometry>
    <Geometry x:Key="IconManual">M4,4.5 A1.5,1.5 0 0 1 5.5,3 H20 V18 H5.5 A1.5,1.5 0 0 0 4,19.5 Z M4,19.5 A1.5,1.5 0 0 0 5.5,21 H20 M9,8 H16 M9,11 H14</Geometry>
    <Geometry x:Key="IconExit">M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9</Geometry>

    <Geometry x:Key="IconArrowRight">M4,12 H19 M14,7 L19,12 L14,17</Geometry>
    <Geometry x:Key="IconArrowLeft">M19,12 H5 M11,18 L5,12 L11,6</Geometry>
    <Geometry x:Key="IconCopy">M9,9 H21 V21 H9 Z M5,15 H3 V3 H15 V5</Geometry>
    <Geometry x:Key="IconCheck">M4,12 L9,17 L20,6</Geometry>
    <Geometry x:Key="IconKick">M7,7 L17,17 M17,7 L7,17</Geometry>
    <Geometry x:Key="IconPower">M12,3 V12 M6.3,6.3 A8,8 0 1 0 17.7,6.3</Geometry>

    <GeometryGroup x:Key="IconNote" FillRule="Nonzero">
        <PathGeometry Figures="M10,17.5 V4.5 C12.2,4.9 14.6,6.1 16.5,8.3"/>
        <EllipseGeometry Center="7.4,17.6" RadiusX="2.6" RadiusY="2.1">
            <EllipseGeometry.Transform>
                <RotateTransform Angle="-18" CenterX="7.4" CenterY="17.6"/>
            </EllipseGeometry.Transform>
        </EllipseGeometry>
    </GeometryGroup>

    <!-- Nota tachada (música silenciada) y lista de línea fina (selector de canciones) -->
    <GeometryGroup x:Key="IconNoteMuted" FillRule="Nonzero">
        <StaticResource ResourceKey="IconNote"/>
        <LineGeometry StartPoint="4,4" EndPoint="20,20"/>
    </GeometryGroup>
    <Geometry x:Key="IconList">M9,6 H20 M9,12 H20 M9,18 H20 M4.5,6 H5 M4.5,12 H5 M4.5,18 H5</Geometry>

    <!-- Path de icono: trazo con el color del texto -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="CaptionIconPath" TargetType="Path">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
</ResourceDictionary>
