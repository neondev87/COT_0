<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:COT_0.Host.Controls">

    <!-- Paralelogramo de 340×58 con 16px de inclinación -->
    <PathGeometry x:Key="MenuCardShape" Figures="M16,0 L340,0 L324,58 L0,58 Z"/>

    <Storyboard x:Key="MenuCardHoverIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="{StaticResource MenuCardHoverShift}" KeySpline="{StaticResource EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.65" Duration="{StaticResource CardHoverDuration}"/>
        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource ColorDuration}"/>
    </Storyboard>

    <Storyboard x:Key="MenuCardHoverOut">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
            <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="0" KeySpline="{StaticResource EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="{StaticResource CardHoverDuration}"/>
        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource ColorDuration}"/>
    </Storyboard>

    <!-- Tarjeta del menú: cara clara; con hover pasa al acento, brilla y se corre 18px -->
    <Style TargetType="controls:MenuCard">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MenuCard">
                    <Grid x:Name="Root" Width="{StaticResource MenuCardWidth}" Height="{StaticResource MenuCardHeight}" Background="Transparent">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.Effect>
                            <DropShadowEffect Color="{StaticResource AccentGlowColor}" BlurRadius="16" ShadowDepth="0" Opacity="0"/>
                        </Grid.Effect>
                        <Grid Clip="{StaticResource MenuCardShape}">
                            <Border Background="{StaticResource CardFaceBrush}"/>
                            <Border x:Name="Hover" Background="{StaticResource AccentBrush}" Opacity="0"/>
                            <Grid Margin="26,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Num" Text="{TemplateBinding Number}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontCondensedExtraBold}" FontStyle="Italic" FontWeight="ExtraBold"
                                           FontSize="38" LineHeight="38" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <controls:SpacedText x:Name="Title" Text="{TemplateBinding Title}" LineHeight="21"
                                                         FontFamily="{StaticResource FontCondensed}" FontWeight="Bold" FontSize="21" Spacing="0.07"
                                                         Foreground="{StaticResource DarkInkBrush}"/>
                                    <controls:SpacedText x:Name="Sub" Text="{TemplateBinding Subtitle}" Margin="0,3,0,0"
                                                         FontFamily="{StaticResource FontBarlow}" FontSize="11" Spacing="0.04"
                                                         Foreground="{StaticResource CardSubBrush}"/>
                                </StackPanel>
                                <Viewbox Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center">
                                    <Path x:Name="Icon" Data="{TemplateBinding Icon}" Style="{StaticResource IconPath}"
                                          Stroke="{StaticResource DarkInkBrush}"/>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource WhiteSubBrush}"/>
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource WhiteBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MenuCardHoverIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MenuCardHoverOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Contenedor de cada tarjeta: entra desde la izquierda (-120%) -->
    <Style x:Key="MenuCardSlot" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="controls:EntryAnimation.OffsetX" Value="{StaticResource MenuCardEntryOffset}"/>
        <Setter Property="controls:EntryAnimation.Ease" Value="{StaticResource EaseOut}"/>
        <Setter Property="controls:EntryAnimation.Duration" Value="{StaticResource CardEntryDuration}"/>
    </Style>

    <!-- Estado "sala inactiva": se oculta cuando la sala está abierta -->
    <Style x:Key="InactiveStatus" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRoomActive}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
