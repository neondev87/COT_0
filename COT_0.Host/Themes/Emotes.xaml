<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:COT_0.Host.Controls">

    <!-- APLICAR: mismo botón claro de COPIAR, a la altura del campo -->
    <Style x:Key="ApplyButton" TargetType="Button" BasedOn="{StaticResource CopyButton}">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <!-- Fila de emote: entra con opacity + desplazamiento -->
    <Style x:Key="EmoteRow" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource EmoteRowHeight}"/>
        <Setter Property="Padding" Value="16,0,6,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource RowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="6"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource InputDuration}"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="{StaticResource InputDuration}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmoteThumb" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource EmoteThumbSize}"/>
        <Setter Property="Height" Value="{StaticResource EmoteThumbSize}"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>

    <!-- QUITAR / IGNORAR / RESTAURAR: texto chico, se aclara con el mouse -->
    <Style x:Key="RowTextButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Height" Value="{StaticResource MinHitSize}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowDangerButton" TargetType="Button" BasedOn="{StaticResource RowTextButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowButtonText" TargetType="controls:SpacedText" BasedOn="{StaticResource BoldCondensedText}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Spacing" Value="0.2"/>
    </Style>

    <!-- Estado del set: OK claro, error en acento, el resto apagado -->
    <Style x:Key="EmoteStatusText" TargetType="controls:SpacedText" BasedOn="{StaticResource BoldCondensedText}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Spacing" Value="0.2"/>
        <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Ready">
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="NotFound">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Aviso de lista vacía: solo se ve si no hay filas -->
    <Style x:Key="EmptyListText" TargetType="TextBlock" BasedOn="{StaticResource InterText}">
        <Setter Property="Margin" Value="16,12"/>
        <Setter Property="Foreground" Value="{StaticResource Light40Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmoteSectionHeader" TargetType="Border">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
    </Style>
</ResourceDictionary>
