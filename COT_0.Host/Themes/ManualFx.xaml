<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Fondo del manual: azul noche con niebla verde azulada, estática, franjas de interferencia y viñeta -->
    <RadialGradientBrush x:Key="ManualBaseBrush" Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#0E2733" Offset="0"/>
        <GradientStop Color="#08172F" Offset="0.52"/>
        <GradientStop Color="#040C1A" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ManualFogBrush">
        <GradientStop Color="#1459A3A6" Offset="0"/>
        <GradientStop Color="#0059A3A6" Offset="0.7"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ManualBandBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00BEE6E6" Offset="0"/>
        <GradientStop Color="#FFBEE6E6" Offset="0.5"/>
        <GradientStop Color="#00BEE6E6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ManualSweepBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#009CD6D5" Offset="0"/>
        <GradientStop Color="#069CD6D5" Offset="0.5"/>
        <GradientStop Color="#009CD6D5" Offset="1"/>
    </LinearGradientBrush>
    <!-- Scanlines: 1px verde azulado cada 3px, encima de todo -->
    <DrawingBrush x:Key="ManualScanBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H3 V3 H0 Z"/>
                <GeometryDrawing Brush="#049CD6D5" Geometry="M0,0 H3 V1 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <sys:Double x:Key="ManualNoiseOpacity">0.14</sys:Double>      <!-- estática durante los pasos -->
    <sys:Double x:Key="FarewellNoiseOpacity">0.26</sys:Double>    <!-- estática en la despedida -->
    <Duration x:Key="ManualFogDuration">0:0:34</Duration>
    <Duration x:Key="ManualSweepDuration">0:0:14</Duration>

    <!-- Pérdida de señal (SignalLossLayer): cada cuánto, cuánto dura y cuánto se corre -->
    <sys:TimeSpan x:Key="SignalMinInterval">0:0:3</sys:TimeSpan>
    <sys:TimeSpan x:Key="SignalMaxInterval">0:0:7</sys:TimeSpan>
    <sys:TimeSpan x:Key="SignalMinBurst">0:0:0.15</sys:TimeSpan>
    <sys:TimeSpan x:Key="SignalMaxBurst">0:0:0.4</sys:TimeSpan>
    <sys:TimeSpan x:Key="SignalLongBurst">0:0:0.6</sys:TimeSpan>
    <sys:Double x:Key="SignalNoiseOpacity">0.3</sys:Double>
    <sys:Double x:Key="SignalMaxShift">8</sys:Double>
    <sys:Double x:Key="SignalMaxTremor">5</sys:Double>
    <SolidColorBrush x:Key="SignalFlashBrush" Color="#17BEE6E6"/>  <!-- rgba(190,230,230,.09) -->
    <SolidColorBrush x:Key="SignalLineBrush" Color="#0D9CD6D5"/>
    <Duration x:Key="SignalLineDuration">0:0:9</Duration>
</ResourceDictionary>
