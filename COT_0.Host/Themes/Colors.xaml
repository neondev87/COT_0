<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Acento y paleta base del diseño -->
    <Color x:Key="AccentColor">#B3122E</Color>
    <Color x:Key="AccentGlowColor">#B3122E</Color>
    <Color x:Key="TransparentAccentColor">#00B3122E</Color>
    <Color x:Key="CardFaceColor">#ECEAF0</Color>
    <Color x:Key="DarkInkColor">#15121B</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EB3122E"/>        <!-- acento 18% -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A5290B11"/>       <!-- acento 12% sobre rgba(10,10,10,.6) -->
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WhiteSubBrush" Color="#E0FFFFFF"/>          <!-- rgba(255,255,255,.88) -->

    <!-- Texto -->
    <SolidColorBrush x:Key="TextBrush" Color="#ECEAF0"/>
    <SolidColorBrush x:Key="Text70Brush" Color="#B3ECEAF0"/>
    <SolidColorBrush x:Key="Text65Brush" Color="#A6ECEAF0"/>
    <SolidColorBrush x:Key="Text62Brush" Color="#9EECEAF0"/>
    <SolidColorBrush x:Key="Text60Brush" Color="#99ECEAF0"/>
    <SolidColorBrush x:Key="Text58Brush" Color="#94ECEAF0"/>
    <SolidColorBrush x:Key="Text55Brush" Color="#8CECEAF0"/>
    <SolidColorBrush x:Key="Text40Brush" Color="#66ECEAF0"/>
    <SolidColorBrush x:Key="Text25Brush" Color="#40ECEAF0"/>
    <SolidColorBrush x:Key="Text20Brush" Color="#33ECEAF0"/>

    <SolidColorBrush x:Key="LightBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Light70Brush" Color="#B3E6E6E6"/>
    <SolidColorBrush x:Key="Light65Brush" Color="#A6E6E6E6"/>
    <SolidColorBrush x:Key="Light62Brush" Color="#9EE6E6E6"/>
    <SolidColorBrush x:Key="Light60Brush" Color="#99E6E6E6"/>
    <SolidColorBrush x:Key="Light55Brush" Color="#8CE6E6E6"/>
    <SolidColorBrush x:Key="Light50Brush" Color="#80E6E6E6"/>
    <SolidColorBrush x:Key="Light40Brush" Color="#66E6E6E6"/>
    <SolidColorBrush x:Key="Light28Brush" Color="#47E6E6E6"/>

    <!-- Tarjetas y QR -->
    <SolidColorBrush x:Key="CardFaceBrush" Color="{StaticResource CardFaceColor}"/>
    <SolidColorBrush x:Key="DarkInkBrush" Color="{StaticResource DarkInkColor}"/>
    <SolidColorBrush x:Key="CardSubBrush" Color="#55505E"/>

    <!-- Superficies -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D0D0E"/>
    <SolidColorBrush x:Key="LoginBaseBrush" Color="#080808"/>
    <Color x:Key="InputColor">#09FFFFFF</Color>             <!-- rgba(255,255,255,.035) -->
    <Color x:Key="InputFocusColor">#0EFFFFFF</Color>        <!-- rgba(255,255,255,.055) -->
    <SolidColorBrush x:Key="ButtonBrush" Color="#8C0A0A0A"/>            <!-- rgba(10,10,10,.55) -->
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#0FFFFFFF"/>      <!-- rgba(255,255,255,.06) -->
    <SolidColorBrush x:Key="UrlFieldBrush" Color="#0BFFFFFF"/>          <!-- rgba(255,255,255,.045) -->
    <SolidColorBrush x:Key="PanelBrush" Color="#05FFFFFF"/>             <!-- rgba(255,255,255,.02) -->
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#14FFFFFF"/>       <!-- rgba(255,255,255,.08) -->
    <SolidColorBrush x:Key="RowBorderBrush" Color="#12FFFFFF"/>         <!-- rgba(255,255,255,.07) -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#06FFFFFF"/>          <!-- rgba(255,255,255,.025) -->
    <SolidColorBrush x:Key="AvatarBorderBrush" Color="#1AFFFFFF"/>      <!-- rgba(255,255,255,.1) -->
    <SolidColorBrush x:Key="SignatureBorderBrush" Color="#1FFFFFFF"/>   <!-- rgba(255,255,255,.12) -->
    <SolidColorBrush x:Key="SignatureBorderHoverBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="SignatureAvatarBrush" Color="#1C1C24"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#2EFFFFFF"/>       <!-- rgba(255,255,255,.18) -->
    <SolidColorBrush x:Key="PickerVeilBrush" Color="#80080809"/>        <!-- rgba(8,8,9,.5) -->
    <SolidColorBrush x:Key="SongPanelBrush" Color="#F20D0D0E"/>         <!-- panel del selector de canciones -->
    <SolidColorBrush x:Key="SongSelectedBrush" Color="#0FFFFFFF"/>      <!-- rgba(255,255,255,.06) -->
    <SolidColorBrush x:Key="SongCoverBrush" Color="#1C1C24"/>           <!-- marcador sin portada -->
    <SolidColorBrush x:Key="VideoDimBrush" Color="#590D0D0E"/>          <!-- oscurece el video para leer la UI -->
    <SolidColorBrush x:Key="AshBrush" Color="#9A9A9A"/>

    <!-- Tonos de avatar de la lista de conectados -->
    <SolidColorBrush x:Key="AvatarTone0Brush" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="AvatarTone1Brush" Color="#26262A"/>
    <SolidColorBrush x:Key="AvatarTone2Brush" Color="#2E2E32"/>
    <SolidColorBrush x:Key="AvatarTone3Brush" Color="#232327"/>
    <SolidColorBrush x:Key="AvatarTone4Brush" Color="#2B2B2F"/>

    <!-- Líneas con degradado al acento -->
    <LinearGradientBrush x:Key="AccentFadeInBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource TransparentAccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFadeOutBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource TransparentAccentColor}" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
