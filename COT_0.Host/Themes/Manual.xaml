<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:COT_0.Host.Controls">

    <!-- Manual de Lain: Inter, grises neutros; solo transform y opacity en las animaciones -->
    <SolidColorBrush x:Key="ManualPanelBrush" Color="#121213"/>
    <SolidColorBrush x:Key="ManualButtonBrush" Color="#14FFFFFF"/>      <!-- rgba(255,255,255,.08) -->
    <SolidColorBrush x:Key="ManualButtonHoverBrush" Color="#24FFFFFF"/> <!-- rgba(255,255,255,.14) -->
    <SolidColorBrush x:Key="KeycapBrush" Color="#0FFFFFFF"/>            <!-- rgba(255,255,255,.06) -->
    <SolidColorBrush x:Key="KeycapHoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="KeycapEdgeBrush" Color="#38FFFFFF"/>        <!-- rgba(255,255,255,.22) -->
    <SolidColorBrush x:Key="IosBackgroundBrush" Color="#242426"/>
    <SolidColorBrush x:Key="IosEdgeBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="IosGrayBrush" Color="#9B9BA1"/>
    <SolidColorBrush x:Key="IosTextBrush" Color="#F1F1F3"/>
    <SolidColorBrush x:Key="IosGrabberBrush" Color="#38FFFFFF"/>
    <LinearGradientBrush x:Key="IosMessagesBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6EE066" Offset="0"/>
        <GradientStop Color="#2CC24C" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="FontSystem">Segoe UI</FontFamily>

    <sys:Double x:Key="ManualColumnWidth">330</sys:Double>
    <Thickness x:Key="ManualPadding">402,24,32,28</Thickness>   <!-- columna izquierda (330) + 72 -->
    <Duration x:Key="ManualFadeDuration">0:0:0.3</Duration>
    <Duration x:Key="ManualLeaveDuration">0:0:0.25</Duration>
    <Duration x:Key="NoticeInDuration">0:0:0.35</Duration>
    <Duration x:Key="PressDuration">0:0:0.15</Duration>

    <!-- Textos -->
    <Style x:Key="ManualHeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ManualStepNumberText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Light65Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ManualStepTitleText" TargetType="TextBlock" BasedOn="{StaticResource ManualHeadingText}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
    <Style x:Key="ManualStepText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource Light65Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Atajo: keycap + acción. Tag = tecla, Content = acción. Sin foco: ENTER siempre es "empezar" -->
    <Style x:Key="ManualKeycap" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="20,0,0,0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Light65Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform/>
                        </StackPanel.RenderTransform>
                        <Border x:Name="Key" MinWidth="28" Padding="8,5" CornerRadius="4" VerticalAlignment="Center"
                                Background="{StaticResource KeycapBrush}" BorderBrush="{StaticResource KeycapEdgeBrush}" BorderThickness="0,0,0,2">
                            <TextBlock Text="{TemplateBinding Tag}" TextAlignment="Center" FontFamily="{StaticResource FontInter}" FontWeight="Medium"
                                       FontSize="12" Foreground="{StaticResource LightBrush}"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            <Setter TargetName="Key" Property="Background" Value="{StaticResource KeycapHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón gris redondeado ("Gracias, pero no necesito ayuda" y "Cerrar") -->
    <Style x:Key="ManualButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="Background" Value="{StaticResource ManualButtonBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ManualButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ManualSmallButton" TargetType="Button" BasedOn="{StaticResource ManualButton}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="ManualIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="1.2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <!-- SILENCIAR: solo el ícono; con el manual en silencio se tachan las ondas -->
    <Style x:Key="ManualMuteButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource Light65Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,9.5 V14.5 H7.5 L12,18.5 V5.5 L7.5,9.5 Z" Style="{StaticResource ManualIconPath}"/>
                                <Path x:Name="Waves" Data="M15.5,9 A4,4 0 0 1 15.5,15 M18,6.5 A8,8 0 0 1 18,17.5" Style="{StaticResource ManualIconPath}"/>
                                <Path x:Name="Cross" Data="M16,9.5 L21,14.5 M21,9.5 L16,14.5" Style="{StaticResource ManualIconPath}" Opacity="0"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter TargetName="Waves" Property="Opacity" Value="0"/>
                            <Setter TargetName="Cross" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
