<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Lienzo del diseño -->
    <sys:Double x:Key="DesignWidth">1280</sys:Double>
    <sys:Double x:Key="DesignHeight">720</sys:Double>
    <sys:Double x:Key="CaptionHeight">32</sys:Double>
    <sys:Double x:Key="CaptionButtonWidth">46</sys:Double>

    <!-- Login -->
    <sys:Double x:Key="LoginFormWidth">360</sys:Double>
    <sys:Double x:Key="InputHeight">46</sys:Double>
    <sys:Double x:Key="ButtonHeight">48</sys:Double>
    <sys:Double x:Key="LoginImageOpacity">0.375</sys:Double>   <!-- 0.5 × brightness(.75) -->
    <sys:Double x:Key="SignatureAvatarSize">64</sys:Double>
    <sys:Double x:Key="VolumeSliderWidth">130</sys:Double>

    <!-- Dashboard -->
    <sys:Double x:Key="MenuCardWidth">340</sys:Double>
    <sys:Double x:Key="MenuCardHeight">58</sys:Double>
    <sys:Double x:Key="MenuCardEntryOffset">-408</sys:Double>  <!-- -120% del ancho -->
    <sys:Double x:Key="MenuCardHoverShift">18</sys:Double>
    <sys:Double x:Key="ThumbWidth">300</sys:Double>
    <sys:Double x:Key="ThumbHeight">340</sys:Double>
    <sys:Double x:Key="BackgroundBlurRadius">24</sys:Double>

    <!-- Sala -->
    <sys:Double x:Key="QrPanelSize">420</sys:Double>
    <sys:Double x:Key="QrSize">340</sys:Double>
    <sys:Double x:Key="RoomFieldHeight">52</sys:Double>
    <sys:Double x:Key="CloseButtonWidth">260</sys:Double>
    <sys:Double x:Key="UserRowHeight">62</sys:Double>
    <sys:Double x:Key="AvatarSize">36</sys:Double>
    <sys:Double x:Key="PulseDotSize">9</sys:Double>
    <sys:Double x:Key="PulseRingScale">2.33</sys:Double>       <!-- 9px + 6px por lado -->

    <!-- Tiempos -->
    <Duration x:Key="RiseDuration">0:0:0.9</Duration>
    <Duration x:Key="CardEntryDuration">0:0:0.7</Duration>
    <Duration x:Key="RoomEntryDuration">0:0:0.8</Duration>
    <Duration x:Key="ClockFadeDuration">0:0:1.2</Duration>
    <Duration x:Key="StatusFadeDuration">0:0:1.4</Duration>
    <Duration x:Key="BackgroundFadeDuration">0:0:0.9</Duration>
    <Duration x:Key="UiFadeDuration">0:0:0.45</Duration>
    <Duration x:Key="PickerFadeDuration">0:0:0.4</Duration>
    <Duration x:Key="ThumbRiseDuration">0:0:0.5</Duration>
    <Duration x:Key="ThumbHoverDuration">0:0:0.25</Duration>
    <Duration x:Key="CardHoverDuration">0:0:0.35</Duration>
    <Duration x:Key="ColorDuration">0:0:0.3</Duration>
    <Duration x:Key="InputDuration">0:0:0.25</Duration>
    <Duration x:Key="QuickDuration">0:0:0.2</Duration>
    <Duration x:Key="VolumeRevealDuration">0:0:0.28</Duration>
    <Duration x:Key="PulseHalfDuration">0:0:1</Duration>
    <Duration x:Key="QrGlowHalfDuration">0:0:3</Duration>
    <Duration x:Key="FloatHalfDuration">0:0:6</Duration>
    <Duration x:Key="BlinkDuration">0:0:1.2</Duration>
    <Duration x:Key="SweepDuration">0:0:14</Duration>
    <Duration x:Key="FogADuration">0:0:34</Duration>
    <Duration x:Key="FogBDuration">0:0:46</Duration>
    <Duration x:Key="AeroHalfDuration">0:0:3</Duration>

    <sys:TimeSpan x:Key="Delay010">0:0:0.10</sys:TimeSpan>
    <sys:TimeSpan x:Key="Delay015">0:0:0.15</sys:TimeSpan>
    <sys:TimeSpan x:Key="Delay025">0:0:0.25</sys:TimeSpan>
    <sys:TimeSpan x:Key="Delay027">0:0:0.27</sys:TimeSpan>
    <sys:TimeSpan x:Key="Delay035">0:0:0.35</sys:TimeSpan>
    <sys:TimeSpan x:Key="Delay039">0:0:0.39</sys:TimeSpan>
    <sys:TimeSpan x:Key="Delay051">0:0:0.51</sys:TimeSpan>
    <sys:TimeSpan x:Key="ThumbDelay">0:0:0.08</sys:TimeSpan>

    <!-- Curvas: cubic-bezier(.2,.8,.2,1) y cubic-bezier(.16,1,.3,1) -->
    <KeySpline x:Key="EaseOut" ControlPoint1="0.2,0.8" ControlPoint2="0.2,1"/>
    <KeySpline x:Key="EaseOutExpo" ControlPoint1="0.16,1" ControlPoint2="0.3,1"/>
    <KeySpline x:Key="EaseInOut" ControlPoint1="0.42,0" ControlPoint2="0.58,1"/>
    <SineEase x:Key="SineInOut" EasingMode="EaseInOut"/>
</ResourceDictionary>
