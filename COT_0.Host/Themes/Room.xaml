<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:COT_0.Host.Controls">

    <!-- Letras del rombo "C0" sobre el QR -->
    <Style x:Key="QrMarkText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCinzel}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="17"/>
    </Style>

    <!-- COPIAR ↔ COPIADO según RoomViewModel.IsCopied -->
    <Style x:Key="CopyIconPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Data" Value="{StaticResource IconCopy}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CopyLabelText" TargetType="controls:SpacedText" BasedOn="{StaticResource BoldCondensedText}">
        <Setter Property="Text" Value="{DynamicResource Text.Room.Copy}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                <Setter Property="Text" Value="{DynamicResource Text.Room.Copied}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Fila de la lista de conectados -->
    <Style x:Key="UserRow" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource UserRowHeight}"/>
        <Setter Property="Padding" Value="24,0,10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource RowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource AvatarSize}"/>
        <Setter Property="Height" Value="{StaticResource AvatarSize}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource AvatarBorderBrush}"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <!-- Invitados: tonos 1,2,3,4,0 (el 0 es del host, primero en la lista) -->
    <Style x:Key="GuestAvatar" TargetType="Border" BasedOn="{StaticResource Avatar}">
        <Setter Property="Background" Value="{StaticResource AvatarTone1Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                <Setter Property="Background" Value="{StaticResource AvatarTone2Brush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="2">
                <Setter Property="Background" Value="{StaticResource AvatarTone3Brush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="3">
                <Setter Property="Background" Value="{StaticResource AvatarTone4Brush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="4">
                <Setter Property="Background" Value="{StaticResource AvatarTone0Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- El botón expulsar solo se ve con el mouse sobre la fila -->
    <Style x:Key="RowKickButton" TargetType="Button" BasedOn="{StaticResource KickButton}">
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InitialsText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
