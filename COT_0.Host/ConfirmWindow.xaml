<controls:ChromeWindow x:Class="COT_0.Host.ConfirmWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:COT_0.Host.Controls"
                       Title="{DynamicResource Text.App.Name}" Width="{StaticResource ConfirmWidth}" SizeToContent="Height"
                       ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                       BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
    <!-- Confirmación con el estilo de la sala (DataContext: textos del diálogo) -->
    <Grid>
        <controls:ConfirmPanel Confirmed="OnConfirm"/>
        <controls:CaptionBar Title="{DynamicResource Text.App.Name}" ShowMaximize="False"/>
    </Grid>
</controls:ChromeWindow>
