<controls:ChromeWindow x:Class="COT_0.Host.ManualWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:COT_0.Host.Controls"
                       xmlns:views="clr-namespace:COT_0.Host.Views"
                       Title="{DynamicResource Text.Manual.Title}" Width="{StaticResource DesignWidth}" Height="{StaticResource DesignHeight}"
                       MinWidth="{StaticResource DesignWidth}" MinHeight="{StaticResource DesignHeight}"
                       WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Manual de Lain (DataContext: ManualViewModel) -->
    <controls:ChromeWindow.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding StartCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}"/>
    </controls:ChromeWindow.InputBindings>

    <Grid>
        <controls:ManualBackdrop/>

        <!-- Pasos: se desvanecen al pasar a la despedida -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFarewell}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource ManualFadeDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid Margin="{StaticResource ManualPadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Atajos de teclado -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ManualKeycap}" Tag="{DynamicResource Text.Manual.KeyStart}"
                            Content="{DynamicResource Text.Manual.Start}" Command="{Binding StartCommand}" Margin="0"/>
                    <Button Style="{StaticResource ManualKeycap}" Tag="{DynamicResource Text.Manual.KeyNext}"
                            Content="{DynamicResource Text.Manual.Next}" Command="{Binding NextCommand}"/>
                    <Button Style="{StaticResource ManualKeycap}" Tag="{DynamicResource Text.Manual.KeyPrevious}"
                            Content="{DynamicResource Text.Manual.Previous}" Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource ManualKeycap}" Tag="{DynamicResource Text.Manual.KeyExit}"
                            Content="{DynamicResource Text.Manual.Exit}" Command="{Binding ExitCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,19,0,22" Text="{DynamicResource Text.Manual.Heading}" Style="{StaticResource ManualHeadingText}"/>
                <views:ManualStepView Grid.Row="2"/>
                <Button Grid.Row="3" Margin="0,18,0,0" Style="{StaticResource ManualButton}"
                        Content="{DynamicResource Text.Manual.Skip}" Command="{Binding FarewellCommand}"/>
            </Grid>

            <!-- Columna izquierda: notificación de Lain y, debajo, su video -->
            <Grid Width="{StaticResource ManualColumnWidth}" Margin="32,0,0,20" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="60*"/>
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding Current.Notices}" ItemTemplate="{StaticResource ManualNoticeTemplate}"
                              VerticalAlignment="Bottom" Focusable="False" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource ManualLeaveDuration}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
                <controls:LoopingVideo Grid.Row="2" Source="{Binding LainVideo}" Stretch="Uniform" OpacityMask="{StaticResource LainEdgeMask}"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
            </Grid>

            <Button Margin="0,0,32,28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource ManualMuteButton}"
                    Command="{Binding ToggleMuteCommand}" ToolTip="{DynamicResource Text.Manual.Mute}"/>
        </Grid>

        <!-- Despedida: se crea solo al llegar, para que su video no corra antes -->
        <ContentControl Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFarewell}" Value="True">
                            <Setter Property="Content" Value="{Binding}"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <views:ManualFarewellView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Encima de todo, muy tenues: scanlines y barrido -->
        <Rectangle Fill="{StaticResource ScanlineBrush}" IsHitTestVisible="False"/>
        <Rectangle Height="120" VerticalAlignment="Top" Fill="{StaticResource SweepBrush}" IsHitTestVisible="False">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Sweep"/>
            </Rectangle.RenderTransform>
        </Rectangle>
        <controls:CaptionBar Title="{DynamicResource Text.Manual.Title}"/>
    </Grid>

    <controls:ChromeWindow.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Y" From="-140" To="1200"
                                     Duration="{StaticResource SweepDuration}" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </controls:ChromeWindow.Triggers>
</controls:ChromeWindow>
