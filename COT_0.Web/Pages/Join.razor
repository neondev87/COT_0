@page "/join"
@rendermode InteractiveServer
@implements IDisposable
@inject IProfileService Profiles
@inject IRoomService Room
@inject IFlagService Flags
@inject IOptions<ChatOptions> Options
@inject NavigationManager Nav

<PageTitle>COT_0 · Únete a la sala</PageTitle>

@* Perfil del invitado: nombre, foto y facultad *@
<div class="cot-screen cot-center join-page">
    <Backdrop />

    <EditForm Model="form" OnValidSubmit="JoinAsync" class="cot-card">
        <DataAnnotationsValidator />
        <CotLogo Subtitle="ÚNETE A LA SALA" Class="cot-rise cot-card-head" />

        @if (!Room.IsOpen)
        {
            <p class="cot-notice cot-rise cot-d1">La sala está cerrada. Esperá a que el anfitrión la abra y volvé a escanear el QR.</p>
        }
        else
        {
            @if (notice is not null)
            {
                <p class="cot-notice cot-rise">@notice</p>
            }

            <div class="cot-group cot-rise cot-d1">
                <label for="cot-name" class="cot-label">NOMBRE DE USUARIO</label>
                <InputText id="cot-name" class="cot-input" @bind-Value="form.Name" placeholder="cómo te verán en el chat"
                           maxlength="@Options.Value.MaxNameLength" autocomplete="nickname" />
                <ValidationMessage For="() => form.Name" />
            </div>

            <div class="cot-group cot-rise cot-d2">
                <span class="cot-label">FOTO DE PERFIL</span>
                <PhotoUpload PhotoUrl="@form.PhotoUrl" OnChange="UploadPhotoAsync" />
            </div>

            <div class="cot-group cot-group-last cot-rise cot-d3">
                <span class="cot-label" id="cot-fac-label">FACULTAD</span>
                <FacultyField Selected="SelectedFlag" LabelId="cot-fac-label" OnOpen="() => sheetOpen = true" />
            </div>

            @if (error is not null)
            {
                <p class="cot-error">@error</p>
            }

            <div class="cot-cta-bar cot-rise cot-d4">
                <button type="submit" class="cot-btn">ENTRAR AL CHAT <Icon Name="arrow" Size="20" Class="arr" /></button>
            </div>

            <p class="cot-room">SALA #@Room.Code</p>
        }
    </EditForm>

    <FacultySheet Flags="flags" Open="sheetOpen" Selected="@form.FacultyFlag" OnPick="PickFaculty" OnClose="() => sheetOpen = false" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }

    private readonly JoinForm form = new();
    private string? error;
    private string? notice;
    private IReadOnlyList<FlagOption> flags = [];
    private bool sheetOpen;

    private FlagOption? SelectedFlag => flags.FirstOrDefault(f => f.Key == form.FacultyFlag);

    protected override void OnInitialized()
    {
        notice = LeaveReason.ToNotice(Reason);
        flags = Flags.GetFlags();
        Room.Changed += OnRoomChanged;
    }

    // Al elegir, el panel se cierra solo
    private void PickFaculty(string key)
    {
        form.FacultyFlag = key;
        sheetOpen = false;
    }

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        var result = await Profiles.SavePhotoAsync(e.File);
        form.PhotoUrl = result.Value ?? form.PhotoUrl;
        error = result.Error;
    }

    private async Task JoinAsync()
    {
        var result = await Profiles.CreateUserAsync(form);
        error = result.Error;
        if (result.Value is not null) Nav.NavigateTo($"/chat?u={result.Value.Id}");
    }

    private void OnRoomChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Room.Changed -= OnRoomChanged;
}
