@page "/join"
@rendermode InteractiveServer
@implements IDisposable
@inject IProfileService Profiles
@inject IRoomService Room
@inject NavigationManager Nav

<PageTitle>COT_0 · Únete a la sala</PageTitle>

@* Perfil del invitado: nombre, foto y facultad *@
<div class="cot-screen cot-center join-page">
    <Backdrop />

    <ProfileForm Form="form" Subtitle="ÚNETE A LA SALA" SubmitLabel="ENTRAR AL CHAT" ShowFields="Room.IsOpen && !resuming"
                 Error="@error" OnSubmit="JoinAsync">
        <Header>
            @if (!Room.IsOpen)
            {
                <p class="cot-notice cot-rise cot-d1">La sala está cerrada. Espera a que el anfitrión la abra y vuelve a escanear el QR.</p>
            }
            else if (resuming)
            {
                <p class="cot-room cot-rise cot-d1">ENTRANDO A LA SALA #@Room.Code…</p>
            }
            else if (notice is not null)
            {
                <p class="cot-notice cot-rise">@notice</p>
            }
        </Header>
        <Footer>
            @if (Room.IsOpen && !resuming)
            {
                <p class="cot-room">SALA #@Room.Code</p>
            }
            @if (!resuming)
            {
                <a class="join-manual" href="manual">¿Primera vez? Mira cómo funciona</a>
            }
        </Footer>
    </ProfileForm>
</div>

@code {
    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }

    private readonly JoinForm form = new();
    private string? error;
    private string? notice;

    // Mientras se busca el perfil guardado no se muestra el formulario
    private bool resuming = true;

    protected override void OnInitialized()
    {
        notice = LeaveReason.ToNotice(Reason);
        Room.Changed += OnRoomChanged;
    }

    // localStorage solo se puede leer después del primer render interactivo
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var user = await Profiles.ResumeAsync(Reason);
        if (user is not null)
        {
            Nav.NavigateTo($"/chat?u={user.Id}");
            return;
        }

        resuming = false;
        StateHasChanged();
    }

    private async Task JoinAsync()
    {
        var result = await Profiles.CreateUserAsync(form);
        error = result.Error;
        if (result.Value is not null) Nav.NavigateTo($"/chat?u={result.Value.Id}");
    }

    private void OnRoomChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Room.Changed -= OnRoomChanged;
}
