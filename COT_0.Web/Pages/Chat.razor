@page "/chat"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IChatSession Session
@inject IChatBrowser Browser
@inject IRoomService Room
@inject IRoomEmotes Emotes
@inject IOptions<ChatOptions> Options
@inject NavigationManager Nav

<PageTitle>COT_0 · Chat</PageTitle>

@* Chat grupal en tiempo real (pensado primero para celular) *@
<div class="cot-screen chat-page" @ref="page">
    <Backdrop />

    <ChatHeader RoomCode="@Room.Code" UserCount="Session.Users.Count" Me="Session.CurrentUser"
                OnOpenUsers="OpenUsers" OnOpenProfile="OpenProfile" />

    <div class="chat-body">
        <MessageList Groups="Session.Groups" TypingSummary="@Session.TypingSummary" OnOpenImage="OpenImage" />

        <UserPanel Users="Session.Users" IsOpen="usersOpen" OnClose="CloseUsers" />
    </div>

    @if (Session.CurrentUser is { } author)
    {
        <ChatComposer Draft="draft" UserId="@author.Id" OnSend="SendAsync" OnTyping="Session.NotifyTypingAsync" />
    }

    @if (profileOpen && Session.CurrentUser is { } user)
    {
        <ProfileEditor User="user" OnClose="CloseProfile" />
    }

    <EmoteMenu Reporter="Session.CurrentUser" />

    @if (viewingImage is not null)
    {
        <ImageViewer Url="@viewingImage" OnClose="CloseImage" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "u")]
    public string? UserId { get; set; }

    private ElementReference page;
    private MessageDraft draft = default!;
    private bool usersOpen;
    private bool profileOpen;
    private string? viewingImage;

    protected override async Task OnInitializedAsync()
    {
        draft = new MessageDraft(Options.Value.MaxMessageLength);
        Session.Changed += OnSessionChanged;
        Session.Ended += OnSessionEnded;
        // El host quitó un emote o cambió el set: se vuelven a pintar todos los mensajes
        Emotes.Changed += OnSessionChanged;
        if (!await Session.StartAsync(UserId)) Nav.NavigateTo("/join");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Browser.AttachAsync(page);
        StateHasChanged();
    }

    private async Task SendAsync()
    {
        if (!draft.CanSend) return;

        var text = draft.Text;
        draft.Clear();
        await Session.SendAsync(text);
    }

    private void OpenUsers() => usersOpen = true;

    private void CloseUsers() => usersOpen = false;

    private void OpenProfile() => profileOpen = true;

    private void CloseProfile() => profileOpen = false;

    private void OpenImage(string url) => viewingImage = url;

    private void CloseImage() => viewingImage = null;

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnSessionEnded(string? reason) =>
        _ = InvokeAsync(() => Nav.NavigateTo(reason is null ? "/join" : $"/join?reason={reason}"));

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        Session.Ended -= OnSessionEnded;
        Emotes.Changed -= OnSessionChanged;
        await Session.StopAsync();
    }
}
