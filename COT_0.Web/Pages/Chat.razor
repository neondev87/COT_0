@page "/chat"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IChatSession Session
@inject IChatBrowser Browser
@inject IRoomService Room
@inject IOptions<ChatOptions> Options
@inject NavigationManager Nav

<PageTitle>COT_0 · Chat</PageTitle>

@* Chat grupal en tiempo real (pensado primero para celular) *@
<div class="cot-screen chat-page" @ref="page">
    <Backdrop />

    <header class="chat-top">
        <CotLogo Class="cot-brand-sm" />
        <span class="chat-room">SALA #@Room.Code</span>
        <button type="button" class="chat-users-btn" @onclick="OpenUsers" aria-haspopup="dialog" aria-label="Conectados">
            <Icon Name="users" /> @Session.Users.Count
        </button>
        @if (Session.CurrentUser is { } me)
        {
            <button type="button" class="chat-me cot-av" @onclick="OpenProfile" aria-haspopup="dialog" aria-label="Editar tu perfil">
                @if (string.IsNullOrEmpty(me.PhotoUrl))
                {
                    <span class="cot-av-empty avatar-initial">@me.Name.Trim()[..1].ToUpperInvariant()</span>
                }
                else
                {
                    <img class="cot-av-img" src="@me.PhotoUrl" alt="" />
                }
            </button>
        }
    </header>

    <div class="chat-body">
        <div class="chat-main">
            <main class="msg-scroll">
                <div class="msg-stack">
                    @if (Session.Groups.Count == 0)
                    {
                        <p class="msg-empty">Todavía no hay mensajes. Rompé el silencio.</p>
                    }
                    @foreach (var group in Session.Groups)
                    {
                        <MessageBlock @key="group.Key" Group="group" OnOpenImage="OpenImage" />
                    }
                </div>
            </main>

            <p class="msg-typing @(Session.TypingSummary is null ? null : "on")" aria-live="polite">@Session.TypingSummary</p>
            @* Lo muestra chat.js cuando llegan mensajes mientras se lee más arriba *@
            <button type="button" class="msg-new">MENSAJES NUEVOS <Icon Name="chevron" Size="16" /></button>
        </div>

        <UserPanel Users="Session.Users" IsOpen="usersOpen" OnClose="CloseUsers" />
    </div>

    @if (Session.CurrentUser is { } author)
    {
        <ChatComposer Draft="draft" UserId="@author.Id" OnSend="SendAsync" OnTyping="Session.NotifyTypingAsync" />
    }

    @if (profileOpen && Session.CurrentUser is { } user)
    {
        <ProfileEditor User="user" OnClose="CloseProfile" />
    }

    @if (viewingImage is not null)
    {
        <ImageViewer Url="@viewingImage" OnClose="CloseImage" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "u")]
    public string? UserId { get; set; }

    private ElementReference page;
    private MessageDraft draft = default!;
    private bool usersOpen;
    private bool profileOpen;
    private string? viewingImage;

    protected override async Task OnInitializedAsync()
    {
        draft = new MessageDraft(Options.Value.MaxMessageLength);
        Session.Changed += OnSessionChanged;
        Session.Ended += OnSessionEnded;
        if (!await Session.StartAsync(UserId)) Nav.NavigateTo("/join");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Browser.AttachAsync(page);
        StateHasChanged();
    }

    private async Task SendAsync()
    {
        if (!draft.CanSend) return;

        var text = draft.Text;
        draft.Clear();
        await Session.SendAsync(text);
    }

    private void OpenUsers() => usersOpen = true;

    private void CloseUsers() => usersOpen = false;

    private void OpenProfile() => profileOpen = true;

    private void CloseProfile() => profileOpen = false;

    private void OpenImage(string url) => viewingImage = url;

    private void CloseImage() => viewingImage = null;

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnSessionEnded(string? reason) =>
        _ = InvokeAsync(() => Nav.NavigateTo(reason is null ? "/join" : $"/join?reason={reason}"));

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        Session.Ended -= OnSessionEnded;
        await Session.StopAsync();
    }
}
