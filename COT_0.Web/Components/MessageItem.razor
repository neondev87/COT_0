@inject IOptions<ChatOptions> Options

<article class="msg @(IsOwn ? "msg-own" : null)">
    <UserAvatar PhotoUrl="@Message.UserPhotoUrl" Name="@Message.UserName" />
    <div class="msg-body">
        <header class="msg-header">
            <span class="msg-author">@Message.UserName</span>
            <FlagIcon Key="@Message.UserFacultyFlag" />
            <time class="msg-time">@Message.SentAt.ToLocalTime().ToString(Options.Value.TimeFormat)</time>
        </header>
        <p class="msg-text"><MessageText Text="@Message.Text" /></p>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public bool IsOwn { get; set; }
}
