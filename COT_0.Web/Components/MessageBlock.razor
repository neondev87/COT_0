@inject IChatBrowser Browser
@inject IVoiceService Voices
@inject IImageService Images

@* Grupo de mensajes seguidos de un autor (encabezado + hora una vez) o un aviso del sistema *@
@if (Group.IsSystem)
{
    <p class="msg-sys">
        <span>@Group.First.Text</span>
        <time>@Browser.FormatTime(Group.First.SentAt)</time>
    </p>
}
else
{
    <article class="msg @(Group.IsOwn ? "msg-own" : null)">
        <UserAvatar PhotoUrl="@Group.First.UserPhotoUrl" Name="@Group.First.UserName" />
        <div class="msg-body">
            <header class="msg-header">
                <span class="msg-author">@Group.First.UserName</span>
                <FlagIcon Key="@Group.First.UserFacultyFlag" />
                <time class="msg-time">@Browser.FormatTime(Group.First.SentAt)</time>
            </header>
            @foreach (var message in Group.Messages)
            {
                if (Voices.Find(message) is { } voice)
                {
                    <div class="msg-line msg-voice" @key="message.Id"><VoiceBubble Voice="voice" /></div>
                }
                else if (Images.Find(message) is { } image)
                {
                    <div class="msg-line msg-image" @key="message.Id"><ImageBubble Image="image" OnOpen="OnOpenImage" /></div>
                }
                else
                {
                    <p class="msg-text msg-line" @key="message.Id"><MessageText Text="@message.Text" /></p>
                }
            }
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired] public MessageGroup Group { get; set; } = default!;
    [Parameter] public EventCallback<string> OnOpenImage { get; set; }
}
