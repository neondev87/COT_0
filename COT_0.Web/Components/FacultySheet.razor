@* Panel que sube desde abajo: buscador (sin acentos) y grilla de escudos; va fuera del form *@
<div class="cot-scrim @OpenClass" @onclick="OnClose"></div>
<div class="cot-sheet @OpenClass" role="dialog" aria-label="Elige tu facultad" inert="@(!Open)">
    <div class="cot-sheet-grip"><span></span></div>
    <div class="cot-sheet-head">
        <span class="cot-sheet-title">ELIGE TU FACULTAD</span>
        <button type="button" class="cot-x" @onclick="OnClose" aria-label="Cerrar"><Icon Name="close" /></button>
    </div>
    <div class="cot-search-box">
        <Icon Name="search" Class="cot-search-icon" />
        <input class="cot-search" type="search" placeholder="Buscar facultad" aria-label="Buscar facultad"
               @bind="query" @bind:event="oninput" />
    </div>
    <div class="cot-sheet-body">
        <div class="cot-fac-grid">
            @foreach (var flag in Filtered)
            {
                <button type="button" class="cot-fac @(flag.Key == Selected ? "sel" : null)" @key="flag.Key"
                        aria-pressed="@(flag.Key == Selected)" @onclick="() => OnPick.InvokeAsync(flag.Key)">
                    <span class="ring"></span>
                    <FacultyShield Url="@flag.Url" />
                    <span class="cot-fac-name">@flag.Label</span>
                </button>
            }
        </div>
        @if (Filtered.Count == 0)
        {
            <p class="cot-empty">No hay facultades con ese nombre</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FlagOption> Flags { get; set; } = [];
    [Parameter] public bool Open { get; set; }
    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string> OnPick { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string query = string.Empty;

    private IReadOnlyList<FlagOption> Filtered => FlagSearch.Filter(Flags, query);
    private string? OpenClass => Open ? "on" : null;
}
