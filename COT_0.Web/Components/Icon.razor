@* Íconos de línea fina del diseño *@
<svg class="cot-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "user":
            <circle cx="12" cy="9" r="3.5"></circle>
            <path d="M5 20c1-3.4 3.8-5.2 7-5.2s6 1.8 7 5.2"></path>
            break;
        case "users":
            <circle cx="9" cy="9" r="3"></circle>
            <path d="M3.5 19c.8-3 3-4.6 5.5-4.6s4.7 1.6 5.5 4.6"></path>
            <path d="M15.5 6.2a3 3 0 0 1 0 5.6M17.5 14.8c1.5.6 2.6 2 3 4.2"></path>
            break;
        case "upload":
            <path d="M12 16V4M7 9l5-5 5 5"></path>
            <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"></path>
            break;
        case "chevron":
            <path d="M6 9l6 6 6-6"></path>
            break;
        case "arrow":
            <path d="M4 12h15M14 7l5 5-5 5"></path>
            break;
        case "back":
            <path d="M20 12H5M10 7l-5 5 5 5"></path>
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18"></path>
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="M20 20l-4.2-4.2"></path>
            break;
        case "image":
            <rect x="4" y="5" width="16" height="14" rx="1"></rect>
            <path d="M4 16l5-5 4 4 3-3 4 4"></path>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? Class { get; set; }
}
