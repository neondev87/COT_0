@* Encima del campo de texto mientras se graba o se envía; CANCELAR lo atiende voice.js (.voice-cancel) *@
<div class="voice-rec" aria-live="polite">
    @if (State == VoiceState.Recording)
    {
        <span class="voice-rec-dot"></span>
        <span class="voice-rec-time">@VoiceFormat.Duration(Elapsed)</span>
        <span class="voice-rec-hint">TOCA EL BOTÓN PARA ENVIAR</span>
        <button type="button" class="voice-cancel">CANCELAR</button>
    }
    else
    {
        <span class="voice-rec-time">ENVIANDO NOTA DE VOZ…</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public VoiceState State { get; set; }
    [Parameter] public TimeSpan Elapsed { get; set; }
}
