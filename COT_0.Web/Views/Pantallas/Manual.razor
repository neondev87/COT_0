@page "/manual"
@rendermode InteractiveServer
@implements IDisposable
@inject IManualTour Tour
@inject IRoomEmotes Emotes

<PageTitle>COT_0 · Manual</PageTitle>

@* Manual del invitado «Transmisión»: arranque y bienvenida, cinco pasos tipo historias con las vistas reales
   en modo demostración y final con la tele de Lain. data-boot solo en la bienvenida (el arranque corre una vez) *@
<div class="manual" data-screen="@Screen" data-muted="@(Tour.Muted ? "true" : "false")"
     data-boot="@Tour.IsWelcome" style="@(Tour.IsWelcome ? Tour.BootStyle : null)">
    <ManualFx />
    <audio id="manual-sfx" src="@Tour.SoundUrl" preload="auto"></audio>

    @if (Tour.Current is { } step)
    {
        <ManualStory Tour="Tour" Step="step" ExitUrl="@JoinUrl" OnPrevious="Tour.Previous" OnNext="Tour.Next" />
    }
    else if (Tour.IsWelcome)
    {
        <ManualWelcome Tour="Tour" ExitUrl="@JoinUrl" OnStart="Tour.Next" />
    }
    else
    {
        <ManualFinish Tour="Tour" ExitUrl="@JoinUrl" OnRestart="() => Tour.GoTo(0)" />
    }

    @if (!Tour.IsWelcome)
    {
        <ManualSignal @key="Tour.Index" />
    }
    <MuteButton Muted="Tour.Muted" OnToggle="Tour.ToggleMute" />
</div>

@code {
    private const string JoinUrl = "join";

    // ?paso=N abre directo en ese paso (1 = primero)
    [SupplyParameterFromQuery(Name = "paso")]
    public int? Step { get; set; }

    private string Screen => Tour.IsWelcome ? "welcome" : Tour.IsFinished ? "finish" : "steps";

    protected override void OnInitialized()
    {
        if (Step is { } number) Tour.GoTo(number - 1);
        Emotes.Changed += OnEmotesChanged;
    }

    // Cuando llegan los emotes de 7TV se vuelve a armar la vista (y el menú de reportar)
    private void OnEmotesChanged() => _ = InvokeAsync(() =>
    {
        Tour.GoTo(Tour.Index);
        StateHasChanged();
    });

    public void Dispose() => Emotes.Changed -= OnEmotesChanged;
}
