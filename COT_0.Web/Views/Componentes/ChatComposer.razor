@implements IAsyncDisposable
@inject IVoiceRecorder Recorder
@inject IImageUploader Images
@inject IComposerEditor Editor

@* Barra de escritura: el cuadro lo maneja composer.js (emotes como imagen, Enter envía, Shift+Enter salto de línea).
   Blazor no le pinta hijos al cuadro: así no le pisa las imágenes ni el cursor.
   Sin texto, el botón de enviar pasa a ser el micrófono: un toque graba y otro envía (voice.js) *@
@if (Recorder.Notice is { } notice)
{
    <p class="voice-notice" role="alert">
        <span>@notice</span>
        <button type="button" class="cot-x" @onclick="Recorder.DismissNotice" aria-label="Cerrar aviso"><Icon Name="close" Size="16" /></button>
    </p>
}
@if (Images.Notice is { } imageNotice)
{
    <p class="voice-notice" role="alert">
        <span>@imageNotice</span>
        <button type="button" class="cot-x" @onclick="Images.DismissNotice" aria-label="Cerrar aviso"><Icon Name="close" Size="16" /></button>
    </p>
}
@if (Images.State != ImageUploadState.Idle)
{
    <ImageDraft State="Images.State" PreviewUrl="@Images.PreviewUrl" OnCancel="Images.Cancel" OnSend="() => Images.SendAsync(UserId)" />
}

<form class="chat-input @(Draft.Length > 0 ? "has-text" : null)" @ref="form" @onsubmit="SubmitAsync">
    <EmotePicker Query="@Draft.EmoteQuery" OnPick="emote => Editor.InsertEmoteAsync(emote, false)"
                 OnComplete="emote => Editor.InsertEmoteAsync(emote, true)" />
    @* Sin "capture": en el celular deja elegir cámara o galería *@
    <label class="chat-attach @(Images.State == ImageUploadState.Idle ? null : "off")" title="Adjuntar imagen">
        <Icon Name="image" Size="20" />
        <InputFile @key="Images.InputVersion" class="cot-file" accept="image/*" OnChange="e => Images.SelectAsync(e.File)"
                   disabled="@(Images.State != ImageUploadState.Idle)" aria-label="Adjuntar imagen" />
    </label>
    <div class="chat-field">
        <div class="cot-input chat-text" @ref="editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Mensaje"
             data-placeholder="Escribe un mensaje…" enterkeyhint="send" inputmode="text" autocapitalize="sentences" spellcheck="true"></div>
        @if (Draft.Length > 0)
        {
            <span class="chat-count @(Draft.IsNearLimit ? "warn" : null)" aria-live="polite">@Draft.Length/@Draft.MaxLength</span>
        }
        @if (Recorder.State != VoiceState.Idle)
        {
            <VoiceRecordingBar State="Recorder.State" Elapsed="Recorder.Elapsed" />
        }
    </div>
    @* mousedown sin acción: el cuadro no pierde el foco y el teclado del celular no se cierra *@
    <button type="submit" class="cot-btn chat-send" disabled="@(!Draft.CanSend)" aria-label="Enviar" @onmousedown:preventDefault>
        <Icon Name="arrow" Size="20" Class="arr" />
    </button>
    @* Un solo botón: voice.js le engancha el toque una vez *@
    <button type="button" class="cot-btn voice-mic @(Recording ? "on" : null)" disabled="@(Recorder.State == VoiceState.Sending)"
            aria-label="@(Recording ? "Detener y enviar la nota de voz" : "Grabar una nota de voz")">
        @if (Recording)
        {
            <span class="voice-mic-time">@VoiceFormat.Duration(Recorder.Elapsed)</span>
        }
        else
        {
            <Icon Name="mic" Size="20" />
        }
    </button>
</form>

@code {
    [Parameter, EditorRequired] public MessageDraft Draft { get; set; } = default!;
    [Parameter, EditorRequired] public string UserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSend { get; set; }
    [Parameter] public EventCallback OnTyping { get; set; }

    private ElementReference form;
    private ElementReference editor;

    private bool Recording => Recorder.State == VoiceState.Recording;

    protected override void OnInitialized()
    {
        Recorder.Changed += OnRecorderChanged;
        Editor.Changed += OnEditorChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Recorder.AttachAsync(form, UserId);
        await Editor.AttachAsync(editor, Draft);
    }

    // Se vacía el cuadro antes de enviar: lo que se escriba mientras sale el mensaje no se pierde
    private async Task SubmitAsync()
    {
        if (!Draft.CanSend || !OnSend.HasDelegate) return;

        await Editor.ClearAsync();
        await OnSend.InvokeAsync();
    }

    private void OnRecorderChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnEditorChanged() => _ = InvokeAsync(async () =>
    {
        await OnTyping.InvokeAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Recorder.Changed -= OnRecorderChanged;
        Editor.Changed -= OnEditorChanged;
        await Recorder.DetachAsync();
        await Editor.DetachAsync();
    }
}
