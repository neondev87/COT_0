<?xml version="1.0" encoding="utf-8"?>
<!-- Recursos de toda la app: paleta de COT_0, fuentes, textos y estilos (antes en Themes/*.xaml del WPF) -->
<Application x:Class="COT_0.HostWinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Textos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Paleta base -->
            <Color x:Key="AccentColor">#B3122E</Color>
            <Color x:Key="TransparentAccentColor">#00B3122E</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#A5290B11"/>
            <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="LightBrush" Color="#E6E6E6"/>
            <SolidColorBrush x:Key="Light65Brush" Color="#A6E6E6E6"/>
            <SolidColorBrush x:Key="Light62Brush" Color="#9EE6E6E6"/>
            <SolidColorBrush x:Key="Light55Brush" Color="#8CE6E6E6"/>
            <SolidColorBrush x:Key="Light50Brush" Color="#80E6E6E6"/>
            <SolidColorBrush x:Key="Light40Brush" Color="#66E6E6E6"/>
            <SolidColorBrush x:Key="Light28Brush" Color="#47E6E6E6"/>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D0D0E"/>
            <SolidColorBrush x:Key="LoginBaseBrush" Color="#080808"/>
            <SolidColorBrush x:Key="InputBrush" Color="#09FFFFFF"/>
            <SolidColorBrush x:Key="InputFocusBrush" Color="#0EFFFFFF"/>
            <SolidColorBrush x:Key="ButtonBrush" Color="#8C0A0A0A"/>

            <LinearGradientBrush x:Key="AccentFadeInBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource TransparentAccentColor}" Offset="0"/>
                <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentFadeOutBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                <GradientStop Color="{StaticResource TransparentAccentColor}" Offset="1"/>
            </LinearGradientBrush>

            <!-- Fondo del login: degradado, placa detrás del formulario, viñeta, niebla y barrido -->
            <RadialGradientBrush x:Key="LoginBackgroundBrush" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.8" RadiusY="0.75">
                <GradientStop Color="#1B1B1C" Offset="0"/>
                <GradientStop Color="#0F0F10" Offset="0.52"/>
                <GradientStop Color="#070707" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="LoginShadeBrush" Color="#59060606"/>
            <RadialGradientBrush x:Key="LoginPlateBrush" RadiusX="0.34" RadiusY="0.52">
                <GradientStop Color="#D1060606" Offset="0"/>
                <GradientStop Color="#8C060606" Offset="0.55"/>
                <GradientStop Color="#00060606" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="VignetteBrush" RadiusX="0.75" RadiusY="0.75">
                <GradientStop Color="#00000000" Offset="0.4"/>
                <GradientStop Color="#CC000000" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FogABrush">
                <GradientStop Color="#17787879" Offset="0"/>
                <GradientStop Color="#00787879" Offset="0.7"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FogBBrush">
                <GradientStop Color="#14646466" Offset="0"/>
                <GradientStop Color="#00646466" Offset="0.7"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00FFFFFF" Offset="0"/>
                <GradientStop Color="#04FFFFFF" Offset="0.5"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <!-- Fuentes (TTF en Assets/Fuentes) -->
            <FontFamily x:Key="FontBarlow">ms-appx:///Assets/Fuentes/Barlow-400.ttf#Barlow</FontFamily>
            <FontFamily x:Key="FontBarlowMedium">ms-appx:///Assets/Fuentes/Barlow-500.ttf#Barlow Medium</FontFamily>
            <FontFamily x:Key="FontCondensedMedium">ms-appx:///Assets/Fuentes/BarlowCondensed-500.ttf#Barlow Condensed Medium</FontFamily>
            <FontFamily x:Key="FontCinzel">ms-appx:///Assets/Fuentes/Cinzel-700.ttf#Cinzel</FontFamily>

            <!-- Medidas del login -->
            <x:Double x:Key="LoginFormWidth">360</x:Double>
            <x:Double x:Key="InputHeight">46</x:Double>
            <x:Double x:Key="ButtonHeight">48</x:Double>
            <x:Double x:Key="LoginImageOpacity">0.375</x:Double>

            <!-- Campos de texto: fondo tenue y línea inferior que pasa al acento con el foco -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="InputBrush"/>
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InputBrush"/>
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InputFocusBrush"/>
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Light28Brush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush"/>
            <StaticResource x:Key="TextControlForeground" ResourceKey="LightBrush"/>
            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="LightBrush"/>
            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="LightBrush"/>
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="Light40Brush"/>
            <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="AccentBrush"/>
            <Thickness x:Key="TextControlBorderThemeThickness">0,0,0,1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,1</Thickness>

            <Style x:Key="LoginFieldStyle" TargetType="Control">
                <Setter Property="Height" Value="{StaticResource InputHeight}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontBarlow}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="14,12,14,0"/>
            </Style>
            <Style x:Key="LoginTextBox" TargetType="TextBox" BasedOn="{StaticResource LoginFieldStyle}"/>
            <Style x:Key="LoginPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource LoginFieldStyle}">
                <Setter Property="PasswordRevealMode" Value="Hidden"/>
            </Style>

            <!-- Textos con espaciado (CharacterSpacing va en milésimas de em) -->
            <Style x:Key="LoginTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontCinzel}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="76"/>
                <Setter Property="LineHeight" Value="76"/>
                <Setter Property="CharacterSpacing" Value="80"/>
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
            </Style>
            <Style x:Key="FieldLabelText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CharacterSpacing" Value="320"/>
                <Setter Property="Foreground" Value="{StaticResource Light65Brush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="FooterText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CharacterSpacing" Value="300"/>
                <Setter Property="Foreground" Value="{StaticResource Light55Brush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ENTRAR: borde claro; con el mouse encima aparece la capa de acento y la flecha avanza 4 px -->
            <Style x:Key="LoginButton" TargetType="Button">
                <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <Border Background="{StaticResource ButtonBrush}" BorderBrush="{StaticResource Light50Brush}" BorderThickness="1" CornerRadius="2"/>
                                <Border x:Name="Hover" Background="{StaticResource AccentHoverBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="2" Opacity="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{StaticResource FontBarlowMedium}" FontSize="14" CharacterSpacing="280"
                                               VerticalAlignment="Center"/>
                                    <Path x:Name="Arrow" Data="M4,12 H19 M14,7 L19,12 L14,17" Width="20" Height="20" Margin="14,0,0,0"
                                          Stretch="None" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                        <Path.RenderTransform>
                                            <TranslateTransform x:Name="ArrowShift"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.3"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="ArrowShift.X" Value="4"/>
                                                <Setter Target="Label.Foreground" Value="{StaticResource WhiteBrush}"/>
                                                <Setter Target="Arrow.Stroke" Value="{StaticResource WhiteBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="ArrowShift.X" Value="4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.6"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rombo separador del pie -->
            <Style x:Key="Diamond" TargetType="Rectangle">
                <Setter Property="Width" Value="4"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Margin" Value="10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="45"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
