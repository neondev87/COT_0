{
  "Window": {
    "Width": 1280,
    "Height": 720
  },
  "Storage": {
    "Folder": "COT_0",
    "UsersFile": "usuarios.json",
    "VisitsFile": "visitas.json",
    "SessionsFile": "sesiones.json"
  },
  "Security": {
    "SaltBytes": 16,
    "HashBytes": 32,
    "HashIterations": 100000
  },
  "Validation": {
    "MaxUserLength": 24,
    "MaxPasswordLength": 64,
    "MaxAnswerLength": 64
  },
  "Recovery": {
    "QuestionKeys": [
      "Text.Question.Fruit",
      "Text.Question.Pet",
      "Text.Question.City",
      "Text.Question.Teacher",
      "Text.Question.Anime",
      "Text.Question.Song"
    ]
  },
  "Ui": {
    "Culture": "es-MX",
    "ClockFormat": "HH:mm",
    "SecondsFormat": "ss",
    "DateFormat": "dddd · dd MMMM yyyy",
    "ElapsedFormat": "{0:00}:{1:00}:{2:00}",
    "CopyFeedbackMilliseconds": 1600
  },
  "Paths": {
    "MediaRoot": "C:\\Users\\neonpc\\Documents\\COT_0_P"
  },
  "Audio": {
    "MusicFolder": "musica",
    "Extensions": [ ".mp3", ".wav", ".m4a", ".aac", ".wma" ],
    "DefaultFile": "",
    "DefaultVolume": 25,
    "CoversFolder": "portadas",
    "CoverExtensions": [ ".jpg", ".png", ".webp" ],
    "CoverDecodeSize": 96,
    "DurationFormat": "m\\:ss"
  },
  "Links": {
    "GitHub": "https://github.com/neondev87/COT_0"
  },
  "Tunnel": {
    "CloudflaredPath": "cloudflared",
    "StartTimeoutSeconds": 30
  },
  "Qr": {
    "PixelsPerModule": 20,
    "DarkColor": "#15121B",
    "LightColor": "#00000000"
  },
  "Web": {
    "JoinPath": "/join",
    "Url": "http://localhost:5050"
  },
  "Chat": {
    "HubPath": "/chathub",
    "AvatarsPath": "/avatars",
    "FlagsFolder": "img/flags",
    "FlagExtension": ".png",
    "MaxNameLength": 24,
    "MaxMessageLength": 500,
    "HistorySize": 200,
    "MessagesOnJoin": 100,
    "TimeFormat": "HH:mm",
    "PhotoSize": 256,
    "PhotoFormat": "image/jpeg",
    "MaxPhotoBytes": 1048576,
    "GuestStorageKey": "cot0.guest",
    "EmoteRequestTimeoutSeconds": 90
  },
  "GuestManual": {
    "AssetsFolder": "manual"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
