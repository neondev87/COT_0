<?xml version="1.0" encoding="utf-8"?>
<!-- Música: a la izquierda la canción que suena con sus controles; a la derecha la biblioteca. Errores en InfoBar -->
<Page x:Class="COT_0.HostWinUI.Views.Pantallas.MusicaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes"
      xmlns:vm="using:COT_0.HostWinUI.Views.ModelosDeVista"
      Background="{StaticResource WindowBackgroundBrush}">

    <Page.Resources>
        <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="RowHoverBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="RowHoverBrush"/>
    </Page.Resources>

    <Grid Margin="64,52,64,48" ColumnSpacing="48" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <componentes:EncabezadoPantalla Grid.ColumnSpan="2" Title="{StaticResource Text.Music.ScreenTitle}"/>

        <InfoBar Grid.Row="1" Grid.ColumnSpan="2" Severity="Warning" Title="{StaticResource Text.Music.ErrorTitle}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"/>

        <!-- Canción actual -->
        <StackPanel Grid.Row="2">
            <!-- Portada: el recuadro toma el tamaño de la imagen (Uniform, sin recorte ni marco de más). Sin portada, recuadro con nota -->
            <Border Width="300" Height="300" CornerRadius="4" Background="{StaticResource AvatarTone1Brush}" HorizontalAlignment="Left"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.IsCoverMissing, Mode=OneWay}">
                <FontIcon Glyph="&#xE8D6;" FontFamily="{StaticResource FontIcons}" FontSize="48" Foreground="{StaticResource Light28Brush}"/>
            </Border>
            <Border CornerRadius="4" HorizontalAlignment="Left" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.HasCover, Mode=OneWay}">
                <Image Source="{x:Bind ViewModel.CurrentCover.Image, Mode=OneWay}" Stretch="Uniform"
                       Width="{x:Bind ViewModel.CurrentCover.Width, Mode=OneWay}" Height="{x:Bind ViewModel.CurrentCover.Height, Mode=OneWay}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" Margin="0,18,0,0" TextTrimming="CharacterEllipsis"
                       FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold" FontSize="24" Foreground="{StaticResource TextBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="-10,12,0,0">
                <Button Style="{StaticResource TextButton}" Command="{x:Bind ViewModel.PreviousCommand}"
                        ToolTipService.ToolTip="{StaticResource Text.Music.Previous}" AutomationProperties.Name="{StaticResource Text.Music.Previous}">
                    <FontIcon Glyph="&#xE892;" FontFamily="{StaticResource FontIcons}" FontSize="18"/>
                </Button>
                <Button Style="{StaticResource TextButton}" Command="{x:Bind ViewModel.TogglePlayCommand}" Padding="14,0"
                        ToolTipService.ToolTip="{StaticResource Text.Music.PlayPause}" AutomationProperties.Name="{StaticResource Text.Music.PlayPause}">
                    <FontIcon Glyph="{x:Bind componentes:MusicGlyphs.PlayPause(ViewModel.IsPlaying), Mode=OneWay}"
                              FontFamily="{StaticResource FontIcons}" FontSize="26" Foreground="{StaticResource LightBrush}"/>
                </Button>
                <Button Style="{StaticResource TextButton}" Command="{x:Bind ViewModel.NextCommand}"
                        ToolTipService.ToolTip="{StaticResource Text.Music.Next}" AutomationProperties.Name="{StaticResource Text.Music.Next}">
                    <FontIcon Glyph="&#xE893;" FontFamily="{StaticResource FontIcons}" FontSize="18"/>
                </Button>
            </StackPanel>
            <componentes:ControlVolumen ViewModel="{x:Bind ViewModel}" Margin="-10,8,0,0"/>
        </StackPanel>

        <!-- Biblioteca -->
        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Songs}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSongClick"
                          ItemContainerStyle="{StaticResource FlatListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongRowViewModel">
                            <Grid Height="56" Padding="0,0,20,0" ColumnSpacing="14" BorderBrush="{StaticResource RowBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Barra de acento en la que suena -->
                                <Rectangle Fill="{StaticResource AccentBrush}" Visibility="{x:Bind IsPlaying, Mode=OneWay}"/>
                                <!-- Miniatura entera (Uniform): sin estirar ni recortar; si no es cuadrada sobra fondo -->
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="4" Background="{StaticResource AvatarTone2Brush}">
                                    <Image Source="{x:Bind Cover}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{x:Bind Title}" Style="{StaticResource RowNameText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind Duration}" Style="{StaticResource InterText}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
