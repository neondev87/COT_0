<?xml version="1.0" encoding="utf-8"?>
<!-- Login del host: mismo look que el WPF (fondo ASCII con niebla, título Cinzel, campos con línea de acento) -->
<Page x:Class="COT_0.HostWinUI.Views.Pantallas.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource LoginBaseBrush}">

    <Page.Resources>
        <!-- Cursor "_" parpadeando a saltos -->
        <Storyboard x:Name="BlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleCursor" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Fondo vivo: la imagen flota, la niebla va y viene y una franja de luz baja -->
        <Storyboard x:Name="AmbientStoryboard">
            <DoubleAnimation Storyboard.TargetName="Float" Storyboard.TargetProperty="Y" From="0" To="-6"
                             Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FogA" Storyboard.TargetProperty="X" From="-80" To="90"
                             Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FogB" Storyboard.TargetProperty="X" From="70" To="-100"
                             Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Y" From="-140" To="860"
                             Duration="0:0:8" RepeatBehavior="Forever"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Fondo -->
        <Grid Background="{StaticResource LoginBackgroundBrush}" IsHitTestVisible="False">
            <Image Source="ms-appx:///Assets/Imagenes/ascii-bg.png" Stretch="UniformToFill" Opacity="{StaticResource LoginImageOpacity}">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Float"/>
                </Image.RenderTransform>
            </Image>
            <Rectangle Fill="{StaticResource LoginShadeBrush}"/>
            <Rectangle Fill="{StaticResource LoginPlateBrush}"/>
            <Canvas>
                <Ellipse Canvas.Left="-200" Canvas.Top="460" Width="1100" Height="380" Fill="{StaticResource FogABrush}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="FogA"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="420" Canvas.Top="460" Width="1100" Height="420" Fill="{StaticResource FogBBrush}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="FogB"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
            <Rectangle Fill="{StaticResource VignetteBrush}"/>
            <Rectangle Height="120" VerticalAlignment="Top" Fill="{StaticResource SweepBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="Sweep"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!-- Formulario centrado; cada bloque entra subiendo 18 px, uno tras otro -->
        <StackPanel Width="{StaticResource LoginFormWidth}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="18" IsStaggeringEnabled="True"/>
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel Margin="0,0,0,44">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{StaticResource Text.Login.TitleStart}" Style="{StaticResource LoginTitleText}"/>
                    <TextBlock x:Name="TitleCursor" Text="{StaticResource Text.Login.TitleCursor}" Style="{StaticResource LoginTitleText}"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{StaticResource Text.Login.TitleEnd}" Style="{StaticResource LoginTitleText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Rectangle Width="34" Height="1" Fill="{StaticResource AccentFadeInBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}" Margin="14,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontCondensedMedium}" FontSize="13" CharacterSpacing="500"
                               Foreground="{StaticResource Light62Brush}"/>
                    <Rectangle Width="34" Height="1" Fill="{StaticResource AccentFadeOutBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{StaticResource Text.Login.User}" Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="UserBox" Style="{StaticResource LoginTextBox}" PlaceholderText="{StaticResource Text.Login.UserPlaceholder}"
                         Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{StaticResource Text.Login.Password}" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox Style="{StaticResource LoginPasswordBox}" PlaceholderText="{StaticResource Text.Login.PasswordPlaceholder}"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Errores de validación o de login -->
            <InfoBar Severity="Error" Margin="0,16,0,0" Title="{StaticResource Text.Login.ErrorTitle}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"/>

            <Button Style="{StaticResource LoginButton}" Margin="0,24,0,0" Content="{x:Bind ViewModel.ButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SubmitCommand}" KeyboardAcceleratorPlacementMode="Hidden">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter"/>
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>

        <!-- Pie -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30">
            <TextBlock Text="{StaticResource Text.Login.Footer}" Style="{StaticResource FooterText}"/>
            <Rectangle Style="{StaticResource Diamond}"/>
            <TextBlock Text="{StaticResource Text.App.Version}" Style="{StaticResource FooterText}"/>
        </StackPanel>
    </Grid>
</Page>
