<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio del host: reloj, estado de la sala, menú en diagonal (QR, fondo, manual, emotes, música, salir) y pie.
     Transparente: el fondo elegido (o el degradado del login) lo pinta CapaFondo detrás del Frame -->
<Page x:Class="COT_0.HostWinUI.Views.Pantallas.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Dashboard.xaml"/>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/TarjetaMenu.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <!-- Reloj -->
        <StackPanel Margin="44,34,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="0"/>
                </TransitionCollection>
            </StackPanel.Transitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Bind ViewModel.Time, Mode=OneWay}" Style="{StaticResource ClockText}"/>
                <TextBlock Text="{x:Bind ViewModel.Seconds, Mode=OneWay}" Style="{StaticResource ClockSecondsText}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="6,6,0,0">
                <Rectangle Width="28" Height="1" Fill="{StaticResource AccentBrush}" Opacity="0.8" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Date, Mode=OneWay}" Style="{StaticResource DateText}"/>
            </StackPanel>
        </StackPanel>

        <!-- Estado de la sala: activa (con pulso, lleva a la sala) o inactiva -->
        <StackPanel Margin="0,56,48,0" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="0"/>
                </TransitionCollection>
            </StackPanel.Transitions>
            <TextBlock Text="{StaticResource Text.Dashboard.Status}" Style="{StaticResource StatusLabelText}"/>
            <Button Style="{StaticResource PlainButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Visibility="{x:Bind ViewModel.IsRoomActive, Mode=OneWay}" Command="{x:Bind ViewModel.ShowRoomCommand}">
                <StackPanel Orientation="Horizontal">
                    <componentes:PuntoPulso VerticalAlignment="Center"/>
                    <TextBlock Text="{StaticResource Text.Dashboard.Active}" Style="{StaticResource StatusText}"/>
                    <TextBlock Text="{x:Bind ViewModel.ConnectedText, Mode=OneWay}" Style="{StaticResource ConnectedText}"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                        Visibility="{x:Bind ViewModel.IsRoomInactive, Mode=OneWay}">
                <Ellipse Width="9" Height="9" Stroke="{StaticResource Text55Brush}" StrokeThickness="1" VerticalAlignment="Center"/>
                <TextBlock Text="{StaticResource Text.Dashboard.Inactive}" Style="{StaticResource StatusText}"
                           Margin="12,0,0,0" Foreground="{StaticResource Text70Brush}"/>
            </StackPanel>
            <Rectangle Width="180" Height="1" Margin="0,10,0,0" HorizontalAlignment="Right" Fill="{StaticResource AccentFadeInBrush}"/>
            <!-- Firma Neondev (logo con brillo de vidrio + volumen), un poco abajo del estado de la SALA -->
            <componentes:Firma Margin="0,28,0,0" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Menú en diagonal: cada tarjeta 26 px más a la derecha; entran desde la izquierda una tras otra -->
        <StackPanel Margin="44,0,0,38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="-120" FromVerticalOffset="0" IsStaggeringEnabled="True"/>
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <componentes:TarjetaMenu Style="{StaticResource TarjetaMenuStyle}" Number="01"
                                     Content="{x:Bind ViewModel.QrTitle, Mode=OneWay}" Subtitle="{x:Bind ViewModel.QrSubtitle, Mode=OneWay}"
                                     Icon="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H17 V17 H14 Z M20,14 V14.01 M14,20 H14.01 M17,20 H21 V17"
                                     Command="{x:Bind ViewModel.ShowRoomCommand}"/>
            <componentes:TarjetaMenu Style="{StaticResource TarjetaMenuStyle}" Number="02" Margin="26,0,0,0" Command="{x:Bind ViewModel.ShowBackgroundsCommand}"
                                     Content="{StaticResource Text.Dashboard.BackgroundTitle}" Subtitle="{StaticResource Text.Dashboard.BackgroundSubtitle}"
                                     Icon="M4,4 H20 A1,1 0 0 1 21,5 V19 A1,1 0 0 1 20,20 H4 A1,1 0 0 1 3,19 V5 A1,1 0 0 1 4,4 Z M7.4,9.5 A1.6,1.6 0 1 0 10.6,9.5 A1.6,1.6 0 1 0 7.4,9.5 Z M21,16 L15.5,10.5 L5,20"/>
            <componentes:TarjetaMenu Style="{StaticResource TarjetaMenuStyle}" Number="03" Margin="52,0,0,0"
                                     Content="{StaticResource Text.Dashboard.ManualTitle}" Subtitle="{StaticResource Text.Dashboard.ManualSubtitle}"
                                     Icon="M4,4.5 A1.5,1.5 0 0 1 5.5,3 H20 V18 H5.5 A1.5,1.5 0 0 0 4,19.5 Z M4,19.5 A1.5,1.5 0 0 0 5.5,21 H20 M9,8 H16 M9,11 H14"
                                     Command="{x:Bind ViewModel.ShowManualCommand}"/>
            <componentes:TarjetaMenu Style="{StaticResource TarjetaMenuStyle}" Number="04" Margin="78,0,0,0"
                                     Content="{StaticResource Text.Dashboard.EmotesTitle}" Subtitle="{StaticResource Text.Dashboard.EmotesSubtitle}"
                                     Icon="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z M8.5,14 C9.5,15.6 14.5,15.6 15.5,14 M9,9.5 V10 M15,9.5 V10"
                                     Command="{x:Bind ViewModel.ShowEmotesCommand}"/>
            <componentes:TarjetaMenu Style="{StaticResource TarjetaMenuStyle}" Number="05" Margin="104,0,0,0"
                                     Content="{StaticResource Text.Dashboard.MusicTitle}" Subtitle="{StaticResource Text.Dashboard.MusicSubtitle}"
                                     Icon="M9,18 V5 L20,3 V16 M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 Z M20,16 A3,3 0 1 1 14,16 A3,3 0 1 1 20,16 Z"
                                     Command="{x:Bind ViewModel.ShowMusicCommand}"/>
            <componentes:TarjetaMenu Style="{StaticResource TarjetaMenuStyle}" Number="06" Margin="130,0,0,0"
                                     Content="{StaticResource Text.Dashboard.ExitTitle}" Subtitle="{StaticResource Text.Dashboard.ExitSubtitle}"
                                     Icon="M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9"
                                     Command="{x:Bind ViewModel.LogoutCommand}"/>
        </StackPanel>

        <!-- Pie -->
        <StackPanel Orientation="Horizontal" Margin="0,0,48,34" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="{StaticResource Text.Dashboard.Footer}" Style="{StaticResource FooterText}" Foreground="{StaticResource Text55Brush}"/>
            <Rectangle Style="{StaticResource Diamond}"/>
            <TextBlock Text="{StaticResource Text.App.Version}" Style="{StaticResource FooterText}" Foreground="{StaticResource Text55Brush}"/>
        </StackPanel>
    </Grid>
</Page>
