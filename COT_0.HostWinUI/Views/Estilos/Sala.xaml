<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de la sala (antes Themes/Room.xaml del WPF). Se mezcla en SalaPage -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="QrPanelSize">420</x:Double>
    <x:Double x:Key="QrSize">340</x:Double>
    <!-- CERRAR SALA mide 156 px con su icono: 196 deja 20 px por lado. Con 1280 px de ventana el aviso queda con ~112 px (2 líneas) -->
    <GridLength x:Key="CloseRoomWidth">196</GridLength>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>
    <SolidColorBrush x:Key="UrlFieldBrush" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="Text25Brush" Color="#40ECEAF0"/>

    <Style x:Key="QrMarkText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCinzel}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="17"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Text62Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SmallLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="CharacterSpacing" Value="320"/>
        <Setter Property="Foreground" Value="{StaticResource Text55Brush}"/>
    </Style>
    <Style x:Key="LiveText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedMedium}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CharacterSpacing" Value="320"/>
        <Setter Property="Foreground" Value="{StaticResource Text70Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CountText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedExtraLight}"/>
        <Setter Property="FontSize" Value="120"/>
        <Setter Property="LineHeight" Value="98"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="CountLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontCondensedLight}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBarlow}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource Text58Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
