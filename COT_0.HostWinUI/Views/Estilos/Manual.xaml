<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos del manual de Lain (antes Themes/Manual.xaml y ManualFx.xaml del WPF). Se mezcla en ManualPage.
     Paleta del video de Lain: negros azulados y verde azulado apagado. Solo opacidad y traslación animadas -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes">

    <SolidColorBrush x:Key="ManualMarkBrush" Color="#9CD6D5"/>
    <SolidColorBrush x:Key="ManualPanelBrush" Color="#D1091622"/>
    <SolidColorBrush x:Key="ManualBorderBrush" Color="#149CD6D5"/>
    <SolidColorBrush x:Key="ManualText2Brush" Color="#A6D6ECEC"/>
    <SolidColorBrush x:Key="ManualButtonBrush" Color="#149CD6D5"/>
    <SolidColorBrush x:Key="KeycapBrush" Color="#0F9CD6D5"/>
    <SolidColorBrush x:Key="KeycapEdgeBrush" Color="#389CD6D5"/>
    <!-- Destello de la señal al cambiar de paso (reemplaza SignalLossLayer) -->
    <SolidColorBrush x:Key="SignalFlashBrush" Color="#2EBEE6E6"/>
    <RadialGradientBrush x:Key="ManualBaseBrush" Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#0E2733" Offset="0"/>
        <GradientStop Color="#08172F" Offset="0.52"/>
        <GradientStop Color="#040C1A" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ManualSweepBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#009CD6D5" Offset="0"/>
        <GradientStop Color="#0C9CD6D5" Offset="0.5"/>
        <GradientStop Color="#009CD6D5" Offset="1"/>
    </LinearGradientBrush>
    <!-- Borde superior del video que se funde con el fondo (en vez de la OpacityMask del WPF) -->
    <LinearGradientBrush x:Key="LainFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF08172F" Offset="0"/>
        <GradientStop Color="#0008172F" Offset="1"/>
    </LinearGradientBrush>

    <x:Double x:Key="ManualColumnWidth">330</x:Double>
    <x:Double x:Key="LainVideoOpacity">0.9</x:Double>
    <x:Double x:Key="FarewellVideoOpacity">0.45</x:Double>

    <Style x:Key="ManualHeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInterMedium}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ManualStepTitleText" TargetType="TextBlock" BasedOn="{StaticResource ManualHeadingText}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
    <Style x:Key="ManualStepText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource ManualText2Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ManualStepNumberText" TargetType="TextBlock" BasedOn="{StaticResource ManualStepText}">
        <Setter Property="FontFamily" Value="{StaticResource FontInterMedium}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- BotonManual: atajo (keycap + acción) o botón redondeado. Sin tabulación: ENTER siempre es "empezar" -->
    <Style x:Key="BotonManualStyle" TargetType="componentes:BotonManual">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ManualText2Brush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="componentes:BotonManual">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="Key" MinWidth="28" Padding="8,5" CornerRadius="4" Background="{StaticResource KeycapBrush}"
                                    BorderBrush="{StaticResource KeycapEdgeBrush}" BorderThickness="0,0,0,2">
                                <TextBlock Text="{TemplateBinding KeyText}" TextAlignment="Center" FontFamily="{StaticResource FontInterMedium}"
                                           FontSize="12" Foreground="{StaticResource LightBrush}"/>
                            </Border>
                            <ContentPresenter x:Name="Content" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource ManualMarkBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.35"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ManualKeycap" TargetType="componentes:BotonManual" BasedOn="{StaticResource BotonManualStyle}">
        <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>
    <Style x:Key="ManualButton" TargetType="componentes:BotonManual" BasedOn="{StaticResource BotonManualStyle}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInterMedium}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource LightBrush}"/>
        <Setter Property="Background" Value="{StaticResource ManualButtonBrush}"/>
    </Style>
    <Style x:Key="ManualSmallButton" TargetType="componentes:BotonManual" BasedOn="{StaticResource ManualButton}">
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
</ResourceDictionary>
