<?xml version="1.0" encoding="utf-8"?>
<!-- Textos visibles de la app (español de México, con "tú"). Se usan con {StaticResource} -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:String x:Key="Text.App.Name">COT_0</x:String>
    <x:String x:Key="Text.App.Version">v0.1</x:String>

    <!-- Login -->
    <x:String x:Key="Text.Login.TitleStart">COT</x:String>
    <x:String x:Key="Text.Login.TitleCursor">_</x:String>
    <x:String x:Key="Text.Login.TitleEnd">0</x:String>
    <x:String x:Key="Text.Login.Subtitle">ACCESO DEL HOST</x:String>
    <x:String x:Key="Text.Login.SubtitleRegister">CREA TU CUENTA DE HOST</x:String>
    <x:String x:Key="Text.Login.User">USUARIO</x:String>
    <x:String x:Key="Text.Login.UserPlaceholder">nombre del host</x:String>
    <x:String x:Key="Text.Login.Password">CONTRASEÑA</x:String>
    <x:String x:Key="Text.Login.PasswordPlaceholder">••••••••</x:String>
    <x:String x:Key="Text.Login.Enter">ENTRAR</x:String>
    <x:String x:Key="Text.Login.Register">REGISTRARME</x:String>
    <x:String x:Key="Text.Login.Footer">SALAS DE CHAT POR QR</x:String>
    <x:String x:Key="Text.Login.ErrorTitle">Revisa tus datos</x:String>

    <!-- Mensajes del login -->
    <x:String x:Key="Text.Error.UserEmpty">Escribe tu usuario.</x:String>
    <x:String x:Key="Text.Error.UserInvalid">Tu usuario solo puede tener letras y números, sin espacios ni símbolos.</x:String>
    <x:String x:Key="Text.Error.UserTooLong">Tu usuario es demasiado largo.</x:String>
    <x:String x:Key="Text.Error.PasswordEmpty">Escribe tu contraseña.</x:String>
    <x:String x:Key="Text.Error.PasswordInvalid">Tu contraseña solo puede tener letras y números, sin espacios ni símbolos.</x:String>
    <x:String x:Key="Text.Error.PasswordTooLong">Tu contraseña es demasiado larga.</x:String>
    <x:String x:Key="Text.Error.WrongCredentials">Usuario o contraseña incorrectos.</x:String>
    <x:String x:Key="Text.Error.UserTaken">Ese usuario ya existe. Elige otro.</x:String>
    <x:String x:Key="Text.Error.Storage">No se pudo leer o guardar tu cuenta. Inténtalo de nuevo.</x:String>

    <!-- Pantallas pendientes de migrar -->
    <x:String x:Key="Text.Pending">Pantalla en migración a WinUI 3.</x:String>
</ResourceDictionary>
