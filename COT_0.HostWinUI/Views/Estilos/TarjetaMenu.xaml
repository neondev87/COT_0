<?xml version="1.0" encoding="utf-8"?>
<!-- Estilo de TarjetaMenu: paralelogramo claro de 340×58; con el mouse pasa al acento y se corre 18 px (sin sombra) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes">

    <x:Double x:Key="MenuCardWidth">340</x:Double>
    <x:Double x:Key="MenuCardHeight">58</x:Double>
    <x:Double x:Key="MenuCardHoverShift">18</x:Double>

    <Style x:Key="TarjetaMenuStyle" TargetType="componentes:TarjetaMenu">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="componentes:TarjetaMenu">
                    <Grid x:Name="Root" Width="{StaticResource MenuCardWidth}" Height="{StaticResource MenuCardHeight}" Background="Transparent">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Shift"/>
                        </Grid.RenderTransform>

                        <!-- Forma inclinada con Path (en WinUI el Clip solo acepta rectángulos) -->
                        <Path Data="M16,0 L340,0 L324,58 L0,58 Z" Fill="{StaticResource CardFaceBrush}"/>
                        <Path x:Name="Hover" Data="M16,0 L340,0 L324,58 L0,58 Z" Fill="{StaticResource AccentBrush}" Opacity="0"/>

                        <Grid Margin="26,0,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Num" Text="{TemplateBinding Number}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontCondensedExtraBold}" FontStyle="Italic" FontWeight="ExtraBold"
                                       FontSize="38" LineHeight="38" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Title" Text="{TemplateBinding Content}" LineHeight="21"
                                           FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold" FontSize="21" CharacterSpacing="70"
                                           Foreground="{StaticResource DarkInkBrush}"/>
                                <TextBlock x:Name="Sub" Text="{TemplateBinding Subtitle}" Margin="0,3,0,0"
                                           FontFamily="{StaticResource FontBarlow}" FontSize="11" CharacterSpacing="40"
                                           Foreground="{StaticResource CardSubBrush}"/>
                            </StackPanel>
                            <Viewbox Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center">
                                <Path x:Name="Icon" Width="24" Height="24" Stretch="None" Stroke="{StaticResource DarkInkBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.35">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Shift.X" Value="{StaticResource MenuCardHoverShift}"/>
                                        <Setter Target="Hover.Opacity" Value="1"/>
                                        <Setter Target="Num.Foreground" Value="{StaticResource WhiteBrush}"/>
                                        <Setter Target="Title.Foreground" Value="{StaticResource WhiteBrush}"/>
                                        <Setter Target="Sub.Foreground" Value="{StaticResource WhiteSubBrush}"/>
                                        <Setter Target="Icon.Stroke" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Shift.X" Value="{StaticResource MenuCardHoverShift}"/>
                                        <Setter Target="Hover.Opacity" Value="1"/>
                                        <Setter Target="Num.Foreground" Value="{StaticResource WhiteBrush}"/>
                                        <Setter Target="Title.Foreground" Value="{StaticResource WhiteBrush}"/>
                                        <Setter Target="Sub.Foreground" Value="{StaticResource WhiteSubBrush}"/>
                                        <Setter Target="Icon.Stroke" Value="{StaticResource WhiteBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
