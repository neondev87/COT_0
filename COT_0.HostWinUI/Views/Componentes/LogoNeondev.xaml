<?xml version="1.0" encoding="utf-8"?>
<!-- Logo Neondev rescatado del SignatureBadge del WPF: avatar de 64 px con esquinas de 14, "Neondev" en Redaction 36
     y el brillo "aero" de vidrio que cruza el avatar (ida y vuelta, 3 s por lado). Clic: abre el repositorio (Branding:RepoUrl).
     Todo vive en la plantilla: el barrido corre en los estados Normal y PointerOver, así arranca solo sin código -->
<UserControl x:Class="COT_0.HostWinUI.Views.Componentes.LogoNeondev"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Colores del WPF: SignatureAvatarBrush, SignatureBorderBrush y SignatureBorderHoverBrush -->
        <SolidColorBrush x:Key="LogoAvatarBrush" Color="#1C1C24"/>
        <SolidColorBrush x:Key="LogoBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="LogoBorderHoverBrush" Color="#59FFFFFF"/>

        <!-- Mismo degradado que el AeroBrush del WPF; aquí se mueve el rectángulo (RenderTransform, en el compositor)
             en lugar de animar el RelativeTransform del pincel -->
        <LinearGradientBrush x:Key="LogoShineBrush" StartPoint="0,0" EndPoint="1,0.6">
            <GradientStop Color="#00FFFFFF" Offset="0.3"/>
            <GradientStop Color="#4DFFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        </LinearGradientBrush>

        <Style x:Key="LogoLink" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="64" Height="64">
                                <Border CornerRadius="14" Background="{StaticResource LogoAvatarBrush}"/>
                                <!-- Border con CornerRadius recorta a sus hijos: el brillo no se sale de las esquinas -->
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush ImageSource="ms-appx:///Assets/Imagenes/neondev-avatar.png" Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Rectangle x:Name="Shine" Width="64" Height="64" Fill="{StaticResource LogoShineBrush}" IsHitTestVisible="False">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="ShineShift" X="-64"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                                <Border x:Name="Frame" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource LogoBorderBrush}"/>
                            </Grid>
                            <TextBlock x:Name="Name" Text="{StaticResource Text.Signature.Name}" Margin="16,2,0,0" VerticalAlignment="Top"
                                       FontFamily="{StaticResource FontRedaction}" FontSize="36" LineHeight="36" CharacterSpacing="20"
                                       Foreground="{StaticResource LightBrush}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.2"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" From="-64" To="64"
                                                             Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <!-- Con el mouse (igual que el WPF): el borde del vidrio se aclara y el nombre pasa al acento.
                                         El WPF además le ponía un DropShadow de acento al nombre: se quitó (sombras caras) -->
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" From="-64" To="64"
                                                             Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Frame.BorderBrush" Value="{StaticResource LogoBorderHoverBrush}"/>
                                            <Setter Target="Name.Foreground" Value="{StaticResource AccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Frame.BorderBrush" Value="{StaticResource LogoBorderHoverBrush}"/>
                                            <Setter Target="Name.Foreground" Value="{StaticResource AccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Button Style="{StaticResource LogoLink}" Command="{x:Bind ViewModel.OpenRepoCommand}"
            ToolTipService.ToolTip="{StaticResource Text.Signature.Link}" AutomationProperties.Name="{StaticResource Text.Signature.Link}"/>
</UserControl>
