<?xml version="1.0" encoding="utf-8"?>
<!-- Pasos 3 y 4 del manual: réplica de la sala activa con un QR de adorno (no se puede escanear), enlace de muestra
     y la ListaConectados real con invitados ficticios. Paso 3: QR, enlace + COPIAR, EN VIVO. Paso 4: contador, lista, CERRAR SALA -->
<componentes:VistaEjemplo x:Class="COT_0.HostWinUI.Views.Componentes.VistaEjemploSala"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes">

    <componentes:VistaEjemplo.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Estilos/Sala.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </componentes:VistaEjemplo.Resources>

    <Grid Background="{StaticResource LoginBackgroundBrush}">
        <Grid Margin="64,52,64,0" VerticalAlignment="Top" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <componentes:EncabezadoEjemplo Title="{StaticResource Text.Room.Title}"/>
                <TextBlock Text="{x:Bind Demo.Code}" Style="{StaticResource MonoText}" Margin="28,0,0,0" CharacterSpacing="100" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <componentes:PuntoPulso VerticalAlignment="Center"/>
                    <TextBlock Text="{StaticResource Text.Room.Live}" Style="{StaticResource LiveText}" Margin="12,0"/>
                    <TextBlock Text="{x:Bind Demo.Elapsed}" Style="{StaticResource MonoText}" FontSize="14"/>
                </StackPanel>
                <componentes:ResaltadoManual Margin="-16,-12" Phase="{x:Bind Phase, Mode=OneWay}" Step="{x:Bind Step, Mode=OneWay}"
                                             OnlyInStep="3" From="5"/>
            </Grid>
        </Grid>

        <!-- Columna izquierda: QR de adorno + enlace -->
        <StackPanel Width="{StaticResource QrPanelSize}" Margin="64,124,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid Width="{StaticResource QrPanelSize}" Height="{StaticResource QrPanelSize}">
                <Path Data="M28,0 L420,0 L420,392 L392,420 L0,420 L0,28 Z" Fill="{StaticResource CardFaceBrush}"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1"/>
                <Path Width="{StaticResource QrSize}" Height="{StaticResource QrSize}" Stretch="Uniform" Fill="{StaticResource DarkInkBrush}"
                      Data="M0,0h7v1h-7zM8,0h2v1h-2zM11,0h1v1h-1zM13,0h2v1h-2zM16,0h1v1h-1zM18,0h7v1h-7zM0,1h1v1h-1zM6,1h1v1h-1zM8,1h4v1h-4zM13,1h2v1h-2zM18,1h1v1h-1zM24,1h1v1h-1zM0,2h1v1h-1zM2,2h3v1h-3zM6,2h1v1h-1zM9,2h1v1h-1zM11,2h1v1h-1zM13,2h4v1h-4zM18,2h1v1h-1zM20,2h3v1h-3zM24,2h1v1h-1zM0,3h1v1h-1zM2,3h3v1h-3zM6,3h1v1h-1zM9,3h1v1h-1zM12,3h1v1h-1zM14,3h3v1h-3zM18,3h1v1h-1zM20,3h3v1h-3zM24,3h1v1h-1zM0,4h1v1h-1zM2,4h3v1h-3zM6,4h1v1h-1zM9,4h2v1h-2zM12,4h2v1h-2zM16,4h1v1h-1zM18,4h1v1h-1zM20,4h3v1h-3zM24,4h1v1h-1zM0,5h1v1h-1zM6,5h1v1h-1zM12,5h1v1h-1zM14,5h2v1h-2zM18,5h1v1h-1zM24,5h1v1h-1zM0,6h7v1h-7zM8,6h1v1h-1zM10,6h1v1h-1zM15,6h1v1h-1zM18,6h7v1h-7zM10,7h1v1h-1zM13,7h1v1h-1zM15,7h1v1h-1zM3,8h2v1h-2zM6,8h5v1h-5zM12,8h3v1h-3zM16,8h2v1h-2zM22,8h3v1h-3zM2,9h4v1h-4zM8,9h4v1h-4zM18,9h1v1h-1zM23,9h2v1h-2zM0,10h1v1h-1zM2,10h11v1h-11zM15,10h5v1h-5zM22,10h1v1h-1zM24,10h1v1h-1zM0,11h3v1h-3zM4,11h2v1h-2zM8,11h1v1h-1zM10,11h1v1h-1zM15,11h3v1h-3zM21,11h2v1h-2zM4,12h1v1h-1zM6,12h5v1h-5zM13,12h1v1h-1zM17,12h5v1h-5zM0,13h1v1h-1zM3,13h1v1h-1zM8,13h2v1h-2zM11,13h1v1h-1zM14,13h2v1h-2zM18,13h3v1h-3zM23,13h1v1h-1zM2,14h1v1h-1zM4,14h2v1h-2zM10,14h1v1h-1zM13,14h4v1h-4zM18,14h3v1h-3zM22,14h2v1h-2zM1,15h1v1h-1zM6,15h4v1h-4zM11,15h2v1h-2zM15,15h1v1h-1zM19,15h1v1h-1zM21,15h2v1h-2zM3,16h1v1h-1zM8,16h1v1h-1zM10,16h1v1h-1zM15,16h1v1h-1zM19,16h6v1h-6zM11,17h1v1h-1zM14,17h1v1h-1zM17,17h1v1h-1zM19,17h1v1h-1zM23,17h2v1h-2zM0,18h7v1h-7zM9,18h3v1h-3zM13,18h1v1h-1zM15,18h3v1h-3zM20,18h1v1h-1zM24,18h1v1h-1zM0,19h1v1h-1zM6,19h1v1h-1zM8,19h2v1h-2zM11,19h3v1h-3zM16,19h2v1h-2zM21,19h2v1h-2zM24,19h1v1h-1zM0,20h1v1h-1zM2,20h3v1h-3zM6,20h1v1h-1zM8,20h1v1h-1zM12,20h1v1h-1zM14,20h1v1h-1zM16,20h2v1h-2zM20,20h2v1h-2zM23,20h2v1h-2zM0,21h1v1h-1zM2,21h3v1h-3zM6,21h1v1h-1zM8,21h5v1h-5zM14,21h1v1h-1zM16,21h5v1h-5zM23,21h2v1h-2zM0,22h1v1h-1zM2,22h3v1h-3zM6,22h1v1h-1zM9,22h1v1h-1zM11,22h1v1h-1zM14,22h1v1h-1zM18,22h1v1h-1zM22,22h3v1h-3zM0,23h1v1h-1zM6,23h1v1h-1zM8,23h2v1h-2zM11,23h3v1h-3zM17,23h7v1h-7zM0,24h7v1h-7zM10,24h1v1h-1zM12,24h5v1h-5zM18,24h1v1h-1zM20,24h5v1h-5z"/>
                <Border Width="66" Height="66" Background="{StaticResource DarkInkBrush}" BorderBrush="{StaticResource CardFaceBrush}"
                        BorderThickness="6" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource Text.Room.QrMarkStart}" Style="{StaticResource QrMarkText}" Foreground="{StaticResource CardFaceBrush}"/>
                    <TextBlock Text="{StaticResource Text.Room.QrMarkEnd}" Style="{StaticResource QrMarkText}" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <TextBlock Text="{StaticResource Text.Room.Scan}" Margin="0,14,18,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                           FontFamily="{StaticResource FontCondensedExtraBold}" FontWeight="ExtraBold" FontStyle="Italic"
                           FontSize="13" CharacterSpacing="200" Foreground="{StaticResource AccentBrush}"/>
                <componentes:ResaltadoManual Margin="-12" Phase="{x:Bind Phase, Mode=OneWay}" Step="{x:Bind Step, Mode=OneWay}"
                                             OnlyInStep="3" From="1" To="2"/>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Height="{StaticResource RoomFieldHeight}" Padding="16,0" Background="{StaticResource UrlFieldBrush}"
                        BorderBrush="{StaticResource Text25Brush}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource Text.Room.UrlLabel}" Style="{StaticResource SmallLabelText}"/>
                        <TextBlock Text="{x:Bind Demo.JoinUrl}" Margin="0,2,0,0" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource SolidButton}" Height="{StaticResource RoomFieldHeight}" Padding="22,0"
                        Content="{StaticResource Text.Room.Copy}" IsTabStop="False"/>
                <componentes:ResaltadoManual Grid.ColumnSpan="2" Margin="-10" Phase="{x:Bind Phase, Mode=OneWay}" Step="{x:Bind Step, Mode=OneWay}"
                                             OnlyInStep="3" From="3" To="4"/>
            </Grid>
        </StackPanel>

        <!-- Columna derecha: contador + lista + barra de abajo -->
        <Grid Margin="560,124,64,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Bind Demo.TotalText}" Style="{StaticResource CountText}"/>
                    <StackPanel Margin="18,0,0,8" VerticalAlignment="Bottom">
                        <Rectangle Width="32" Height="1" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{StaticResource Text.Room.Count}" Margin="0,8,0,0" Style="{StaticResource CountLabelText}"/>
                    </StackPanel>
                </StackPanel>
                <componentes:ResaltadoManual Margin="-14,-6" Phase="{x:Bind Phase, Mode=OneWay}" Step="{x:Bind Step, Mode=OneWay}"
                                             OnlyInStep="4" From="1" To="2"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18">
                <componentes:ListaConectados SampleUsers="{x:Bind Demo.Guests}" IsTabStop="False"/>
                <componentes:ResaltadoManual Margin="-8" Phase="{x:Bind Phase, Mode=OneWay}" Step="{x:Bind Step, Mode=OneWay}"
                                             OnlyInStep="4" From="3" To="4"/>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource CloseRoomWidth}"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="-8,0,0,0">
                    <Button Style="{StaticResource TextButton}" IsTabStop="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE76E;" FontFamily="{StaticResource FontIcons}" FontSize="14"/>
                            <TextBlock Text="{StaticResource Text.Room.Emotes}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TextButton}" IsTabStop="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontFamily="{StaticResource FontIcons}" FontSize="14"/>
                            <TextBlock Text="{StaticResource Text.Room.Music}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TextButton}" IsTabStop="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE91B;" FontFamily="{StaticResource FontIcons}" FontSize="14"/>
                            <TextBlock Text="{StaticResource Text.Room.Background}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{StaticResource Text.Room.CloseHint}" Style="{StaticResource HintText}"
                           HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="2">
                    <Button Style="{StaticResource ConfirmButton}" Content="{StaticResource Text.Room.Close}" Margin="0" IsTabStop="False"/>
                    <componentes:ResaltadoManual Margin="-8" Phase="{x:Bind Phase, Mode=OneWay}" Step="{x:Bind Step, Mode=OneWay}"
                                                 OnlyInStep="4" From="5"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</componentes:VistaEjemplo>
