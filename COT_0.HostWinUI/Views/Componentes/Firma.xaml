<?xml version="1.0" encoding="utf-8"?>
<!-- Firma Neondev (arriba a la derecha del login): LogoNeondev (abre el repo) y debajo la música que suena con su volumen -->
<UserControl x:Class="COT_0.HostWinUI.Views.Componentes.Firma"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes">

    <StackPanel>
        <!-- Avatar + nombre con el brillo de vidrio; abre el repositorio -->
        <componentes:LogoNeondev/>

        <!-- Música: misma instancia que MusicaPage; sin canciones solo queda el aviso -->
        <StackPanel Margin="70,-30,0,0" Visibility="{x:Bind ViewModel.IsMusicAvailable, Mode=OneWay}">
            <componentes:ControlVolumen ViewModel="{x:Bind ViewModel}"/>
            <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" Margin="10,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left" FontFamily="{StaticResource FontBarlow}" FontSize="12" Foreground="{StaticResource Light55Brush}"/>
        </StackPanel>
        <TextBlock Text="{StaticResource Text.Signature.NoMusic}" Margin="80,-22,0,0" Visibility="{x:Bind ViewModel.IsMusicMissing, Mode=OneWay}"
                   FontFamily="{StaticResource FontBarlow}" FontSize="12" Foreground="{StaticResource Light40Brush}"/>
    </StackPanel>
</UserControl>
