<?xml version="1.0" encoding="utf-8"?>
<!-- Firma Neondev (login, dashboard y sala): LogoNeondev (abre el repo) y debajo solo la barra de volumen de la música.
     La barra toma el ancho del logo; reproducir, siguiente y la lista viven en MusicaPage. Sin canciones queda el aviso -->
<UserControl x:Class="COT_0.HostWinUI.Views.Componentes.Firma"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes">

    <StackPanel>
        <componentes:LogoNeondev/>

        <!-- Mismo MusicService que MusicaPage: un solo volumen para las dos -->
        <Slider Style="{StaticResource VolumeSlider}" Width="Auto" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{StaticResource Text.Music.Volume}" ToolTipService.ToolTip="{StaticResource Text.Music.Volume}"
                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsMusicAvailable, Mode=OneWay}"/>
        <TextBlock Text="{StaticResource Text.Signature.NoMusic}" Margin="0,6,0,0" Visibility="{x:Bind ViewModel.IsMusicMissing, Mode=OneWay}"
                   FontFamily="{StaticResource FontBarlow}" FontSize="12" Foreground="{StaticResource Light40Brush}"/>
    </StackPanel>
</UserControl>
