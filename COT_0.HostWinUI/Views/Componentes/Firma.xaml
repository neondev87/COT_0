<?xml version="1.0" encoding="utf-8"?>
<!-- Firma Neondev (arriba a la derecha del login): avatar + nombre que abre el repo, y debajo la música que suena con su volumen -->
<UserControl x:Class="COT_0.HostWinUI.Views.Componentes.Firma"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes">

    <UserControl.Resources>
        <!-- Avatar y nombre: con el mouse el borde se aclara y el nombre pasa al acento (sin brillo ni DropShadow) -->
        <Style x:Key="SignatureLink" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="64" Height="64">
                                <Border CornerRadius="14" Background="{StaticResource AvatarTone3Brush}"/>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush ImageSource="ms-appx:///Assets/Imagenes/neondev-avatar.png" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Frame" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource AvatarBorderBrush}"/>
                            </Grid>
                            <TextBlock x:Name="Name" Text="{StaticResource Text.Signature.Name}" Margin="16,2,0,0" VerticalAlignment="Top"
                                       FontFamily="{StaticResource FontRedaction}" FontSize="36" LineHeight="36" CharacterSpacing="20"
                                       Foreground="{StaticResource LightBrush}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.2"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Frame.BorderBrush" Value="{StaticResource Light55Brush}"/>
                                            <Setter Target="Name.Foreground" Value="{StaticResource AccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Name.Foreground" Value="{StaticResource AccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Button Style="{StaticResource SignatureLink}" Command="{x:Bind ViewModel.OpenGitHubCommand}"
                ToolTipService.ToolTip="{StaticResource Text.Signature.Link}" AutomationProperties.Name="{StaticResource Text.Signature.Link}"/>

        <!-- Música: misma instancia que MusicaPage; sin canciones solo queda el aviso -->
        <StackPanel Margin="70,-30,0,0" Visibility="{x:Bind ViewModel.IsMusicAvailable, Mode=OneWay}">
            <componentes:ControlVolumen ViewModel="{x:Bind ViewModel}"/>
            <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" Margin="10,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left" FontFamily="{StaticResource FontBarlow}" FontSize="12" Foreground="{StaticResource Light55Brush}"/>
        </StackPanel>
        <TextBlock Text="{StaticResource Text.Signature.NoMusic}" Margin="80,-22,0,0" Visibility="{x:Bind ViewModel.IsMusicMissing, Mode=OneWay}"
                   FontFamily="{StaticResource FontBarlow}" FontSize="12" Foreground="{StaticResource Light40Brush}"/>
    </StackPanel>
</UserControl>
