<?xml version="1.0" encoding="utf-8"?>
<!-- Paso 6 del manual: réplica de MÚSICA con canciones ficticias y sin portadas (el recuadro con nota de cuando no hay).
     No toca el reproductor real. Resaltados: biblioteca, controles + volumen, ← INICIO -->
<componentes:VistaEjemplo x:Class="COT_0.HostWinUI.Views.Componentes.VistaEjemploMusica"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:componentes="using:COT_0.HostWinUI.Views.Componentes"
                          xmlns:modelos="using:COT_0.HostWinUI.Models">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="64,52,64,48" ColumnSpacing="48" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2" HorizontalAlignment="Left">
                <componentes:EncabezadoEjemplo Title="{StaticResource Text.Music.ScreenTitle}"/>
                <componentes:ResaltadoManual Margin="-12,-10" Phase="{x:Bind Phase, Mode=OneWay}" From="5"/>
            </Grid>

            <!-- Canción actual -->
            <StackPanel Grid.Row="1">
                <Border Width="300" Height="300" CornerRadius="4" Background="{StaticResource AvatarTone1Brush}" HorizontalAlignment="Left"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <FontIcon Glyph="&#xE8D6;" FontFamily="{StaticResource FontIcons}" FontSize="48" Foreground="{StaticResource Light28Brush}"/>
                </Border>
                <TextBlock Text="{x:Bind Demo.PlayingTitle}" Margin="0,18,0,0" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource FontCondensedBold}" FontWeight="Bold" FontSize="24" Foreground="{StaticResource TextBrush}"/>
                <Grid Margin="-10,12,0,0" HorizontalAlignment="Left">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource TextButton}" IsTabStop="False">
                                <FontIcon Glyph="&#xE892;" FontFamily="{StaticResource FontIcons}" FontSize="18"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Padding="14,0" IsTabStop="False">
                                <FontIcon Glyph="&#xE769;" FontFamily="{StaticResource FontIcons}"
                                          FontSize="26" Foreground="{StaticResource LightBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" IsTabStop="False">
                                <FontIcon Glyph="&#xE893;" FontFamily="{StaticResource FontIcons}" FontSize="18"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <FontIcon Glyph="&#xE8D6;" FontFamily="{StaticResource FontIcons}" FontSize="18"
                                      Margin="10,0" Foreground="{StaticResource Text62Brush}"/>
                            <Slider Style="{StaticResource VolumeSlider}" Margin="6,0,0,0" Value="{x:Bind Demo.Volume}" IsTabStop="False"/>
                            <TextBlock Text="{x:Bind Demo.VolumeText}" Margin="10,0,0,0" MinWidth="24" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontRedaction}" FontSize="13" Foreground="{StaticResource Light60Brush}"/>
                        </StackPanel>
                    </StackPanel>
                    <componentes:ResaltadoManual Margin="0,-6,-12,-6" Phase="{x:Bind Phase, Mode=OneWay}" From="3" To="4"/>
                </Grid>
            </StackPanel>

            <!-- Biblioteca -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ItemsControl ItemsSource="{x:Bind Demo.Songs}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="modelos:ManualDemoRow">
                                <Grid Height="56" Padding="0,0,20,0" ColumnSpacing="14" BorderBrush="{StaticResource RowBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{StaticResource AccentBrush}" Visibility="{x:Bind IsMarked}"/>
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="4" Background="{StaticResource AvatarTone2Brush}">
                                        <FontIcon Glyph="&#xE8D6;" FontFamily="{StaticResource FontIcons}" FontSize="16" Foreground="{StaticResource Light28Brush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Title}" Style="{StaticResource RowNameText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Detail}" Style="{StaticResource InterText}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <componentes:ResaltadoManual Margin="-8" Phase="{x:Bind Phase, Mode=OneWay}" From="1" To="2"/>
            </Grid>
        </Grid>
    </Grid>
</componentes:VistaEjemplo>
