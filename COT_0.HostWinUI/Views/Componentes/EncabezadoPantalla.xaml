<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado de las pantallas internas (Sala, Emotes, Música, Fondos, Manual): ← INICIO (o ← SALA) | TÍTULO, como el de la sala del WPF -->
<UserControl x:Class="COT_0.HostWinUI.Views.Componentes.EncabezadoPantalla"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="BackButton" Style="{StaticResource TextButton}" Padding="0,0,8,0" Click="OnBackClick"
                AutomationProperties.Name="{StaticResource Text.Header.Back}">
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape"/>
            </Button.KeyboardAccelerators>
            <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource FontIcons}" FontSize="14"/>
                <TextBlock x:Name="BackLabel" Text="{StaticResource Text.Header.Back}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontCondensedMedium}" FontWeight="Normal" FontSize="14" CharacterSpacing="300"/>
            </StackPanel>
        </Button>
        <Rectangle Width="1" Height="22" Margin="28,0" Fill="{StaticResource Light28Brush}"/>
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource FontCondensedBold}"
                   FontWeight="Bold" FontSize="28" CharacterSpacing="160" Foreground="{StaticResource TextBrush}"/>
    </StackPanel>
</UserControl>
